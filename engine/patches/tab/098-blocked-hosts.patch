+ActionTracker::BlockedSites ActionTracker::GetBlockedSites(
+    const ExtensionId& extension_id,
+    int tab_id) const {
+  if (tab_id == extension_misc::kUnknownTabId ||
+      !KeepsBlockedSites(extension_id)) {
+    return BlockedSites();
+  }
+  auto tracked_info = rules_tracked_.find(ExtensionTabIdKey(extension_id, tab_id));
+  return tracked_info == rules_tracked_.end() ? BlockedSites()
+                                              : tracked_info->second.blocked;
+}
