+// ReArc tab/098: true for "ReArc Blocker", the built-in content blocker, the
+// one extension whose blocked requests' sites are kept (BlockedSites in the
+// header). The two IDs are rearc::kContentBlockerExtensionIds
+// (chrome/browser/rearc_bridge/rearc_content_blocker.h), which this layer
+// cannot include; engine/tests/check_blocked_hosts_patch.py holds the two
+// lists to each other. Compiled in on purpose (security BL-05): nothing at
+// run time can make the tracker keep sites for another extension.
+bool KeepsBlockedSites(const ExtensionId& extension_id) {
+  return extension_id == "eoaoomnoofleafmoihlpjdhdceloddjm" ||
+         extension_id == "kanaeoiolklalbbkdlpbfohpmgkgackf";
+}
+
+// The site of a blocked request, as the list keeps it: the registrable domain
+// of the host with private registries included ("someone.github.io" stays
+// itself), an IP address as it is, and a host without a registrable domain (a
+// single label, a public suffix) as it is and marked as not one site.
+// nullopt for a URL without a host and for a name too long to be one.
+struct BlockedSiteName {
+  std::string name;
+  bool is_one_site = false;
+};
+std::optional<BlockedSiteName> BlockedSiteNameOf(const GURL& url) {
+  if (!url.is_valid() || !url.has_host()) {
+    return std::nullopt;
+  }
+  std::string_view host = url.host();
+  while (host.ends_with('.')) {
+    host.remove_suffix(1);
+  }
+  if (host.empty()) {
+    return std::nullopt;
+  }
+  BlockedSiteName site;
+  if (url.HostIsIPAddress()) {
+    site.name = std::string(host);
+    site.is_one_site = true;
+  } else {
+    site.name = net::registry_controlled_domains::GetDomainAndRegistry(
+        host, net::registry_controlled_domains::INCLUDE_PRIVATE_REGISTRIES);
+    site.is_one_site = !site.name.empty();
+    if (!site.is_one_site) {
+      site.name = std::string(host);
+    }
+  }
+  if (site.name.size() > ActionTracker::kMaxBlockedSiteBytes) {
+    return std::nullopt;
+  }
+  return site;
+}
+
+void IncrementUpToMax(uint32_t& count) {
+  if (count < std::numeric_limits<uint32_t>::max()) {
+    ++count;
+  }
+}
+
+// Adds one blocked request to `blocked`: its site, or only `more` when the
+// list is full or the request has no site to keep.
+void RecordBlockedSite(ActionTracker::BlockedSites& blocked,
+                       const GURL& url,
+                       RulesetID ruleset_id) {
+  std::optional<BlockedSiteName> name = BlockedSiteNameOf(url);
+  if (!name) {
+    IncrementUpToMax(blocked.more);
+    return;
+  }
+  auto entry = std::ranges::find(blocked.sites, name->name,
+                                 &ActionTracker::BlockedSite::site);
+  if (entry == blocked.sites.end()) {
+    if (blocked.sites.size() >= ActionTracker::kMaxBlockedSites) {
+      IncrementUpToMax(blocked.more);
+      return;
+    }
+    blocked.sites.emplace_back();
+    entry = std::prev(blocked.sites.end());
+    entry->site = std::move(name->name);
+    entry->is_one_site = name->is_one_site;
+  }
+  IncrementUpToMax(entry->count);
+  if (entry->rulesets.size() < ActionTracker::kMaxBlockedSiteRulesets &&
+      std::ranges::find(entry->rulesets, ruleset_id) == entry->rulesets.end()) {
+    entry->rulesets.push_back(ruleset_id);
+  }
+}
