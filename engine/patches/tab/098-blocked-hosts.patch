+// The bundle's list ID for one of a blocker's rulesets: the ID in the
+// manifest the engine built (BlockerManifest), "_dynamic" for the dynamic
+// rules, which for a blocked request are the person's own rules (the site
+// exceptions only allow). nullopt for an ID the loaded blocker does not have.
+std::optional<std::string> BlockedListId(const extensions::Extension& blocker,
+                                         dnr::RulesetID ruleset_id) {
+  if (ruleset_id == dnr::kDynamicRulesetID) {
+    return std::string(dnr_api::DYNAMIC_RULESET_ID);
+  }
+  for (const dnr::DNRManifestData::RulesetInfo& ruleset :
+       dnr::DNRManifestData::GetRulesets(blocker)) {
+    if (ruleset.id == ruleset_id) {
+      return ruleset.manifest_id;
+    }
+  }
+  return std::nullopt;
+}
+
+// ReArcTabCopyBlockedHosts (content_blocking_hosts, ABI 1.69, tab/098): the
+// sites of the requests blocked in the tab's current page, as JSON. They are
+// ActionTracker's, kept beside the count the tab's blocked count comes from
+// (ActionTracker::BlockedSites), in memory only; this reads them and keeps
+// nothing. While a list update has two blockers a site's entries are added
+// up, as the counts are. The sites are never logged.
+// "page" is the tab's own site, from the same function and so the same
+// public suffix list as the blocked sites: the site of the primary main
+// frame's committed address, http and https only. The host writes "allow this
+// host on this site" from the two names of one reply, and reads the reply
+// again before it writes: an address that is only pending is not in it
+// (security BL-10, BL-11).
+std::string BlockedHostsJson(uint64_t tab_id) {
+  struct Site {
+    std::string name;
+    bool is_one_site = false;
+    uint64_t count = 0;
+    std::set<std::string> lists;
+  };
+  std::vector<Site> sites;
+  uint64_t more = 0;
+  TabSession* session = TabRegistry::Get().FindSession(tab_id);
+  content::WebContents* contents = session ? session->web_contents() : nullptr;
+  content::BrowserContext* context =
+      contents ? contents->GetBrowserContext() : nullptr;
+  // A private window's tab is tracked by its profile's service, as its count.
+  dnr::RulesMonitorService* service =
+      context ? dnr::RulesMonitorService::Get(context) : nullptr;
+  for (int slot = 0; service && slot < kSlots; ++slot) {
+    const extensions::Extension* blocker =
+        extensions::ExtensionRegistry::Get(context)->enabled_extensions().GetByID(
+            BlockerId(slot));
+    if (!blocker) {
+      continue;
+    }
+    // The tab ID ExtensionActionRunner resets and clears the tracker with.
+    dnr::ActionTracker::BlockedSites blocked =
+        service->action_tracker().GetBlockedSites(
+            blocker->id(), extensions::ExtensionTabUtil::GetTabId(contents));
+    more += blocked.more;
+    for (dnr::ActionTracker::BlockedSite& from : blocked.sites) {
+      auto site = std::ranges::find(sites, from.site, &Site::name);
+      if (site == sites.end()) {
+        if (sites.size() >= dnr::ActionTracker::kMaxBlockedSites) {
+          more += from.count;
+          continue;
+        }
+        sites.emplace_back();
+        site = std::prev(sites.end());
+        site->name = std::move(from.site);
+        site->is_one_site = from.is_one_site;
+      }
+      site->count += from.count;
+      site->is_one_site = site->is_one_site && from.is_one_site;
+      for (dnr::RulesetID ruleset_id : from.rulesets) {
+        if (std::optional<std::string> list =
+                BlockedListId(*blocker, ruleset_id)) {
+          site->lists.insert(std::move(*list));
+        }
+      }
+    }
+  }
+  base::ListValue hosts;
+  for (Site& site : sites) {
+    base::ListValue lists;
+    for (const std::string& list : site.lists) {
+      lists.Append(list);
+    }
+    hosts.Append(base::DictValue()
+                     .Set("host", std::move(site.name))
+                     .Set("count", base::saturated_cast<int>(site.count))
+                     .Set("registrable", site.is_one_site)
+                     .Set("lists", std::move(lists)));
+  }
+  base::DictValue reply;
+  if (contents) {
+    const GURL& page = contents->GetLastCommittedURL();
+    std::string page_site;
+    bool page_is_one_site = false;
+    if (page.SchemeIsHTTPOrHTTPS() &&
+        dnr::ActionTracker::GetSiteOfUrl(page, &page_site, &page_is_one_site)) {
+      reply.Set("page", base::DictValue()
+                            .Set("host", std::move(page_site))
+                            .Set("registrable", page_is_one_site));
+    }
+  }
+  reply.Set("hosts", std::move(hosts));
+  reply.Set("more", base::saturated_cast<int>(more));
+  return base::WriteJson(reply).value_or(R"({"hosts":[],"more":0})");
+}
+
+// ReArcEngineCopySiteOfHost (host_sites, ABI 1.69, tab/098): the site of a
+// host as the blocked list names one, for a host application that has no
+// public suffix list (security CB-12, AG-05, BO-01: its guess took "web.app"
+// for the site of every page under it). It lives here because the naming is
+// the tracker's (ActionTracker::GetSiteOfUrl): one function, one answer.
+// "suffix" says more about a name that is not one site: it is itself a public
+// suffix ("com", "co.uk", "web.app"), so every site under it is someone
+// else's, and not a name without any ("localhost", an intranet's "wiki").
+// nullopt for text that is not a plain host name or IPv4 address.
+std::optional<std::string> SiteOfHostJson(std::string_view host) {
+  constexpr size_t kMaxHostBytes = 253;
+  if (host.empty() || host.size() > kMaxHostBytes ||
+      !std::ranges::all_of(host, [](char c) {
+        return base::IsAsciiAlphaNumeric(c) || c == '.' || c == '-' || c == '_';
+      })) {
+    return std::nullopt;
+  }
+  const GURL url(base::StrCat(
+      {url::kHttpScheme, url::kStandardSchemeSeparator, host, "/"}));
+  std::string site;
+  bool is_one_site = false;
+  // The characters above leave no room for a port, a path or credentials; the
+  // comparison holds that the address is nothing but the host that was asked.
+  if (!url.is_valid() || url.has_port() || url.has_username() ||
+      url.has_password() || url.path() != "/" || url.has_query() ||
+      url.has_ref()) {
+    return std::nullopt;
+  }
+  // The name the engine read must be the name that was asked, but for letter
+  // case and a trailing dot. Some plain-looking names are addresses to it
+  // ("1.2" is 1.0.0.2, "0x7f.1" is 127.0.0.1): an answer about another name
+  // than the caller's would be a key for something the caller never showed
+  // (security BL-12).
+  const auto without_trailing_dots = [](std::string_view name) {
+    while (name.ends_with('.')) {
+      name.remove_suffix(1);
+    }
+    return name;
+  };
+  if (without_trailing_dots(url.host()) !=
+          without_trailing_dots(base::ToLowerASCII(host)) ||
+      !dnr::ActionTracker::GetSiteOfUrl(url, &site, &is_one_site)) {
+    return std::nullopt;
+  }
+  bool is_suffix = false;
+  if (!is_one_site) {
+    // `site` is the host itself then, and not an IP address. The list's own
+    // test for a suffix checks that its argument is a canonical name and
+    // stops the process when it is not, so that is settled here first.
+    url::CanonHostInfo info;
+    is_suffix =
+        net::CanonicalizeHost(site, &info) == site &&
+        info.family == url::CanonHostInfo::NEUTRAL &&
+        net::registry_controlled_domains::HostIsRegistryIdentifier(
+            site, net::registry_controlled_domains::INCLUDE_PRIVATE_REGISTRIES);
+  }
+  return base::WriteJson(base::DictValue()
+                             .Set("host", std::move(site))
+                             .Set("registrable", is_one_site)
+                             .Set("suffix", is_suffix));
+}
+
+// A reply for the host to free with ReArcBufferFree.
+ReArcStatus CopyReply(const std::string& text, char** out) {
+  char* copy = static_cast<char*>(malloc(text.size() + 1));
+  if (!copy) {
+    return REARC_INTERNAL;
+  }
+  std::memcpy(copy, text.c_str(), text.size() + 1);
+  *out = copy;
+  return REARC_OK;
+}
+
 }  // namespace
 
 bool OnContentBlockerActionCount(content::BrowserContext* context,
@@ -1374,3 +1566,25 @@ void ReArcEngineSetBlockedCountCallback(ReArcBlockedCountCallback callback,
   rearc::g_count_callback = callback;
   rearc::g_count_context = callback ? context : nullptr;
 }
+
+ReArcStatus ReArcTabCopyBlockedHosts(uint64_t tab_id, char** json) {
+  CHECK(pthread_main_np());
+  if (!json) {
+    return REARC_INVALID_ARGUMENT;
+  }
+  *json = nullptr;
+  return rearc::CopyReply(rearc::BlockedHostsJson(tab_id), json);
+}
+
+ReArcStatus ReArcEngineCopySiteOfHost(const char* utf8_host, char** json) {
+  CHECK(pthread_main_np());
+  if (!json) {
+    return REARC_INVALID_ARGUMENT;
+  }
+  *json = nullptr;
+  if (!utf8_host) {
+    return REARC_INVALID_ARGUMENT;
+  }
+  std::optional<std::string> reply = rearc::SiteOfHostJson(utf8_host);
+  return reply ? rearc::CopyReply(*reply, json) : REARC_INVALID_ARGUMENT;
+}
