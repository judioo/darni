+// The bundle's list ID for one of a blocker's rulesets: the ID in the
+// manifest the engine built (BlockerManifest), "_dynamic" for the dynamic
+// rules, which for a blocked request are the person's own rules (the site
+// exceptions only allow). nullopt for an ID the loaded blocker does not have.
+std::optional<std::string> BlockedListId(const extensions::Extension& blocker,
+                                         dnr::RulesetID ruleset_id) {
+  if (ruleset_id == dnr::kDynamicRulesetID) {
+    return std::string(dnr_api::DYNAMIC_RULESET_ID);
+  }
+  for (const dnr::DNRManifestData::RulesetInfo& ruleset :
+       dnr::DNRManifestData::GetRulesets(blocker)) {
+    if (ruleset.id == ruleset_id) {
+      return ruleset.manifest_id;
+    }
+  }
+  return std::nullopt;
+}
+
+// ReArcTabCopyBlockedHosts (content_blocking_hosts, ABI 1.69, tab/098): the
+// sites of the requests blocked in the tab's current page, as JSON. They are
+// ActionTracker's, kept beside the count the tab's blocked count comes from
+// (ActionTracker::BlockedSites), in memory only; this reads them and keeps
+// nothing. While a list update has two blockers a site's entries are added
+// up, as the counts are. The sites are never logged.
+std::string BlockedHostsJson(uint64_t tab_id) {
+  struct Site {
+    std::string name;
+    bool is_one_site = false;
+    uint64_t count = 0;
+    std::set<std::string> lists;
+  };
+  std::vector<Site> sites;
+  uint64_t more = 0;
+  TabSession* session = TabRegistry::Get().FindSession(tab_id);
+  content::WebContents* contents = session ? session->web_contents() : nullptr;
+  content::BrowserContext* context =
+      contents ? contents->GetBrowserContext() : nullptr;
+  // A private window's tab is tracked by its profile's service, as its count.
+  dnr::RulesMonitorService* service =
+      context ? dnr::RulesMonitorService::Get(context) : nullptr;
+  for (int slot = 0; service && slot < kSlots; ++slot) {
+    const extensions::Extension* blocker =
+        extensions::ExtensionRegistry::Get(context)->enabled_extensions().GetByID(
+            BlockerId(slot));
+    if (!blocker) {
+      continue;
+    }
+    // The tab ID ExtensionActionRunner resets and clears the tracker with.
+    dnr::ActionTracker::BlockedSites blocked =
+        service->action_tracker().GetBlockedSites(
+            blocker->id(), extensions::ExtensionTabUtil::GetTabId(contents));
+    more += blocked.more;
+    for (dnr::ActionTracker::BlockedSite& from : blocked.sites) {
+      auto site = std::ranges::find(sites, from.site, &Site::name);
+      if (site == sites.end()) {
+        if (sites.size() >= dnr::ActionTracker::kMaxBlockedSites) {
+          more += from.count;
+          continue;
+        }
+        sites.emplace_back();
+        site = std::prev(sites.end());
+        site->name = std::move(from.site);
+        site->is_one_site = from.is_one_site;
+      }
+      site->count += from.count;
+      site->is_one_site = site->is_one_site && from.is_one_site;
+      for (dnr::RulesetID ruleset_id : from.rulesets) {
+        if (std::optional<std::string> list =
+                BlockedListId(*blocker, ruleset_id)) {
+          site->lists.insert(std::move(*list));
+        }
+      }
+    }
+  }
+  base::ListValue hosts;
+  for (Site& site : sites) {
+    base::ListValue lists;
+    for (const std::string& list : site.lists) {
+      lists.Append(list);
+    }
+    hosts.Append(base::DictValue()
+                     .Set("host", std::move(site.name))
+                     .Set("count", base::saturated_cast<int>(site.count))
+                     .Set("registrable", site.is_one_site)
+                     .Set("lists", std::move(lists)));
+  }
+  return base::WriteJson(base::DictValue()
+                             .Set("hosts", std::move(hosts))
+                             .Set("more", base::saturated_cast<int>(more)))
+      .value_or(R"({"hosts":[],"more":0})");
+}
+
 }  // namespace
 
 bool OnContentBlockerActionCount(content::BrowserContext* context,
@@ -1374,3 +1472,19 @@ void ReArcEngineSetBlockedCountCallback(ReArcBlockedCountCallback callback,
   rearc::g_count_callback = callback;
   rearc::g_count_context = callback ? context : nullptr;
 }
+
+ReArcStatus ReArcTabCopyBlockedHosts(uint64_t tab_id, char** json) {
+  CHECK(pthread_main_np());
+  if (!json) {
+    return REARC_INVALID_ARGUMENT;
+  }
+  *json = nullptr;
+  const std::string text = rearc::BlockedHostsJson(tab_id);
+  char* copy = static_cast<char*>(malloc(text.size() + 1));
+  if (!copy) {
+    return REARC_INTERNAL;
+  }
+  std::memcpy(copy, text.c_str(), text.size() + 1);
+  *json = copy;
+  return REARC_OK;
+}
