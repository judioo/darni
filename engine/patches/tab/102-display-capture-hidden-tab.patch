       return REARC_INVALID_STATE;
     }
+    GiveSizeToUnshownTab(contents, asker->web_contents());
     DesktopMediaID media(
         DesktopMediaID::TYPE_WEB_CONTENTS, DesktopMediaID::kNullId,
         content::WebContentsMediaCaptureId(
