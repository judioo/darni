diff --git a/chrome/browser/rearc_bridge/rearc_local_passkeys.cc b/chrome/browser/rearc_bridge/rearc_local_passkeys.cc
new file mode 100644
index 0000000..8eb027c
--- /dev/null
+++ b/chrome/browser/rearc_bridge/rearc_local_passkeys.cc
@@ -0,0 +1,227 @@
+// Copyright 2026 The ReArc Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// "This Mac" passkeys (local_passkeys, ABI 1.72): the list and the delete of
+// Chromium's own page for them (chrome://settings/passkeys,
+// LocalCredentialManagement), for the host's settings. The keys are in the
+// Secure Enclave, their keychain items in the access group of
+// rearc::WebAuthnKeychainAccessGroup(), and the site and account of each are
+// sealed with the profile's metadata secret (device/fido/mac/
+// credential_store.h), which is why the host cannot list them by itself.
+
+#include <pthread.h>
+
+#include <algorithm>
+#include <memory>
+#include <optional>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include "base/check.h"
+#include "base/functional/bind.h"
+#include "base/json/json_writer.h"
+#include "base/memory/raw_ptr.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/values.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/rearc_bridge/rearc_abi_internal.h"
+#include "chrome/browser/rearc_bridge/rearc_engine_abi.h"
+#include "chrome/browser/rearc_bridge/rearc_profile_registry.h"
+#include "chrome/browser/rearc_bridge/rearc_webauthn.h"
+#include "chrome/browser/webauthn/local_credential_management.h"
+#include "crypto/apple/keychain_util.h"
+#include "device/fido/discoverable_credential_metadata.h"
+
+namespace rearc {
+namespace {
+
+using Passkeys = std::optional<std::vector<device::DiscoverableCredentialMetadata>>;
+
+// A credential ID is 32 bytes at this pin; older formats sealed the metadata
+// into it and were longer. Nothing near this limit is a real one.
+constexpr size_t kMaxCredentialIdBytes = 1024;
+
+// The profile authenticator exists for this process: the main executable is
+// signed with its keychain access group. Without the group nothing here
+// touches the keychain or the profile's metadata secret. A bundle in release
+// verification mode never has it (WebAuthnKeychainAccessGroup names a group
+// no build is signed with there).
+bool Available() {
+  return crypto::apple::ExecutableHasKeychainAccessGroupEntitlement(
+      WebAuthnKeychainAccessGroup());
+}
+
+std::string Describe(bool available, const Passkeys& passkeys) {
+  base::DictValue document;
+  document.Set("available", available);
+  base::ListValue list;
+  if (passkeys) {
+    for (const device::DiscoverableCredentialMetadata& passkey : *passkeys) {
+      base::DictValue row;
+      row.Set("id", base::HexEncodeLower(passkey.cred_id));
+      row.Set("rp_id", passkey.rp_id);
+      row.Set("user_name", passkey.user.name.value_or(std::string()));
+      row.Set("user_display_name",
+              passkey.user.display_name.value_or(std::string()));
+      list.Append(std::move(row));
+    }
+  }
+  document.Set("passkeys", std::move(list));
+  return base::WriteJson(document).value_or("{}");
+}
+
+void Deliver(ReArcLocalPasskeysCallback completion,
+             void* context,
+             ReArcStatus status,
+             uint64_t profile_id,
+             std::string json) {
+  completion(context, status, profile_id, json.c_str());
+}
+
+// One call of the host: it owns Chromium's management object, whose answers
+// arrive as posted tasks, and ends with exactly one delivery. It holds no
+// Profile: the object copied what it needs (the group and the secret).
+class Operation {
+ public:
+  Operation(Profile* profile,
+            uint64_t profile_id,
+            ReArcLocalPasskeysCallback completion,
+            void* context)
+      : management_(LocalCredentialManagement::Create(profile)),
+        profile_id_(profile_id),
+        completion_(completion),
+        context_(context) {}
+
+  static void List(std::unique_ptr<Operation> self) {
+    LocalCredentialManagement* management = self->management_.get();
+    management->Enumerate(
+        base::BindOnce(&Operation::Listed, std::move(self),
+                       ReArcStatus{REARC_OK}));
+  }
+
+  static void Delete(std::unique_ptr<Operation> self,
+                     std::vector<uint8_t> credential_id) {
+    LocalCredentialManagement* management = self->management_.get();
+    management->Enumerate(base::BindOnce(&Operation::FoundForDelete,
+                                         std::move(self),
+                                         std::move(credential_id)));
+  }
+
+ private:
+  // Chromium deletes a keychain item by its credential ID alone, in the whole
+  // access group. Only an ID of this profile's own list goes that far, so a
+  // host can never delete another profile's passkey, or anything by a guess.
+  static void FoundForDelete(std::unique_ptr<Operation> self,
+                             std::vector<uint8_t> credential_id,
+                             Passkeys passkeys) {
+    if (!passkeys) {
+      Finish(std::move(self), REARC_INTERNAL, std::nullopt);
+      return;
+    }
+    const bool listed = std::ranges::any_of(
+        *passkeys, [&](const device::DiscoverableCredentialMetadata& passkey) {
+          return passkey.cred_id == credential_id;
+        });
+    if (!listed) {
+      Finish(std::move(self), REARC_NOT_FOUND, std::move(passkeys));
+      return;
+    }
+    LocalCredentialManagement* management = self->management_.get();
+    management->Delete(credential_id,
+                       base::BindOnce(&Operation::Deleted, std::move(self)));
+  }
+
+  static void Deleted(std::unique_ptr<Operation> self, bool deleted) {
+    LocalCredentialManagement* management = self->management_.get();
+    management->Enumerate(base::BindOnce(&Operation::Listed, std::move(self),
+                                         ReArcStatus{deleted ? REARC_OK
+                                                             : REARC_INTERNAL}));
+  }
+
+  static void Listed(std::unique_ptr<Operation> self,
+                     ReArcStatus status,
+                     Passkeys passkeys) {
+    if (!passkeys && status == REARC_OK) {
+      status = REARC_INTERNAL;  // The keychain query failed.
+    }
+    Finish(std::move(self), status, std::move(passkeys));
+  }
+
+  static void Finish(std::unique_ptr<Operation> self,
+                     ReArcStatus status,
+                     Passkeys passkeys) {
+    ABIPost(base::BindOnce(&Deliver, self->completion_, self->context_, status,
+                           self->profile_id_, Describe(true, passkeys)));
+  }
+
+  std::unique_ptr<LocalCredentialManagement> management_;
+  const uint64_t profile_id_;
+  const ReArcLocalPasskeysCallback completion_;
+  const raw_ptr<void> context_;
+};
+
+// Passkeys are the original profile's: a private window signs in with them
+// and makes none of its own to manage.
+ReArcStatus FindProfile(uint64_t profile_id, Profile** profile) {
+  *profile = FindBridgeProfile(profile_id);
+  if (!*profile) {
+    return REARC_PROFILE_NOT_FOUND;
+  }
+  if ((*profile)->IsOffTheRecord()) {
+    return REARC_UNSUPPORTED;
+  }
+  return REARC_OK;
+}
+
+}  // namespace
+}  // namespace rearc
+
+ReArcStatus ReArcProfileGetLocalPasskeys(uint64_t profile_id,
+                                         ReArcLocalPasskeysCallback completion,
+                                         void* context) {
+  CHECK(pthread_main_np());
+  if (!completion) {
+    return REARC_INVALID_ARGUMENT;
+  }
+  Profile* profile = nullptr;
+  if (auto status = rearc::FindProfile(profile_id, &profile)) {
+    return status;
+  }
+  if (!rearc::Available()) {
+    rearc::ABIPost(base::BindOnce(&rearc::Deliver, completion, context,
+                                  REARC_OK, profile_id,
+                                  rearc::Describe(false, std::nullopt)));
+    return REARC_OK;
+  }
+  rearc::Operation::List(std::make_unique<rearc::Operation>(
+      profile, profile_id, completion, context));
+  return REARC_OK;
+}
+
+ReArcStatus ReArcProfileDeleteLocalPasskey(
+    uint64_t profile_id,
+    const char* credential_id,
+    ReArcLocalPasskeysCallback completion,
+    void* context) {
+  CHECK(pthread_main_np());
+  std::vector<uint8_t> id;
+  if (!completion || !credential_id ||
+      !base::HexStringToBytes(credential_id, &id) || id.empty() ||
+      id.size() > rearc::kMaxCredentialIdBytes) {
+    return REARC_INVALID_ARGUMENT;
+  }
+  Profile* profile = nullptr;
+  if (auto status = rearc::FindProfile(profile_id, &profile)) {
+    return status;
+  }
+  if (!rearc::Available()) {
+    return REARC_UNSUPPORTED;
+  }
+  rearc::Operation::Delete(
+      std::make_unique<rearc::Operation>(profile, profile_id, completion,
+                                         context),
+      std::move(id));
+  return REARC_OK;
+}
