+namespace rearc {
+namespace {
+
+using blink::mojom::MediaStreamRequestResult;
+using blink::mojom::MediaStreamType;
+using content::DesktopMediaID;
+
+class HostPicker;
+
+ReArcDisplayCaptureCallback host = nullptr;
+void* host_context = nullptr;
+uint64_t epoch = 0, next_id = 1;
+
+std::map<uint64_t, raw_ptr<HostPicker>>& Pickers() {
+  static base::NoDestructor<std::map<uint64_t, raw_ptr<HostPicker>>> pickers;
+  return *pickers;
+}
+
+void Deliver(uint64_t expected,
+             uint64_t request_id,
+             uint64_t tab_id,
+             uint32_t phase,
+             std::string json) {
+  if (!host || expected != epoch) {
+    return;
+  }
+  // Nothing after tab.closed: the host's sheet went with the tab.
+  if (!TabRegistry::Get().FindSession(tab_id)) {
+    return;
+  }
+  host(host_context, request_id, tab_id, phase, json.c_str());
+}
+
+std::string Json(base::DictValue dict) {
+  return base::WriteJson(dict).value_or("{}");
+}
+
+// A window or a screen is chosen in the picker of macOS
+// (SCContentSharingPicker): the person points at it in a window of the
+// system's, and macOS takes that as the permission to record it, once. The
+// engine never lists the windows and never reads a pixel of one to draw a
+// choice. NativeScreenCapturePickerMac exists only with the feature, on
+// macOS 14 and later, and the content layer CHECKs that it does before it
+// opens it.
+bool HasSystemPicker() {
+  return base::FeatureList::IsEnabled(media::kUseSCContentSharingPicker) &&
+         base::mac::MacOSMajorVersion() >= 14;
+}
+
+// Chromium asks for the Screen Recording permission of macOS only where the
+// system picker does not confer it (before macOS 15). Reading it shows no
+// prompt (CGPreflightScreenCaptureAccess).
+const char* ScreenRecordingPermission() {
+  if (!system_media_permissions::ScreenCaptureNeedsSystemLevelPermissions()) {
+    return "not_needed";
+  }
+  return system_media_permissions::CheckSystemScreenCapturePermission() ==
+                 system_permission_settings::SystemPermission::kAllowed
+             ? "granted"
+             : "missing";
+}
+
+// What Chromium's picker offers for the sound of a window
+// (GetWindowCaptureAudioType, desktop_media_picker_views.cc): what the page
+// asked for, where macOS can record it.
+DesktopMediaID::AudioType WindowAudioType(
+    const DesktopMediaPicker::Params& params) {
+  using Preference = blink::mojom::WindowAudioPreference;
+  if (!params.request_audio ||
+      params.window_audio_preference == Preference::kExclude) {
+    return DesktopMediaID::AudioType::kNone;
+  }
+  const bool system = media::IsMacCatapSystemLoopbackCaptureSupported();
+  if (params.window_audio_preference == Preference::kWindow) {
+    if (media::IsApplicationLoopbackCaptureSupported()) {
+      return DesktopMediaID::AudioType::kApplication;
+    }
+    if (system) {
+      return DesktopMediaID::AudioType::kSystem;
+    }
+  }
+  if (params.window_audio_preference == Preference::kSystem && system) {
+    return DesktopMediaID::AudioType::kSystem;
+  }
+  return DesktopMediaID::AudioType::kNone;
+}
+
+// What a tab's page may be shared as a tab: contents the host shows as a
+// page (a sidebar tab, a small window, a peek: Chromium's "tab contents" view
+// type, which browserless_tab_helpers.cc gives every registry tab that is
+// nothing else) on a web or file address. Never a DevTools frontend or its
+// toolbox, which shows the inspected page's storage, cookies and network
+// data; never an extension's popup or side panel; never a browser page
+// (chrome:, devtools:, chrome-extension:, about:blank). The host's sheet
+// lists only its tabs, and the engine does not depend on that.
+bool IsShareablePage(content::WebContents* contents) {
+  if (IsHostedDevTools(contents) ||
+      extensions::GetViewType(contents) !=
+          extensions::mojom::ViewType::kTabContents) {
+    return false;
+  }
+  content::RenderFrameHost* main = contents->GetPrimaryMainFrame();
+  if (!main) {
+    return false;
+  }
+  const GURL& url = main->GetLastCommittedURL();
+  return url.SchemeIsHTTPOrHTTPS() || url.SchemeIsFile();
+}
+
+void StopObserving(DesktopMediaID source) {
+  content::GetIOThreadTaskRunner({})->PostTask(
+      FROM_HERE,
+      base::BindOnce(&content::desktop_capture::CloseNativeScreenCapturePicker,
+                     source));
+}
+
+// One getDisplayMedia request's choice, asked of the host. Chromium's handler
+// owns it for as long as the request waits, and destroys it when the request
+// is answered, when its page goes and when its tab closes.
+class HostPicker : public DesktopMediaPicker {
+ public:
+  explicit HostPicker(const content::MediaStreamRequest* request)
+      : id_(next_id++) {
+    if (request) {
+      process_id_ = request->render_process_id;
+      frame_id_ = request->render_frame_id;
+      this_tab_ =
+          request->video_type == MediaStreamType::DISPLAY_VIDEO_CAPTURE_THIS_TAB;
+      exclude_self_ = request->exclude_self_browser_surface;
+      exclude_screen_ = request->exclude_monitor_type_surfaces;
+    }
+    Pickers()[id_] = this;
+  }
+
+  ~HostPicker() override {
+    Pickers().erase(id_);
+    if (asked_ && !done_.is_null() && !detached_) {
+      ABIPost(base::BindOnce(&Deliver, epoch, id_, tab_id_, 1u,
+                             Json(base::DictValue().Set("outcome",
+                                                        "withdrawn"))));
+    }
+    // An open system picker must not go on watching for this request.
+    if (system_source_ && !chosen_) {
+      StopObserving(DesktopMediaID(system_type_, *system_source_));
+    }
+  }
+
+  // DesktopMediaPicker. The handler's source lists are empty (see the
+  // factory): the host knows its tabs, and macOS shows the windows and
+  // screens.
+  void Show(const Params& params,
+            std::vector<std::unique_ptr<DesktopMediaList>> source_lists,
+            DoneCallback done_callback) override {
+    CHECK(pthread_main_np());
+    done_ = std::move(done_callback);
+    params_ = params;
+    content::RenderFrameHost* frame =
+        content::RenderFrameHost::FromID(process_id_, frame_id_);
+    TabSession* session = ExtensionSession(params.web_contents);
+    // Only a web page in a tab of the host gets the host's sheet, which names
+    // who asks. Without a host nobody can answer.
+    if (!host || !session || !frame ||
+        !frame->GetLastCommittedOrigin().GetURL().SchemeIsHTTPOrHTTPS()) {
+      return FinishLater(base::unexpected(MediaStreamRequestResult::NOT_SUPPORTED));
+    }
+    tab_id_ = session->tab_id();
+    profile_id_ = session->profile_id();
+    const bool system_picker = HasSystemPicker();
+    screen_ = system_picker && !exclude_screen_;
+    window_ = system_picker;
+    window_audio_ = WindowAudioType(params);
+    screen_audio_ = params.request_audio && !params.exclude_system_audio &&
+                    media::IsMacCatapSystemLoopbackCaptureSupported();
+    const char* prefer = "";
+    if (this_tab_) {
+      prefer = "current_tab";
+    } else {
+      switch (params.preferred_display_surface) {
+        case blink::mojom::PreferredDisplaySurface::BROWSER:
+          prefer = "tab";
+          break;
+        case blink::mojom::PreferredDisplaySurface::WINDOW:
+          prefer = "window";
+          break;
+        case blink::mojom::PreferredDisplaySurface::MONITOR:
+          prefer = "screen";
+          break;
+        case blink::mojom::PreferredDisplaySurface::NO_PREFERENCE:
+          break;
+      }
+    }
+    base::DictValue json;
+    json.Set("origin", frame->GetLastCommittedOrigin().Serialize());
+    json.Set("top_origin", params.web_contents->GetPrimaryMainFrame()
+                               ->GetLastCommittedOrigin()
+                               .Serialize());
+    json.Set("profile_id", base::NumberToString(profile_id_));
+    json.Set("content_generation",
+             base::NumberToString(session->content_generation()));
+    json.Set("audio", params.request_audio);
+    json.Set("current_tab", !exclude_self_);
+    json.Set("window", window_);
+    json.Set("screen", screen_);
+    json.Set("tab_audio", params.request_audio);
+    json.Set("window_audio",
+             window_ && window_audio_ != DesktopMediaID::AudioType::kNone);
+    json.Set("screen_audio", screen_ && screen_audio_);
+    json.Set("prefer", prefer);
+    json.Set("system_picker", system_picker);
+    json.Set("screen_recording_permission", ScreenRecordingPermission());
+    asked_ = true;
+    ABIPost(base::BindOnce(&Deliver, epoch, id_, tab_id_, 0u,
+                           Json(std::move(json))));
+  }
+
+  uint64_t tab_id() const { return tab_id_; }
+  bool waiting() const { return asked_ && !done_.is_null(); }
+
+  // The tab is closing: the host hears no more of this request. Chromium's
+  // handler drops it with the tab's WebContents.
+  void Detach() { detached_ = true; }
+
+  // The host that was asked is gone.
+  void Abandon() {
+    detached_ = true;
+    Finish(base::unexpected(MediaStreamRequestResult::NOT_SUPPORTED), nullptr);
+  }
+
+  ReArcStatus Respond(uint32_t choice, uint64_t target_tab, bool share_audio) {
+    if (!waiting() || system_open_) {
+      return REARC_INVALID_STATE;
+    }
+    switch (choice) {
+      case 0:
+        Finish(base::unexpected(
+                   MediaStreamRequestResult::PERMISSION_DENIED_BY_USER),
+               "cancelled");
+        return REARC_OK;
+      case 1:
+        return ShareTab(target_tab, share_audio);
+      case 2:
+      case 3: {
+        const bool screen = choice == 3;
+        if (!(screen ? screen_ : window_)) {
+          return REARC_INVALID_STATE;
+        }
+        // Chromium's handler refuses the choice afterwards without the
+        // permission, where it is needed: the host says so first instead.
+        if (std::string(ScreenRecordingPermission()) == "missing") {
+          return REARC_INVALID_STATE;
+        }
+        OpenSystemPicker(screen ? DesktopMediaID::TYPE_SCREEN
+                                : DesktopMediaID::TYPE_WINDOW,
+                         share_audio);
+        return REARC_OK;
+      }
+      default:
+        return REARC_INVALID_ARGUMENT;
+    }
+  }
+
+ private:
+  using Result = DesktopMediaPicker::DoneCallbackArgumentType;
+
+  ReArcStatus ShareTab(uint64_t target_tab, bool share_audio) {
+    TabSession* asker = TabRegistry::Get().FindSession(tab_id_);
+    TabSession* target = TabRegistry::Get().FindSession(target_tab);
+    content::WebContents* contents = target ? target->web_contents() : nullptr;
+    if (!asker || !asker->web_contents() || !contents ||
+        contents->IsBeingDestroyed()) {
+      return REARC_NOT_FOUND;
+    }
+    // A tab of the same profile and the same kind of session only (Chromium's
+    // picker lists no other), and not the asking tab when its page excluded
+    // itself.
+    if (contents->GetBrowserContext() !=
+            asker->web_contents()->GetBrowserContext() ||
+        target->profile_id() != profile_id_ ||
+        (exclude_self_ && target_tab == tab_id_)) {
+      return REARC_INVALID_ARGUMENT;
+    }
+    // And a page only, whatever the host listed (security review SS-02).
+    if (!IsShareablePage(contents)) {
+      return REARC_INVALID_ARGUMENT;
+    }
+    content::RenderFrameHost* main = contents->GetPrimaryMainFrame();
+    if (!main || !main->IsRenderFrameLive() || contents->IsCrashed()) {
+      return REARC_INVALID_STATE;
+    }
+    DesktopMediaID media(
+        DesktopMediaID::TYPE_WEB_CONTENTS, DesktopMediaID::kNullId,
+        content::WebContentsMediaCaptureId(
+            main->GetProcess()->GetDeprecatedID(), main->GetRoutingID()));
+    media.audio_share = share_audio && params_.request_audio;
+    base::DictValue json;
+    json.Set("outcome", "shared");
+    json.Set("kind", "tab");
+    json.Set("target_tab", base::NumberToString(target_tab));
+    json.Set("audio", media.audio_share);
+    Finish(media, std::move(json));
+    return REARC_OK;
+  }
+
+  void OpenSystemPicker(DesktopMediaID::Type type, bool share_audio) {
+    system_open_ = true;
+    system_type_ = type;
+    system_audio_ = share_audio;
+    auto runner = base::SequencedTaskRunner::GetCurrentDefault();
+    auto weak = weak_factory_.GetWeakPtr();
+    // The id of the picker's session arrives first. A request that went in
+    // the meantime must still let go of it.
+    auto created = base::BindPostTask(
+        runner, base::BindOnce(
+                    [](base::WeakPtr<HostPicker> picker,
+                       DesktopMediaID::Type type, DesktopMediaID::Id source) {
+                      if (picker) {
+                        picker->system_source_ = source;
+                      } else {
+                        StopObserving(DesktopMediaID(type, source));
+                      }
+                    },
+                    weak, type));
+    auto selected = base::BindPostTask(
+        runner, base::BindOnce(&HostPicker::OnSystemChoice, weak));
+    auto cancelled = base::BindPostTask(
+        runner,
+        base::BindOnce(&HostPicker::OnSystemEnd, weak,
+                       MediaStreamRequestResult::PERMISSION_DENIED_BY_USER,
+                       "cancelled"));
+    auto failed = base::BindPostTask(
+        runner, base::BindOnce(&HostPicker::OnSystemEnd, weak,
+                               MediaStreamRequestResult::NOT_SUPPORTED,
+                               "failed"));
+    content::GetIOThreadTaskRunner({})->PostTask(
+        FROM_HERE,
+        base::BindOnce(&content::desktop_capture::OpenNativeScreenCapturePicker,
+                       type, std::move(created), std::move(selected),
+                       std::move(cancelled), std::move(failed)));
+  }
+
+  void OnSystemChoice(webrtc::DesktopCapturer::Source source) {
+    chosen_ = true;
+    const bool screen = system_type_ == DesktopMediaID::TYPE_SCREEN;
+    DesktopMediaID media(system_type_, source.id);
+    if (screen) {
+      media.audio_share = system_audio_ && screen_audio_;
+    } else {
+      media.audio_share =
+          system_audio_ && window_audio_ != DesktopMediaID::AudioType::kNone;
+      media.window_audio_type = window_audio_;
+    }
+    base::DictValue json;
+    json.Set("outcome", "shared");
+    json.Set("kind", screen ? "screen" : "window");
+    json.Set("audio", media.audio_share);
+    Finish(media, std::move(json));
+  }
+
+  void OnSystemEnd(MediaStreamRequestResult result, const char* outcome) {
+    Finish(base::unexpected(result), outcome);
+  }
+
+  void FinishLater(Result result) {
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE,
+        base::BindOnce(
+            [](base::WeakPtr<HostPicker> picker, Result result) {
+              if (picker) {
+                picker->Finish(std::move(result), nullptr);
+              }
+            },
+            weak_factory_.GetWeakPtr(), std::move(result)));
+  }
+
+  void Finish(Result result, const char* outcome) {
+    Finish(std::move(result),
+           outcome ? base::DictValue().Set("outcome", outcome)
+                   : base::DictValue());
+  }
+
+  // The answer for Chromium's handler, which destroys this picker with it:
+  // nothing may follow the callback.
+  void Finish(Result result, base::DictValue outcome) {
+    if (done_.is_null()) {
+      return;
+    }
+    if (asked_ && !detached_ && !outcome.empty()) {
+      ABIPost(base::BindOnce(&Deliver, epoch, id_, tab_id_, 1u,
+                             Json(std::move(outcome))));
+    }
+    std::move(done_).Run(std::move(result));
+  }
+
+  const uint64_t id_;
+  int process_id_ = 0, frame_id_ = 0;
+  bool this_tab_ = false, exclude_self_ = false, exclude_screen_ = false;
+  uint64_t tab_id_ = 0, profile_id_ = 0;
+  Params params_;
+  DoneCallback done_;
+  bool asked_ = false, detached_ = false;
+  bool window_ = false, screen_ = false, screen_audio_ = false;
+  DesktopMediaID::AudioType window_audio_ = DesktopMediaID::AudioType::kNone;
+  bool system_open_ = false, system_audio_ = false, chosen_ = false;
+  DesktopMediaID::Type system_type_ = DesktopMediaID::TYPE_NONE;
+  std::optional<DesktopMediaID::Id> system_source_;
+  base::WeakPtrFactory<HostPicker> weak_factory_{this};
+};
+
+class HostPickerFactory : public DesktopMediaPickerFactory {
+ public:
+  HostPickerFactory() = default;
+  std::unique_ptr<DesktopMediaPicker> CreatePicker(
+      const content::MediaStreamRequest* request) override {
+    return std::make_unique<HostPicker>(request);
+  }
+  // No list: Chromium's tab list walks Browser windows, which a bridge
+  // process has none of, and its window and screen lists either draw
+  // thumbnails (which needs the Screen Recording permission) or stand for the
+  // system picker, which HostPicker opens itself.
+  std::vector<std::unique_ptr<DesktopMediaList>> CreateMediaList(
+      const std::vector<DesktopMediaList::Type>& types,
+      content::WebContents* web_contents,
+      DesktopMediaList::WebContentsFilter includable_web_contents_filter)
+      override {
+    return {};
+  }
+};
+
+}  // namespace
+
+std::unique_ptr<MediaAccessHandler> MakeDisplayMediaAccessHandler() {
+  if (!IsEngineEmbeddedMode()) {
+    return std::make_unique<DisplayMediaAccessHandler>();
+  }
+  return std::make_unique<DisplayMediaAccessHandler>(
+      std::make_unique<HostPickerFactory>(), /*display_notification=*/false);
+}
+
+bool IsHostDisplayCaptureRequest(const content::MediaStreamRequest& request) {
+  return (request.video_type == MediaStreamType::DISPLAY_VIDEO_CAPTURE ||
+          request.video_type ==
+              MediaStreamType::DISPLAY_VIDEO_CAPTURE_THIS_TAB) &&
+         (request.audio_type == MediaStreamType::NO_SERVICE ||
+          request.audio_type == MediaStreamType::DISPLAY_AUDIO_CAPTURE);
+}
+
+void ABICancelDisplayCapture(uint64_t tab_id) {
+  CHECK(pthread_main_np());
+  for (auto& [id, picker] : Pickers()) {
+    if (picker->tab_id() == tab_id) {
+      picker->Detach();
+    }
+  }
+}
+
+}  // namespace rearc
+
+void ReArcEngineSetDisplayCaptureCallback(ReArcDisplayCaptureCallback callback,
+                                          void* context) {
+  CHECK(pthread_main_np());
+  // A host that goes takes its sheets with it: what it was asked is refused.
+  // Refusing ends a picker, so walk a copy of the ids.
+  std::vector<uint64_t> ids;
+  for (const auto& [id, picker] : rearc::Pickers()) {
+    if (picker->waiting()) {
+      ids.push_back(id);
+    }
+  }
+  ++rearc::epoch;
+  rearc::host = callback;
+  rearc::host_context = context;
+  for (uint64_t id : ids) {
+    auto it = rearc::Pickers().find(id);
+    if (it != rearc::Pickers().end()) {
+      it->second->Abandon();
+    }
+  }
+}
+
+ReArcStatus ReArcDisplayCaptureRespond(uint64_t request_id,
+                                       uint32_t choice,
+                                       uint64_t target_tab_id,
+                                       bool share_audio) {
+  CHECK(pthread_main_np());
+  auto it = rearc::Pickers().find(request_id);
+  if (it == rearc::Pickers().end()) {
+    return REARC_NOT_FOUND;
+  }
+  return it->second->Respond(choice, target_tab_id, share_audio);
+}
+
+ReArcStatus ReArcTabStopDisplayCapture(uint64_t tab_id) {
+  rearc::TabSession* session;
+  if (auto status = rearc::ABICheckTab(tab_id, &session)) {
+    return status;
+  }
+  content::WebContents* contents = session->web_contents();
+  MediaStreamCaptureIndicator* indicator =
+      MediaCaptureDevicesDispatcher::GetInstance()
+          ->GetMediaStreamCaptureIndicator()
+          .get();
+  if (!contents ||
+      !(indicator->IsCapturingTab(contents) ||
+        indicator->IsCapturingWindow(contents) ||
+        indicator->IsCapturingDisplay(contents))) {
+    return REARC_INVALID_STATE;
+  }
+  // As the Stop button of Chromium's own sharing UI: the streams end and the
+  // page's tracks fire "ended".
+  indicator->StopMediaCapturing(
+      contents, MediaStreamCaptureIndicator::MediaType::kDisplayMedia);
+  return REARC_OK;
+}
