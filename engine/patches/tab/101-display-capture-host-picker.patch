+// Screen sharing (display_capture, ABI 1.70): navigator.mediaDevices
+// .getDisplayMedia() of a page in a registry tab. Chromium's handler
+// (DisplayMediaAccessHandler) still decides whether the page may ask at all
+// (permissions policy, a user gesture, a page that is visible) and builds the
+// streams; what to share is asked of the host instead of Chromium's Views
+// picker, and Chromium's own sharing bar and "is sharing your screen" window
+// are not shown: the host draws what is shared from media_capture's
+// capturing_display and ends it with ReArcTabStopDisplayCapture. Before this
+// channel the tab's delegate refused the request (NotSupportedError).
+//
+// phase 0: request_id of tab_id asks; json says what may be offered. The host
+// shows its sheet over that tab and answers with ReArcDisplayCaptureRespond.
+// phase 1: the request is over; close the sheet, no reply. json has
+// "outcome": "shared" (with "kind": "tab", "window" or "screen", "audio":
+// the share carries sound, and for a tab "target_tab"), "cancelled" (the
+// person, in the host's sheet or in the picker of macOS), "failed" (the
+// picker of macOS could not open) or "withdrawn" (the page went or asked
+// again, or its frame navigated). Every request the host was asked ends with
+// exactly one phase 1 event, except a request of a tab that closes: nothing
+// follows tab.closed. Without a callback, for a page that is no registry tab
+// and for an asking frame that is no http or https page, the request is
+// refused (NotSupportedError) and the host hears nothing.
+//
+// json is a UTF-8 object; a host ignores keys it does not know. 64-bit
+// numbers are decimal strings.
+//   "origin": the asking frame; "top_origin": the tab's page (they differ for
+//     a frame of another site). "profile_id", "content_generation".
+//   "audio": the page asked for sound too. "tab_audio", "window_audio",
+//     "screen_audio": sound can go with that kind of share (a tab's own
+//     sound; for a window or the screen the sound of the Mac or of the
+//     window's app, which macOS asks the person about itself the first time).
+//   "current_tab": the asking tab itself may be shared (false: the page
+//     excluded it). "window", "screen": that kind may be shared (false for a
+//     screen the page excluded, and for both where macOS has no picker).
+//   "prefer": what the page would like offered first: "current_tab", "tab",
+//     "window", "screen" or "".
+//   "system_picker": a window or the screen is chosen in the picker of macOS
+//     (SCContentSharingPicker), which opens after the host's answer; the
+//     engine lists no windows and reads none.
+//   "screen_recording_permission": "not_needed" (macOS 15 and later: the
+//     choice in the system's picker is the permission), "granted" or
+//     "missing" (macOS 14 without Screen Recording allowed for the app: the
+//     host explains and sends the person to System Settings; a window or
+//     screen answer is invalid_state until it is granted).
+typedef void (*ReArcDisplayCaptureCallback)(void* context,
+                                            uint64_t request_id,
+                                            uint64_t tab_id,
+                                            uint32_t phase,
+                                            const char* json);
+// Replacing or clearing the callback refuses the requests it was asked.
+REARC_ENGINE_EXPORT void ReArcEngineSetDisplayCaptureCallback(
+    ReArcDisplayCaptureCallback callback, void* context);
+// The person's answer. choice: 0 cancel (the page gets NotAllowedError); 1
+// share the registry tab target_tab_id (its page as it is drawn, whether or
+// not a window shows it); 2 a window, 3 the screen: the picker of macOS opens
+// and its outcome arrives as the phase 1 event. share_audio: with sound,
+// where the request's json offers it for that kind (ignored otherwise).
+// target_tab_id is read for choice 1 only. It must be a live tab of the
+// asking tab's profile and browser context, not the asking tab when
+// "current_tab" is false, and a page: contents the host shows as a tab, a
+// small window or a peek, whose main frame is on an http, https or file
+// address. A DevTools frontend or its toolbox, an extension's popup or side
+// panel and a browser page (chrome:, devtools:, chrome-extension:,
+// about:blank) are never shared, whatever the host lists: invalid_argument
+// for all of these; a tab that does not exist: not_found; one whose page is
+// not running (crashed or discarded): invalid_state. A kind the json did not offer, a second answer, an answer
+// while the picker of macOS is open, and a window or screen answer while
+// "screen_recording_permission" is "missing": invalid_state. An unknown
+// choice: invalid_argument. A request that is over: not_found. After a
+// refused answer the request is still open.
+REARC_ENGINE_EXPORT ReArcStatus ReArcDisplayCaptureRespond(uint64_t request_id,
+                                                           uint32_t choice,
+                                                           uint64_t target_tab_id,
+                                                           bool share_audio);
+// Ends everything tab_id's page shares (tabs, windows, screens and their
+// sound), as the Stop button of Chromium's sharing bar: the page's tracks
+// fire "ended". Camera and microphone are untouched. A tab that shares
+// nothing: invalid_state. media_capture reports capturing_display false
+// afterwards.
+REARC_ENGINE_EXPORT ReArcStatus ReArcTabStopDisplayCapture(uint64_t tab_id);
+
 #ifdef __cplusplus
 }  // extern "C"
 #endif
