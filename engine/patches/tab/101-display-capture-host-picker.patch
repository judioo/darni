+// Copyright 2026 The ReArc Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_REARC_BRIDGE_REARC_DISPLAY_CAPTURE_H_
+#define CHROME_BROWSER_REARC_BRIDGE_REARC_DISPLAY_CAPTURE_H_
+
+#include <memory>
+
+class MediaAccessHandler;
+
+namespace content {
+struct MediaStreamRequest;
+}  // namespace content
+
+namespace rearc {
+
+// Screen sharing (display_capture, ABI 1.70).
+//
+// navigator.mediaDevices.getDisplayMedia() reaches the tab's
+// WebContentsDelegate as a media access request of the display types. Chrome
+// answers it in DisplayMediaAccessHandler, which asks a DesktopMediaPicker
+// what to share (a Views dialog on the browser window) and then shows what is
+// shared in Views UI of its own (the tab-sharing infobar, the "is sharing
+// your screen" window). A bridge tab has no browser window, and until this
+// patch its delegate refused the display types, so a page's request failed at
+// once with NotSupportedError.
+//
+// The handler stays Chromium's: the permissions-policy check, the user
+// activation check, the rule that a page nobody sees gets no picker, the
+// request queue of a tab, the devices of the answer and the capture
+// indicator's bookkeeping. Only its two pieces of UI are the host's.
+//
+// The handler for MediaCaptureDevicesDispatcher. Under the ReArc shell
+// (IsEngineEmbeddedMode) it is Chromium's DisplayMediaAccessHandler with a
+// picker that asks the host and without Chromium's sharing notification UI;
+// otherwise Chromium's own, unchanged.
+std::unique_ptr<MediaAccessHandler> MakeDisplayMediaAccessHandler();
+
+// A request the tab delegate gives to the dispatcher for the handler above:
+// video of a tab, window or screen, with or without its audio. Anything else
+// of the display and tab capture families (audio alone, an extension's
+// desktopCapture and tabCapture streams, every screen at once) stays refused,
+// as before.
+bool IsHostDisplayCaptureRequest(const content::MediaStreamRequest& request);
+
+}  // namespace rearc
+
+#endif  // CHROME_BROWSER_REARC_BRIDGE_REARC_DISPLAY_CAPTURE_H_
