@@ -0,0 +1,204 @@
+// Copyright 2026 The ReArc Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// tab_freeze (ABI 1.71, tab/103). The host asks that a tab nobody has looked
+// at for a while be frozen: its page stays in memory and its scripts and
+// timers stop (page lifecycle "frozen"), and showing the tab resumes it at
+// once, with no reload. The freezing itself is Chromium's: the bridge holds a
+// performance_manager::freezing::FreezingVote for the tab, and Chromium's
+// FreezingPolicy freezes the page while none of its CannotFreezeReasons
+// applies (visible or recently visible, audible or recently audible, camera,
+// microphone, WebRTC, being mirrored, a Web Lock or IndexedDB lock, a USB,
+// Bluetooth, HID or serial device, loading, notification permission, WebUI)
+// and thaws it the moment one starts. What Chromium does not know about a
+// bridge tab is checked here.
+
+#include <pthread.h>
+
+#include "base/check.h"
+#include "base/memory/weak_ptr.h"
+#include "chrome/browser/rearc_bridge/media_adapter.h"
+#include "chrome/browser/rearc_bridge/rearc_abi_internal.h"
+#include "chrome/browser/rearc_bridge/rearc_devtools.h"
+#include "chrome/browser/rearc_bridge/tab_registry.h"
+#include "chrome/browser/rearc_bridge/tab_session.h"
+#include "chrome/browser/webauthn/authenticator_request_scheduler.h"
+#include "components/download/public/common/download_item.h"
+#include "components/download/public/common/simple_download_manager.h"
+#include "components/performance_manager/public/freezing/freezing.h"
+#include "components/performance_manager/public/graph/page_node.h"
+#include "components/performance_manager/public/performance_manager.h"
+#include "components/permissions/permission_request_manager.h"
+#include "content/public/browser/browser_context.h"
+#include "content/public/browser/download_item_utils.h"
+#include "content/public/browser/download_manager.h"
+#include "content/public/browser/media_player_id.h"
+#include "content/public/browser/navigation_controller.h"
+#include "content/public/browser/navigation_handle.h"
+#include "content/public/browser/render_frame_host.h"
+#include "content/public/browser/visibility.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/browser/web_contents_observer.h"
+#include "content/public/browser/web_contents_user_data.h"
+
+namespace rearc {
+namespace {
+
+// The host's request for one tab, and Chromium's vote with it. It goes, and
+// the page thaws, when the tab is shown or used: the host asks again once the
+// tab has been left alone for its own time.
+class FreezeHold : public content::WebContentsUserData<FreezeHold>,
+                   public content::WebContentsObserver {
+ public:
+  ~FreezeHold() override = default;
+
+  // content::WebContentsObserver:
+  void OnVisibilityChanged(content::Visibility visibility) override {
+    if (visibility != content::Visibility::HIDDEN) {
+      Drop();
+    }
+  }
+  void DidStartNavigation(content::NavigationHandle* handle) override {
+    if (handle->IsInPrimaryMainFrame() && !handle->IsSameDocument()) {
+      Drop();
+    }
+  }
+  void OnAudioStateChanged(bool audible) override {
+    if (audible) {
+      Drop();
+    }
+  }
+  void MediaStartedPlaying(const MediaPlayerInfo&,
+                           const content::MediaPlayerId&) override {
+    Drop();
+  }
+  void MediaPictureInPictureChanged(bool is_picture_in_picture) override {
+    if (is_picture_in_picture) {
+      Drop();
+    }
+  }
+  void AboutToBeDiscarded(content::WebContents*) override { Drop(); }
+  void PrimaryMainFrameRenderProcessGone(base::TerminationStatus) override {
+    Drop();
+  }
+  // The vote must go while the contents can still be reached: removing it
+  // makes the policy thaw the page through the WebContents.
+  void WebContentsDestroyed() override { Drop(); }
+
+ private:
+  friend class content::WebContentsUserData<FreezeHold>;
+  explicit FreezeHold(content::WebContents* contents)
+      : content::WebContentsUserData<FreezeHold>(*contents),
+        content::WebContentsObserver(contents),
+        vote_(contents) {}
+
+  // Deletes this.
+  void Drop() { web_contents()->RemoveUserData(UserDataKey()); }
+
+  performance_manager::freezing::FreezingVote vote_;
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+};
+WEB_CONTENTS_USER_DATA_KEY_IMPL(FreezeHold);
+
+// A download the tab started that is still running.
+bool HasDownloadInProgress(content::WebContents* contents) {
+  content::DownloadManager* manager =
+      contents->GetBrowserContext()->GetDownloadManager();
+  if (!manager) {
+    return false;
+  }
+  download::SimpleDownloadManager::DownloadVector items;
+  manager->GetAllDownloads(&items);
+  for (download::DownloadItem* item : items) {
+    if (item->GetState() == download::DownloadItem::IN_PROGRESS &&
+        content::DownloadItemUtils::GetWebContents(item) == contents) {
+      return true;
+    }
+  }
+  return false;
+}
+
+// A permission question or a passkey request of the tab that is not answered.
+bool HasOpenRequest(content::WebContents* contents) {
+  auto* permissions =
+      permissions::PermissionRequestManager::FromWebContents(contents);
+  if (permissions && (permissions->IsRequestInProgress() ||
+                      permissions->has_pending_requests())) {
+    return true;
+  }
+  return AuthenticatorRequestScheduler::GetRequestDelegate(contents) != nullptr;
+}
+
+}  // namespace
+
+void ABIDropFreezeVote(uint64_t tab_id) {
+  CHECK(pthread_main_np());
+  TabSession* session = TabRegistry::Get().FindSession(tab_id);
+  if (session && session->web_contents()) {
+    session->web_contents()->RemoveUserData(FreezeHold::UserDataKey());
+  }
+}
+
+}  // namespace rearc
+
+ReArcStatus ReArcTabFreeze(uint64_t tab) {
+  CHECK(pthread_main_np());
+  rearc::TabSession* session;
+  if (auto status = rearc::ABICheckTab(tab, &session)) return status;
+  auto* contents = session->web_contents();
+  if (rearc::IsHostedDevTools(contents)) return REARC_UNSUPPORTED;
+  if (!performance_manager::PerformanceManager::IsAvailable() ||
+      !performance_manager::PerformanceManager::GetPrimaryPageNodeForWebContents(
+          contents)) {
+    return REARC_UNSUPPORTED;
+  }
+  if (rearc::FreezeHold::FromWebContents(contents)) return REARC_OK;
+  auto& controller = contents->GetController();
+  // The tab is on screen, or in use in a way a frozen page would break. The
+  // shared tab is one of them: a tab that is shared while nobody looks at it
+  // is a hidden capturer's (tab/102), which Chromium's policy does not see.
+  if (contents->WasDiscarded() || rearc::ABIHasVisibilityIntent(tab) ||
+      contents->GetVisibility() != content::Visibility::HIDDEN ||
+      contents->IsLoading() || controller.GetPendingEntry() ||
+      contents->HasUncommittedNavigationInPrimaryMainFrame() ||
+      !controller.GetLastCommittedEntry() || contents->IsCrashed() ||
+      !contents->GetPrimaryMainFrame()->IsRenderFrameLive() ||
+      contents->IsBeingCaptured() || contents->IsCurrentlyAudible() ||
+      rearc::MediaIsPlaying(tab) || contents->HasPictureInPictureVideo() ||
+      contents->HasPictureInPictureDocument() || contents->IsFullscreen() ||
+      rearc::HasOpenRequest(contents) ||
+      rearc::HasDownloadInProgress(contents)) {
+    return REARC_INVALID_STATE;
+  }
+  if (rearc::ABIDiscardServicesBusy(tab)) return REARC_BUSY;
+  rearc::FreezeHold::CreateForWebContents(contents);
+  return REARC_OK;
+}
+
+ReArcStatus ReArcTabUnfreeze(uint64_t tab) {
+  CHECK(pthread_main_np());
+  rearc::TabSession* session;
+  if (auto status = rearc::ABICheckTab(tab, &session)) return status;
+  rearc::ABIDropFreezeVote(tab);
+  return REARC_OK;
+}
+
+ReArcStatus ReArcTabGetFreezeState(uint64_t tab, bool* requested, bool* frozen) {
+  CHECK(pthread_main_np());
+  if (requested) *requested = false;
+  if (frozen) *frozen = false;
+  if (!requested || !frozen) return REARC_INVALID_ARGUMENT;
+  rearc::TabSession* session;
+  if (auto status = rearc::ABICheckTab(tab, &session)) return status;
+  auto* contents = session->web_contents();
+  *requested = rearc::FreezeHold::FromWebContents(contents) != nullptr;
+  if (performance_manager::PerformanceManager::IsAvailable()) {
+    auto page =
+        performance_manager::PerformanceManager::GetPrimaryPageNodeForWebContents(
+            contents);
+    *frozen = page && page->GetLifecycleState() ==
+                          performance_manager::PageNode::LifecycleState::kFrozen;
+  }
+  return REARC_OK;
+}
