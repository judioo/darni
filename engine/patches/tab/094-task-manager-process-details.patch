+// Task manager (task_manager, ABI 1.65): the same rows as
+// ReArcEngineGetProcesses, and details_json: a UTF-8 JSON object keyed by
+// decimal pid with what a task manager shows besides. Every row has an entry.
+// A key that does not apply is left out, and a host ignores keys it does not
+// know. 64-bit numbers are decimal strings.
+//   "network_bytes": bytes received plus sent, a running total. Requests no
+//     frame made are the browser's, as in Chrome's task manager. The engine
+//     counts while a host keeps asking and stops about 5 s after the last
+//     request, so a host takes a rate from two successive answers and none
+//     across a pause.
+//   Renderers: "main_frame_tabs": the tab_ids whose page (primary main frame)
+//     is in this process. "subframe_tabs": the tab_ids with only a frame of
+//     another site of their page here, and "site", the site URL of the first
+//     such frame. A tab_id in neither has a page kept for Back here, or one
+//     loading ahead. "extension_id" and "extension_name" for an enabled
+//     extension's process. "spare": true for the spare renderer.
+//   Browser child processes: "title", Chrome's display name ("Network
+//     Service").
+// Deferred, exactly once. details_json is borrowed and never null with
+// REARC_OK. Ending a process needs no call: the processes are the host's own
+// children, and Chrome's task manager on macOS signals them too (SIGTERM);
+// the tabs in it then report is_crashed.
+typedef void (*ReArcProcessDetailsCallback)(void* context,
+                                            ReArcStatus status,
+                                            const ReArcProcessInfo* processes,
+                                            size_t count,
+                                            const char* details_json);
+REARC_ENGINE_EXPORT ReArcStatus ReArcEngineGetProcessDetails(
+    ReArcProcessDetailsCallback completion, void* context);
+
 #ifdef __cplusplus
 }  // extern "C"
 #endif
