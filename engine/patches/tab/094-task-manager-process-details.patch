 }
+void RecordNetworkBytes(int renderer_id, uint64_t bytes) {
+  if (g_last_details_request.is_null()) return;
+  if (base::TimeTicks::Now() - g_last_details_request > kNetworkCountLinger) {
+    // The host stopped asking (its task manager closed or went out of sight):
+    // the network service stops reporting until the host asks again.
+    g_last_details_request = base::TimeTicks();
+    if (CanReachNetworkService()) {
+      content::GetNetworkService()->EnableDataUseUpdates(false);
+    }
+    return;
+  }
+  NetworkBytes()[renderer_id] += bytes;
+}
