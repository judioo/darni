         completion(context, REARC_OK, infos.data(), infos.size());
       },
       completion, context));
   return REARC_OK;
 }
+
+ReArcStatus ReArcEngineGetProcessDetails(ReArcProcessDetailsCallback completion,
+                                         void* context) {
+  CHECK(pthread_main_np());
+  if (!completion) return REARC_INVALID_ARGUMENT;
+  rearc::ABIPost(base::BindOnce(
+      [](ReArcProcessDetailsCallback completion, void* context) {
+        rearc::KeepCountingNetworkBytes();
+        const std::vector<rearc::ProcessRow> rows = rearc::CollectProcesses();
+        const std::vector<ReArcProcessInfo> infos = rearc::ProcessInfos(rows);
+        const std::string details = rearc::ProcessDetailsJson(rows);
+        completion(context, REARC_OK, infos.data(), infos.size(),
+                   details.c_str());
+      },
+      completion, context));
+  return REARC_OK;
+}
