+// Bytes received plus sent by ProcessRow::network_key, counted while a host
+// asks for process details.
+std::map<int, uint64_t>& NetworkBytes() {
+  static base::NoDestructor<std::map<int, uint64_t>> bytes;
+  return *bytes;
+}
+// When a host last asked for details. Null: nothing is counted.
+base::TimeTicks g_last_details_request;
+constexpr base::TimeDelta kNetworkCountLinger = base::Seconds(5);
+
+bool CanReachNetworkService() {
+  return g_browser_process && !g_browser_process->IsShuttingDown();
+}
+
+// The network service reports data use only when asked (Chrome asks while its
+// task manager is open). Asked with every request: a network service that
+// restarted starts with the reports off.
+void KeepCountingNetworkBytes() {
+  if (!CanReachNetworkService()) return;
+  g_last_details_request = base::TimeTicks::Now();
+  content::GetNetworkService()->EnableDataUseUpdates(true);
+}
+
+bool IsSpareRenderer(content::RenderProcessHost* host) {
+  for (const auto& spare :
+       content::SpareRenderProcessHostManager::Get().GetSpares()) {
+    if (spare.get() == host) return true;
+  }
+  return false;
+}
+
+// The browser first, then every live renderer and browser child process.
+std::vector<ProcessRow> CollectProcesses() {
+  std::vector<ProcessRow> rows;
+  rows.push_back({static_cast<int32_t>(getpid()), 0, "browser"});
+  rows.back().network_key = perf::kNoRenderer;
+  std::map<int, size_t> renderers;
+  for (auto it = content::RenderProcessHost::AllHostsIterator(); !it.IsAtEnd();
+       it.Advance()) {
+    content::RenderProcessHost* host = it.GetCurrentValue();
+    if (!host->IsInitializedAndNotDead() || !host->GetProcess().IsValid()) {
+      continue;
+    }
+    ProcessRow row;
+    row.pid = host->GetProcess().Pid();
+    row.type = 1;
+    row.network_key = host->GetDeprecatedID();
+    content::BrowserContext* context = host->GetBrowserContext();
+    row.profile_id = BridgeProfileId(Profile::FromBrowserContext(context));
+    if (auto* map = extensions::ProcessMap::Get(context)) {
+      row.is_extension = map->Contains(host->GetDeprecatedID());
+      if (const extensions::Extension* extension =
+              map->GetEnabledExtensionByProcessID(host->GetID())) {
+        row.extension_id = extension->id();
+        row.extension_name = extension->name();
+      }
+    }
+    row.spare = IsSpareRenderer(host);
+    renderers[host->GetDeprecatedID()] = rows.size();
+    rows.push_back(std::move(row));
+  }
+  auto& registry = TabRegistry::Get();
+  for (uint64_t id : registry.SessionIds()) {
+    TabSession* session = registry.FindSession(id);
+    if (!session) continue;
+    content::RenderFrameHost* main =
+        session->web_contents()->GetPrimaryMainFrame();
+    // What the tab has in each process. 2: its page's main frame. 1: only a
+    // frame of another site of its page. 0: a page kept for Back, or one
+    // loading ahead.
+    std::map<size_t, int> hosting;
+    session->web_contents()->ForEachRenderFrameHost(
+        [&](content::RenderFrameHost* frame) {
+          auto found = renderers.find(frame->GetProcess()->GetDeprecatedID());
+          if (found == renderers.end()) return;
+          int& role = hosting[found->second];
+          if (frame == main) {
+            role = 2;
+          } else if (role == 0 && frame->IsActive() &&
+                     frame->GetOutermostMainFrame() == main) {
+            role = 1;
+            ProcessRow& row = rows[found->second];
+            if (row.site.empty()) {
+              row.site = frame->GetSiteInstance()
+                             ->GetSecurityPrincipal()
+                             .GetDeprecatedSiteURL()
+                             .spec();
+            }
+          }
+        });
+    for (const auto& [index, role] : hosting) {
+      rows[index].tab_ids.push_back(id);
+      if (role == 2) rows[index].main_frame_tab_ids.push_back(id);
+      if (role == 1) rows[index].subframe_tab_ids.push_back(id);
+    }
+  }
+  for (content::BrowserChildProcessHostIterator it; !it.Done(); ++it) {
+    const base::Process& process = it.GetProcess();
+    if (!process.IsValid()) continue;
+    const content::ChildProcessData& data = it.GetData();
+    ProcessRow row;
+    row.pid = process.Pid();
+    row.type = data.process_type == content::PROCESS_TYPE_GPU ? 2
+               : data.process_type == content::PROCESS_TYPE_UTILITY ? 3
+                                                                    : 4;
+    row.name = data.metrics_name.empty() ? base::UTF16ToUTF8(data.name)
+                                         : data.metrics_name;
+    row.title = base::UTF16ToUTF8(data.name);
+    rows.push_back(std::move(row));
+  }
+  return rows;
+}
+
+// Borrows the rows' strings and tab ids.
+std::vector<ReArcProcessInfo> ProcessInfos(const std::vector<ProcessRow>& rows) {
+  std::vector<ReArcProcessInfo> infos;
+  for (const auto& row : rows) {
+    ReArcProcessInfo info{row.pid,
+                          row.type,
+                          row.name.c_str(),
+                          row.profile_id,
+                          row.is_extension,
+                          row.tab_ids.data(),
+                          row.tab_ids.size(),
+                          0,
+                          0,
+                          0};
+    FillUsage(info);
+    infos.push_back(info);
+  }
+  return infos;
+}
+
+base::ListValue TabIdList(const std::vector<uint64_t>& ids) {
+  base::ListValue list;
+  for (uint64_t id : ids) list.Append(base::NumberToString(id));
+  return list;
+}
+
+// details_json of ReArcEngineGetProcessDetails (rearc_engine_abi.h).
+std::string ProcessDetailsJson(const std::vector<ProcessRow>& rows) {
+  std::map<int, uint64_t>& bytes = NetworkBytes();
+  // A renderer that is gone takes its count with it.
+  std::set<int> counted;
+  for (const ProcessRow& row : rows) counted.insert(row.network_key);
+  std::erase_if(bytes,
+                [&](const auto& entry) { return !counted.contains(entry.first); });
+  base::DictValue details;
+  for (const ProcessRow& row : rows) {
+    base::DictValue entry;
+    auto used = bytes.find(row.network_key);
+    entry.Set("network_bytes",
+              base::NumberToString(used == bytes.end() ? uint64_t{0}
+                                                       : used->second));
+    if (row.type == 1) {
+      entry.Set("main_frame_tabs", TabIdList(row.main_frame_tab_ids));
+      entry.Set("subframe_tabs", TabIdList(row.subframe_tab_ids));
+      if (!row.site.empty()) entry.Set("site", row.site);
+      if (!row.extension_id.empty()) {
+        entry.Set("extension_id", row.extension_id);
+        entry.Set("extension_name", row.extension_name);
+      }
+      if (row.spare) entry.Set("spare", true);
+    } else if (!row.title.empty()) {
+      entry.Set("title", row.title);
+    }
+    details.Set(base::NumberToString(row.pid), std::move(entry));
+  }
+  return base::WriteJson(details).value_or("{}");
+}
+
 }  // namespace
 
 namespace perf {
