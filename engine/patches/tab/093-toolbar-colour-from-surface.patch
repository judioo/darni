+  // Scope 2 copies the view's own surface. A clipped Page.captureScreenshot
+  // renders its frame under device emulation (viewport offset and scale), so
+  // the page re-laid out and showed a blank, shifted frame each time a scroll
+  // settled and the host sampled its toolbar colour.
+  void CaptureTopEdge(uint64_t epoch) {
+    auto* view = web_contents()->GetRenderWidgetHostView();
+    const gfx::Size size = view ? view->GetViewBounds().size() : gfx::Size();
+    if (!view || size.IsEmpty()) {
+      FinishSnapshot(REARC_INVALID_STATE, {});
+      return;
+    }
+    // The callback may run on another sequence; it hops back to this one.
+    view->CopyFromSurface(
+        gfx::Rect(0, 0, size.width(), std::min(size.height(), 4)), gfx::Size(),
+        base::Seconds(2),
+        base::BindOnce(
+            [](scoped_refptr<base::SequencedTaskRunner> runner,
+               base::WeakPtr<PageServices> self, uint64_t epoch,
+               const content::CopyFromSurfaceResult& result) {
+              SkBitmap bitmap;
+              if (result.has_value()) bitmap = result->bitmap;
+              runner->PostTask(
+                  FROM_HERE, base::BindOnce(&PageServices::FinishTopEdge,
+                                            self, epoch, std::move(bitmap)));
+            },
+            base::SequencedTaskRunner::GetCurrentDefault(),
+            weak_factory_.GetWeakPtr(), epoch));
+  }
+  void FinishTopEdge(uint64_t epoch, SkBitmap bitmap) {
+    if (!snapshot_callback_ || snapshot_epoch_ != epoch) {
+      return;
+    }
+    if (!Current() || epoch != document_epoch_) {
+      FinishSnapshot(REARC_CANCELLED, {});
+      return;
+    }
+    if (bitmap.drawsNothing()) {
+      FinishSnapshot(REARC_INVALID_STATE, {});
+      return;
+    }
+    auto png = gfx::PNGCodec::EncodeBGRASkBitmap(bitmap,
+                                                 /*discard_transparency=*/true);
+    if (!png || png->size() > REARC_MAX_BLOB_BYTES) {
+      FinishSnapshot(png ? REARC_TOO_LARGE : REARC_INTERNAL, {});
+      return;
+    }
+    FinishSnapshot(REARC_OK, std::string(png->begin(), png->end()));
+  }
   void FinishSnapshot(ReArcStatus status, std::string png) {
     auto callback = snapshot_callback_;
     snapshot_callback_ = nullptr;
