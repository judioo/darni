+// Site permissions (site_permissions, ABI 1.67): what Chromium holds for the
+// site of the tab's page, for a site information panel. The site is the
+// primary main frame's committed origin, http and https only. The state is
+// Chromium's (HostContentSettingsMap, the permission auto-blocker's embargo,
+// the USB, HID, serial and Bluetooth device grants); the host keeps none of it
+// and asks again on the change callback, on a navigation and on a
+// media_capture event.
+//
+// json is a UTF-8 object; a host ignores keys it does not know:
+//   "origin": the site, serialized ("https://example.com"); "" for a page
+//     without one (an empty tab, a file, an internal page), and then no
+//     other key.
+//   "off_the_record": the tab's profile is a private one.
+//   "permissions": every setting a site can have, in Chromium's page info
+//     order. "type": Chromium's name of the content setting, as in its
+//     content settings registry ("notifications", "geolocation",
+//     "media-stream-camera", "media-stream-mic", "clipboard", "usb-guard",
+//     "bluetooth-guard", "local-network", ...). "setting" and "default":
+//     "allow", "block" or "ask"; default is what the site has without a rule
+//     of its own. "source": "default" (no rule for the site), "user" (the
+//     person's rule for the site), "policy", "extension", "embargo" (blocked
+//     for a while after repeated dismissals) or "other". "held": page info
+//     would list it (a rule for the site, a setting the person does not
+//     control, an embargo, or a default the person changed away from asking).
+//     "changeable": ReArcTabSetSitePermission may change it (false under
+//     policy or an extension). "one_time": allowed for this visit only.
+//   "devices": the devices the person chose for the site. "kind": "usb",
+//     "hid", "serial" or "bluetooth"; "key": the grant's identity for
+//     ReArcTabRevokeSiteDevice; "name": Chromium's display name;
+//     "changeable": false for a policy grant.
+//   "in_use": what the page uses now: "camera", "microphone", "screen",
+//     "location", "bluetooth", "usb", "hid", "serial".
+// Snapshot at call time, delivered deferred, exactly once, borrowed. Popups,
+// panels and DevTools answer like any tab.
+typedef void (*ReArcSitePermissionsCallback)(void* context,
+                                             ReArcStatus status,
+                                             uint64_t tab_id,
+                                             const char* json);
+REARC_ENGINE_EXPORT ReArcStatus ReArcTabGetSitePermissions(
+    uint64_t tab_id, ReArcSitePermissionsCallback completion, void* context);
+// Changes one setting of the tab's site, as Chromium's page info does.
+// origin: the "origin" the host showed. The tab's site is another one by now
+// (a navigation since): invalid_state, and nothing changes. type: a "type" of
+// the list (others invalid_argument). setting: 0 reset (the site's rule goes;
+// the default applies again, and an embargo ends), 1 allow, 2 block. A row
+// that is not changeable: invalid_state. A value the type does not take:
+// unsupported. Chromium persists the rule in the tab's profile (a private
+// profile's rules end with it). A page already loaded may keep what it had
+// until it is reloaded; the host reloads or says so.
+REARC_ENGINE_EXPORT ReArcStatus ReArcTabSetSitePermission(uint64_t tab_id,
+                                                          const char* origin,
+                                                          const char* type,
+                                                          uint32_t setting);
+// Takes a chosen device from the site again. origin as above; kind and key
+// from "devices". No such grant: not_found. A policy grant: invalid_state.
+REARC_ENGINE_EXPORT ReArcStatus ReArcTabRevokeSiteDevice(uint64_t tab_id,
+                                                         const char* origin,
+                                                         const char* kind,
+                                                         const char* key);
+// The answer for a tab changed: a setting of its profile that applies to its
+// site, a device grant, or a device the page started or stopped using. At
+// most one call per tab is queued; the event carries no state. Never after
+// tab.closed. Null disables delivery.
+typedef void (*ReArcSitePermissionsChangedCallback)(void* context,
+                                                    uint64_t tab_id);
+REARC_ENGINE_EXPORT void ReArcEngineSetSitePermissionsChangedCallback(
+    ReArcSitePermissionsChangedCallback callback, void* context);
+
 #ifdef __cplusplus
 }  // extern "C"
 #endif
