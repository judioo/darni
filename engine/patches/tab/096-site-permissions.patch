+namespace rearc {
+namespace {
+
+using content_settings::PermissionSettingsInfo;
+using content_settings::SettingSource;
+
+ReArcSitePermissionsChangedCallback host = nullptr;
+void* host_context = nullptr;
+uint64_t epoch = 0;
+
+// The settings a site can hold, in page info's order (kPermissionType in
+// components/page_info/page_info.cc, the desktop entries). Left out: ADS
+// (Chrome's own ad filter, not ReArc's blocking), AUTO_PICTURE_IN_PICTURE (the
+// host has its own per-site rule) and WEB_APP_INSTALLATION (no installed web
+// apps). Only one of the two geolocation types is live (see IsLive).
+constexpr ContentSettingsType kTypes[] = {
+    ContentSettingsType::GEOLOCATION,
+    ContentSettingsType::GEOLOCATION_WITH_OPTIONS,
+    ContentSettingsType::MEDIASTREAM_CAMERA,
+    ContentSettingsType::CAMERA_PAN_TILT_ZOOM,
+    ContentSettingsType::MEDIASTREAM_MIC,
+    ContentSettingsType::SENSORS,
+    ContentSettingsType::NOTIFICATIONS,
+    ContentSettingsType::JAVASCRIPT,
+    ContentSettingsType::IMAGES,
+    ContentSettingsType::POPUPS,
+    ContentSettingsType::WINDOW_MANAGEMENT,
+    ContentSettingsType::BACKGROUND_SYNC,
+    ContentSettingsType::SOUND,
+    ContentSettingsType::AUTOMATIC_DOWNLOADS,
+    ContentSettingsType::MIDI_SYSEX,
+    ContentSettingsType::CLIPBOARD_READ_WRITE,
+    ContentSettingsType::USB_GUARD,
+    ContentSettingsType::HID_GUARD,
+    ContentSettingsType::SERIAL_GUARD,
+    ContentSettingsType::FILE_SYSTEM_WRITE_GUARD,
+    ContentSettingsType::LOCAL_FONTS,
+    ContentSettingsType::BLUETOOTH_GUARD,
+    ContentSettingsType::BLUETOOTH_SCANNING,
+    ContentSettingsType::HAND_TRACKING,
+    ContentSettingsType::VR,
+    ContentSettingsType::AR,
+    ContentSettingsType::IDLE_DETECTION,
+    ContentSettingsType::FEDERATED_IDENTITY_API,
+    ContentSettingsType::CAPTURED_SURFACE_CONTROL,
+    ContentSettingsType::AUTOMATIC_FULLSCREEN,
+    ContentSettingsType::KEYBOARD_LOCK,
+    ContentSettingsType::POINTER_LOCK,
+    ContentSettingsType::LOCAL_NETWORK,
+    ContentSettingsType::LOOPBACK_NETWORK,
+};
+
+// Device grants (page info's kChooserUIInfo): the ABI's kind, and the
+// website setting whose change says a grant came or went.
+struct DeviceKind {
+  const char* name;
+  ContentSettingsType data_type;
+};
+constexpr DeviceKind kDeviceKinds[] = {
+    {"usb", ContentSettingsType::USB_CHOOSER_DATA},
+    {"hid", ContentSettingsType::HID_CHOOSER_DATA},
+    {"serial", ContentSettingsType::SERIAL_CHOOSER_DATA},
+    {"bluetooth", ContentSettingsType::BLUETOOTH_CHOOSER_DATA},
+};
+
+bool IsLive(ContentSettingsType type) {
+  if (type == ContentSettingsType::GEOLOCATION ||
+      type == ContentSettingsType::GEOLOCATION_WITH_OPTIONS) {
+    return type == content_settings::GeolocationContentSettingsType();
+  }
+  return true;
+}
+
+const PermissionSettingsInfo* InfoFor(ContentSettingsType type) {
+  return content_settings::PermissionSettingsRegistry::GetInstance()->Get(type);
+}
+
+// The ABI's name of a type: Chromium's own, from the content settings
+// registry ("notifications", "media-stream-camera", "usb-guard").
+const std::string* NameOf(ContentSettingsType type) {
+  const content_settings::WebsiteSettingsInfo* info =
+      content_settings::WebsiteSettingsRegistry::GetInstance()->Get(type);
+  return info ? &info->name() : nullptr;
+}
+
+std::optional<ContentSettingsType> TypeNamed(std::string_view name) {
+  for (ContentSettingsType type : kTypes) {
+    const std::string* candidate = NameOf(type);
+    if (IsLive(type) && InfoFor(type) && candidate && *candidate == name) {
+      return type;
+    }
+  }
+  return std::nullopt;
+}
+
+const char* SettingName(const PermissionSettingsInfo& info,
+                        const PermissionSetting& setting) {
+  if (info.delegate().IsBlocked(setting)) {
+    return "block";
+  }
+  if (info.delegate().IsUndecided(setting)) {
+    return "ask";
+  }
+  return info.delegate().IsAnyPermissionAllowed(setting) ? "allow" : "ask";
+}
+
+// Allow or block in the type's own form: most types hold a ContentSetting,
+// location with accuracy options a GeolocationSetting.
+PermissionSetting MakeSetting(const PermissionSettingsInfo& info, bool allow) {
+  if (std::holds_alternative<GeolocationSetting>(
+          info.GetInitialDefaultSetting())) {
+    const PermissionOption option =
+        allow ? PermissionOption::kAllowed : PermissionOption::kDenied;
+    return GeolocationSetting{option, option};
+  }
+  return allow ? CONTENT_SETTING_ALLOW : CONTENT_SETTING_BLOCK;
+}
+
+// The site of the tab's page: the primary main frame's committed origin,
+// http and https only. Nothing for an empty tab, a file or an internal page.
+std::optional<url::Origin> SiteOf(content::WebContents* contents) {
+  if (!contents) {
+    return std::nullopt;
+  }
+  const url::Origin& origin =
+      contents->GetPrimaryMainFrame()->GetLastCommittedOrigin();
+  if (origin.opaque() || (origin.scheme() != url::kHttpScheme &&
+                          origin.scheme() != url::kHttpsScheme)) {
+    return std::nullopt;
+  }
+  return origin;
+}
+
+permissions::ObjectPermissionContextBase* DeviceContext(
+    Profile* profile,
+    ContentSettingsType data_type) {
+  switch (data_type) {
+    case ContentSettingsType::USB_CHOOSER_DATA:
+      return UsbChooserContextFactory::GetForProfile(profile);
+    case ContentSettingsType::HID_CHOOSER_DATA:
+      return HidChooserContextFactory::GetForProfile(profile);
+    case ContentSettingsType::SERIAL_CHOOSER_DATA:
+      return SerialChooserContextFactory::GetForProfile(profile);
+    case ContentSettingsType::BLUETOOTH_CHOOSER_DATA:
+      return base::FeatureList::IsEnabled(
+                 features::kWebBluetoothNewPermissionsBackend)
+                 ? BluetoothChooserContextFactory::GetForProfile(profile)
+                 : nullptr;
+    default:
+      return nullptr;
+  }
+}
+
+base::DictValue DescribePermission(Profile* profile,
+                                   HostContentSettingsMap* map,
+                                   const GURL& url,
+                                   ContentSettingsType type,
+                                   const PermissionSettingsInfo& info,
+                                   const std::string& name) {
+  content_settings::SettingInfo rule;
+  PermissionSetting setting = map->GetPermissionSetting(url, url, type, &rule);
+  const bool site_specific =
+      !(rule.primary_pattern == ContentSettingsPattern::Wildcard() &&
+        rule.secondary_pattern == ContentSettingsPattern::Wildcard());
+  const PermissionSetting default_setting =
+      site_specific ? map->GetDefaultPermissionSetting(type, nullptr) : setting;
+  const PermissionSetting factory_default = info.GetInitialDefaultSetting();
+
+  const char* source = "other";
+  switch (rule.source) {
+    case SettingSource::kUser:
+      source = site_specific ? "user" : "default";
+      break;
+    case SettingSource::kPolicy:
+      source = "policy";
+      break;
+    case SettingSource::kExtension:
+      source = "extension";
+      break;
+    default:
+      break;
+  }
+
+  // A site the person dismissed or ignored too often is blocked for a while
+  // without a rule of its own (the auto-blocker's embargo).
+  bool embargoed = false;
+  if (rule.source == SettingSource::kUser &&
+      permissions::PermissionDecisionAutoBlocker::IsEnabledForContentSetting(
+          type)) {
+    auto* blocker = PermissionDecisionAutoBlockerFactory::GetForProfile(profile);
+    if (blocker && blocker->IsEmbargoed(url, type)) {
+      embargoed = true;
+      setting = info.delegate().ApplyPermissionEmbargo(setting);
+      source = "embargo";
+    }
+  }
+
+  // Granted in the profile, a setting is back to "ask" in its private
+  // windows until the site asks there: nothing the site holds.
+  const bool private_default =
+      profile->IsOffTheRecord() && info.delegate().IsUndecided(setting) &&
+      info.delegate().IsUndecided(factory_default);
+  const bool held =
+      embargoed || (site_specific && !private_default) ||
+      rule.source != SettingSource::kUser ||
+      (default_setting != factory_default &&
+       !info.delegate().IsUndecided(default_setting));
+
+  base::DictValue row;
+  row.Set("type", name);
+  row.Set("setting", SettingName(info, setting));
+  row.Set("default", SettingName(info, default_setting));
+  row.Set("source", source);
+  row.Set("held", held);
+  row.Set("changeable", rule.source == SettingSource::kUser);
+  row.Set("one_time", rule.metadata.session_model() ==
+                          content_settings::mojom::SessionModel::ONE_TIME);
+  return row;
+}
+
+std::string Describe(TabSession& session) {
+  content::WebContents* contents = session.web_contents();
+  base::DictValue document;
+  std::optional<url::Origin> site = SiteOf(contents);
+  if (!site) {
+    // A page without a site: the host shows no permissions for it.
+    document.Set("origin", "");
+    return base::WriteJson(document).value_or("{}");
+  }
+  Profile* profile = Profile::FromBrowserContext(contents->GetBrowserContext());
+  HostContentSettingsMap* map =
+      HostContentSettingsMapFactory::GetForProfile(profile);
+  const GURL url = site->GetURL();
+  document.Set("origin", site->Serialize());
+  document.Set("off_the_record", profile->IsOffTheRecord());
+
+  base::ListValue rows;
+  for (ContentSettingsType type : kTypes) {
+    const PermissionSettingsInfo* info = InfoFor(type);
+    const std::string* name = NameOf(type);
+    if (!IsLive(type) || !info || !name) {
+      continue;
+    }
+    rows.Append(DescribePermission(profile, map, url, type, *info, *name));
+  }
+  document.Set("permissions", std::move(rows));
+
+  base::ListValue devices;
+  for (const DeviceKind& kind : kDeviceKinds) {
+    permissions::ObjectPermissionContextBase* context =
+        DeviceContext(profile, kind.data_type);
+    if (!context) {
+      continue;
+    }
+    for (const auto& object : context->GetGrantedObjects(*site)) {
+      base::DictValue device;
+      device.Set("kind", kind.name);
+      device.Set("key", context->GetKeyForObject(object->value));
+      device.Set("name", base::UTF16ToUTF8(context->GetObjectDisplayNameForUI(
+                             object->value)));
+      device.Set("changeable", object->source == SettingSource::kUser);
+      devices.Append(std::move(device));
+    }
+  }
+  document.Set("devices", std::move(devices));
+
+  // What the page uses now: Chrome's tab indicators (capture) and the
+  // WebContents' device capabilities.
+  base::ListValue in_use;
+  MediaStreamCaptureIndicator* indicator =
+      MediaCaptureDevicesDispatcher::GetInstance()
+          ->GetMediaStreamCaptureIndicator()
+          .get();
+  if (indicator->IsCapturingVideo(contents)) {
+    in_use.Append("camera");
+  }
+  if (indicator->IsCapturingAudio(contents)) {
+    in_use.Append("microphone");
+  }
+  if (indicator->IsCapturingTab(contents) ||
+      indicator->IsCapturingWindow(contents) ||
+      indicator->IsCapturingDisplay(contents)) {
+    in_use.Append("screen");
+  }
+  using Capability = content::WebContentsCapabilityType;
+  if (contents->IsCapabilityActive(Capability::kGeolocation)) {
+    in_use.Append("location");
+  }
+  if (contents->IsCapabilityActive(Capability::kBluetoothConnected) ||
+      contents->IsCapabilityActive(Capability::kBluetoothScanning)) {
+    in_use.Append("bluetooth");
+  }
+  if (contents->IsCapabilityActive(Capability::kUSB)) {
+    in_use.Append("usb");
+  }
+  if (contents->IsCapabilityActive(Capability::kHID)) {
+    in_use.Append("hid");
+  }
+  if (contents->IsCapabilityActive(Capability::kSerial)) {
+    in_use.Append("serial");
+  }
+  document.Set("in_use", std::move(in_use));
+  return base::WriteJson(document).value_or("{}");
+}
+
+bool IsWatchedType(ContentSettingsTypeSet types) {
+  if (types.ContainsAllTypes()) {
+    return true;
+  }
+  const ContentSettingsType changed = types.GetType();
+  if (changed == ContentSettingsType::PERMISSION_AUTOBLOCKER_DATA) {
+    return true;
+  }
+  for (ContentSettingsType type : kTypes) {
+    if (type == changed) {
+      return true;
+    }
+  }
+  for (const DeviceKind& kind : kDeviceKinds) {
+    if (kind.data_type == changed) {
+      return true;
+    }
+  }
+  return false;
+}
+
+// Tells the host that a tab's answer changed: a setting of the profile that
+// applies to the tab's site, or a device capability the page started or
+// stopped using. Camera, microphone and screen capture have their own channel
+// (media_capture, ABI 1.46); the host asks again on those events too.
+class SiteWatch : public content::WebContentsUserData<SiteWatch>,
+                  public content::WebContentsObserver,
+                  public content_settings::Observer {
+ public:
+  ~SiteWatch() override = default;
+
+  void Notify() {
+    if (pending_ || !host) {
+      return;
+    }
+    pending_ = true;
+    ABIPost(base::BindOnce(&SiteWatch::Deliver, weak_.GetWeakPtr(), epoch));
+  }
+
+  // content::WebContentsObserver:
+  void OnCapabilityTypesChanged(content::WebContentsCapabilityType,
+                                bool) override {
+    Notify();
+  }
+
+  // content_settings::Observer:
+  void OnContentSettingChanged(const ContentSettingsPattern& primary_pattern,
+                               const ContentSettingsPattern& secondary_pattern,
+                               ContentSettingsTypeSet types) override {
+    if (!IsWatchedType(types)) {
+      return;
+    }
+    std::optional<url::Origin> site = SiteOf(&GetWebContents());
+    if (!site) {
+      return;
+    }
+    // An invalid pattern stands for "several rules changed".
+    if (!primary_pattern.IsValid() || primary_pattern.Matches(site->GetURL())) {
+      Notify();
+    }
+  }
+
+ private:
+  friend class content::WebContentsUserData<SiteWatch>;
+  SiteWatch(content::WebContents* contents, uint64_t tab_id)
+      : content::WebContentsUserData<SiteWatch>(*contents),
+        content::WebContentsObserver(contents),
+        tab_id_(tab_id) {
+    settings_.Observe(HostContentSettingsMapFactory::GetForProfile(
+        Profile::FromBrowserContext(contents->GetBrowserContext())));
+  }
+
+  // Nothing after tab.closed: the watch is gone with the tab's contents.
+  static void Deliver(base::WeakPtr<SiteWatch> watch, uint64_t expected) {
+    if (!watch) {
+      return;
+    }
+    watch->pending_ = false;
+    if (host && expected == epoch) {
+      host(host_context, watch->tab_id_);
+    }
+  }
+
+  const uint64_t tab_id_;
+  bool pending_ = false;
+  base::ScopedObservation<HostContentSettingsMap, content_settings::Observer>
+      settings_{this};
+  base::WeakPtrFactory<SiteWatch> weak_{this};
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+};
+WEB_CONTENTS_USER_DATA_KEY_IMPL(SiteWatch);
+
+// The tab's site, when `origin` still names it. The host shows a panel for
+// the site it asked about; a page that has gone elsewhere since must not have
+// its new site changed by a click meant for the old one.
+ReArcStatus CheckSite(TabSession& session,
+                      const char* origin,
+                      url::Origin* site) {
+  if (!origin) {
+    return REARC_INVALID_ARGUMENT;
+  }
+  std::optional<url::Origin> current = SiteOf(session.web_contents());
+  if (!current) {
+    return REARC_UNSUPPORTED;
+  }
+  if (current->Serialize() != origin) {
+    return REARC_INVALID_STATE;
+  }
+  *site = *current;
+  return REARC_OK;
+}
+
+void DeliverDescription(ReArcSitePermissionsCallback completion,
+                        void* context,
+                        uint64_t tab_id,
+                        std::string json) {
+  completion(context, REARC_OK, tab_id, json.c_str());
+}
