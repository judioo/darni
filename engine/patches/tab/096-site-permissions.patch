+void ABIAttachSitePermissions(uint64_t tab_id) {
+  CHECK(pthread_main_np());
+  TabSession* session = TabRegistry::Get().FindSession(tab_id);
+  if (!session || !session->web_contents() ||
+      SiteWatch::FromWebContents(session->web_contents())) {
+    return;
+  }
+  SiteWatch::CreateForWebContents(session->web_contents(), tab_id);
+}
+
+void ABIDetachSitePermissions(uint64_t tab_id) {
+  CHECK(pthread_main_np());
+  TabSession* session = TabRegistry::Get().FindSession(tab_id);
+  if (session && session->web_contents()) {
+    session->web_contents()->RemoveUserData(SiteWatch::UserDataKey());
+  }
+}
