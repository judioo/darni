+}  // namespace rearc
+
+ReArcStatus ReArcTabGetSitePermissions(uint64_t tab_id,
+                                       ReArcSitePermissionsCallback completion,
+                                       void* context) {
+  rearc::TabSession* session;
+  if (auto status = rearc::ABICheckTab(tab_id, &session)) {
+    return status;
+  }
+  if (!completion) {
+    return REARC_INVALID_ARGUMENT;
+  }
+  if (!session->web_contents()) {
+    return REARC_INVALID_STATE;
+  }
+  rearc::ABIPost(base::BindOnce(&rearc::DeliverDescription, completion, context,
+                                tab_id, rearc::Describe(*session)));
+  return REARC_OK;
+}
+
+ReArcStatus ReArcTabSetSitePermission(uint64_t tab_id,
+                                      const char* origin,
+                                      const char* type_name,
+                                      uint32_t setting) {
+  rearc::TabSession* session;
+  if (auto status = rearc::ABICheckTab(tab_id, &session)) {
+    return status;
+  }
+  if (!type_name || setting > 2) {
+    return REARC_INVALID_ARGUMENT;
+  }
+  url::Origin site;
+  if (auto status = rearc::CheckSite(*session, origin, &site)) {
+    return status;
+  }
+  std::optional<ContentSettingsType> type = rearc::TypeNamed(type_name);
+  if (!type) {
+    return REARC_INVALID_ARGUMENT;
+  }
+  const content_settings::PermissionSettingsInfo* info = rearc::InfoFor(*type);
+  Profile* profile = Profile::FromBrowserContext(
+      session->web_contents()->GetBrowserContext());
+  HostContentSettingsMap* map =
+      HostContentSettingsMapFactory::GetForProfile(profile);
+  const GURL url = site.GetURL();
+
+  // Policy and extensions decide before the person does (page info shows such
+  // a row without a control).
+  content_settings::SettingInfo rule;
+  map->GetPermissionSetting(url, url, *type, &rule);
+  if (rule.source != content_settings::SettingSource::kUser) {
+    return REARC_INVALID_STATE;
+  }
+  std::optional<PermissionSetting> next;
+  if (setting != 0) {
+    next = rearc::MakeSetting(*info, setting == 1);
+    if (!info->delegate().IsValid(*next)) {
+      return REARC_UNSUPPORTED;
+    }
+  }
+  if (!map->CanSetNarrowestContentSetting(url, url, *type)) {
+    return REARC_UNSUPPORTED;
+  }
+  // An embargo blocks without a rule: anything but "block" lifts it, as page
+  // info does.
+  if (!next || !info->delegate().IsBlocked(*next)) {
+    if (auto* blocker =
+            PermissionDecisionAutoBlockerFactory::GetForProfile(profile)) {
+      blocker->RemoveEmbargoAndResetCounts(url, *type);
+    }
+  }
+  map->SetNarrowestContentSetting(url, url, *type, next);
+  return REARC_OK;
+}
+
+ReArcStatus ReArcTabRevokeSiteDevice(uint64_t tab_id,
+                                     const char* origin,
+                                     const char* kind_name,
+                                     const char* key) {
+  rearc::TabSession* session;
+  if (auto status = rearc::ABICheckTab(tab_id, &session)) {
+    return status;
+  }
+  if (!kind_name || !key) {
+    return REARC_INVALID_ARGUMENT;
+  }
+  url::Origin site;
+  if (auto status = rearc::CheckSite(*session, origin, &site)) {
+    return status;
+  }
+  const rearc::DeviceKind* kind = nullptr;
+  for (const rearc::DeviceKind& candidate : rearc::kDeviceKinds) {
+    if (std::string_view(candidate.name) == kind_name) {
+      kind = &candidate;
+    }
+  }
+  if (!kind) {
+    return REARC_INVALID_ARGUMENT;
+  }
+  permissions::ObjectPermissionContextBase* context = rearc::DeviceContext(
+      Profile::FromBrowserContext(session->web_contents()->GetBrowserContext()),
+      kind->data_type);
+  if (!context) {
+    return REARC_UNSUPPORTED;
+  }
+  for (const auto& object : context->GetGrantedObjects(site)) {
+    if (context->GetKeyForObject(object->value) != key) {
+      continue;
+    }
+    if (object->source != content_settings::SettingSource::kUser) {
+      return REARC_INVALID_STATE;
+    }
+    context->RevokeObjectPermission(site, object->value);
+    // A grant kept in memory only (a device without a serial number) changes
+    // no setting, so the watch would not hear of it.
+    if (auto* watch =
+            rearc::SiteWatch::FromWebContents(session->web_contents())) {
+      watch->Notify();
+    }
+    return REARC_OK;
+  }
+  return REARC_NOT_FOUND;
+}
+
+void ReArcEngineSetSitePermissionsChangedCallback(
+    ReArcSitePermissionsChangedCallback callback,
+    void* context) {
+  CHECK(pthread_main_np());
+  ++rearc::epoch;
+  rearc::host = callback;
+  rearc::host_context = context;
+}
