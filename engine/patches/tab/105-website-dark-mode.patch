+
+namespace content {
+class WebContents;
+}  // namespace content
+
+namespace rearc {
+
+// Dark mode for websites (ABI 1.73, tab/105). Whether the page of `contents`
+// is dark by what the host said for its profile
+// (ReArcProfileSetWebsiteDarkMode): a bridge tab whose main frame is on an
+// http or https address, by that address's host. False for everything else,
+// and always in an engine no host has said anything to. ChromeContentBrowserClient
+// reads it when it works out a tab's web preferences. UI thread.
+bool WebsiteDarkModeApplies(content::WebContents* contents);
+
+}  // namespace rearc
