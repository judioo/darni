new file mode 100644
index 0000000..ef9042f
--- /dev/null
+++ b/chrome/browser/rearc_bridge/rearc_website_dark_mode.cc
@@ -0,0 +1,204 @@
+// Copyright 2026 The ReArc Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Dark mode for websites (website_dark_mode, ABI 1.73, tab/105). The host
+// tells the engine, per profile, whether pages are dark and which hosts
+// differ. ChromeContentBrowserClient asks WebsiteDarkModeApplies for a tab's
+// page when it works out the tab's web preferences: at first use, at every
+// main frame navigation (OverrideWebPreferencesAfterNavigation) and when the
+// host says something new (WebContents::OnWebPreferencesChanged, below). A
+// dark page gets preferred_color_scheme dark and force_dark_mode_enabled, and
+// Blink does the rest. Nothing is written: the state lives with the Profile
+// object and the host says it again at the next profile load.
+
+#include "chrome/browser/rearc_bridge/rearc_website_dark_mode.h"
+
+#include <pthread.h>
+
+#include <algorithm>
+#include <cstddef>
+#include <functional>
+#include <memory>
+#include <optional>
+#include <set>
+#include <string>
+#include <string_view>
+#include <utility>
+
+#include "base/check.h"
+#include "base/json/json_reader.h"
+#include "base/strings/string_util.h"
+#include "base/supports_user_data.h"
+#include "base/values.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/rearc_bridge/browserless_tab_helpers.h"
+#include "chrome/browser/rearc_bridge/rearc_abi_internal.h"
+#include "chrome/browser/rearc_bridge/rearc_engine_abi.h"
+#include "chrome/browser/rearc_bridge/rearc_profile_registry.h"
+#include "chrome/browser/rearc_bridge/tab_registry.h"
+#include "chrome/browser/rearc_bridge/tab_session.h"
+#include "content/public/browser/render_frame_host.h"
+#include "content/public/browser/web_contents.h"
+#include "third_party/blink/public/common/web_preferences/web_preferences.h"
+#include "third_party/blink/public/mojom/css/preferred_color_scheme.mojom.h"
+#include "url/gurl.h"
+
+namespace rearc {
+namespace {
+
+constexpr size_t kMaxHosts = 10000;
+// 10,000 hosts of 253 characters, quoted and separated, fit in 4 MB.
+constexpr size_t kMaxArgumentBytes = 4 * 1024 * 1024;
+
+using HostSet = std::set<std::string, std::less<>>;
+
+// What the host said for one profile. It hangs on the original Profile, so
+// it goes when the profile does, and the profile's private windows read it.
+struct DarkModeState : public base::SupportsUserData::Data {
+  bool dark = false;
+  HostSet dark_hosts;
+  HostSet light_hosts;
+};
+
+const char kStateKey[] = "rearc.website_dark_mode";
+
+const DarkModeState* StateOf(content::WebContents* contents) {
+  Profile* profile = Profile::FromBrowserContext(contents->GetBrowserContext());
+  if (!profile) {
+    return nullptr;
+  }
+  return static_cast<const DarkModeState*>(
+      profile->GetOriginalProfile()->GetUserData(kStateKey));
+}
+
+// A URL's host as GURL writes it: lower-case letters, digits, "-", ".", "_",
+// and the brackets and colons of an IPv6 literal.
+bool IsHost(std::string_view host) {
+  return !host.empty() && host.size() <= 253 &&
+         std::ranges::all_of(host, [](char c) {
+           return base::IsAsciiLower(c) || base::IsAsciiDigit(c) || c == '-' ||
+                  c == '.' || c == '_' || c == '[' || c == ']' || c == ':';
+         });
+}
+
+// A JSON array of hosts; null is the empty one. nullopt when it is not such
+// an array or is too long.
+std::optional<HostSet> ReadHosts(const char* json) {
+  HostSet hosts;
+  if (!json) {
+    return hosts;
+  }
+  const std::string_view text(json);
+  if (text.size() > kMaxArgumentBytes) {
+    return std::nullopt;
+  }
+  std::optional<base::ListValue> list =
+      base::JSONReader::ReadList(text, base::JSON_PARSE_RFC);
+  if (!list || list->size() > kMaxHosts) {
+    return std::nullopt;
+  }
+  for (const base::Value& value : *list) {
+    if (!value.is_string() || !IsHost(value.GetString())) {
+      return std::nullopt;
+    }
+    hosts.insert(value.GetString());
+  }
+  return hosts;
+}
+
+}  // namespace
+
+bool WebsiteDarkModeApplies(content::WebContents* contents) {
+  CHECK(pthread_main_np());
+  if (!contents) {
+    return false;
+  }
+  const DarkModeState* state = StateOf(contents);
+  // Nothing said, or nothing dark: the answer for every page, and the only
+  // work an engine does whose host never calls this.
+  if (!state || (!state->dark && state->dark_hosts.empty())) {
+    return false;
+  }
+  // Tabs only: not a DevTools frontend, an extension's popup or side panel,
+  // or any other contents the engine makes for itself.
+  if (!IsBrowserlessTabContents(contents)) {
+    return false;
+  }
+  const GURL& url = contents->GetPrimaryMainFrame()->GetLastCommittedURL();
+  if (!url.SchemeIsHTTPOrHTTPS()) {
+    return false;
+  }
+  const std::string_view host = url.host();
+  if (state->light_hosts.contains(host)) {
+    return false;
+  }
+  return state->dark || state->dark_hosts.contains(host);
+}
+
+}  // namespace rearc
+
+ReArcStatus ReArcProfileSetWebsiteDarkMode(uint64_t profile_id,
+                                           bool dark,
+                                           const char* dark_hosts_json,
+                                           const char* light_hosts_json) {
+  CHECK(pthread_main_np());
+  Profile* profile = rearc::FindBridgeProfile(profile_id);
+  if (!profile) {
+    return REARC_PROFILE_NOT_FOUND;
+  }
+  if (profile->IsOffTheRecord()) {
+    return REARC_INVALID_ARGUMENT;
+  }
+  std::optional<rearc::HostSet> dark_hosts = rearc::ReadHosts(dark_hosts_json);
+  std::optional<rearc::HostSet> light_hosts =
+      rearc::ReadHosts(light_hosts_json);
+  if (!dark_hosts || !light_hosts) {
+    return REARC_INVALID_ARGUMENT;
+  }
+  for (const std::string& host : *dark_hosts) {
+    if (light_hosts->contains(host)) {
+      return REARC_INVALID_ARGUMENT;
+    }
+  }
+  auto state = std::make_unique<rearc::DarkModeState>();
+  state->dark = dark;
+  state->dark_hosts = std::move(*dark_hosts);
+  state->light_hosts = std::move(*light_hosts);
+  profile->SetUserData(rearc::kStateKey, std::move(state));
+
+  // Open tabs follow now, without a reload: each works its web preferences
+  // out again and sends its renderers what changed. The profile's private
+  // windows too.
+  auto& registry = rearc::TabRegistry::Get();
+  for (uint64_t id : registry.SessionIds()) {
+    rearc::TabSession* session = registry.FindSession(id);
+    content::WebContents* contents =
+        session ? session->web_contents() : nullptr;
+    if (!contents || contents->IsBeingDestroyed()) {
+      continue;
+    }
+    Profile* owner = Profile::FromBrowserContext(contents->GetBrowserContext());
+    if (owner && owner->GetOriginalProfile() == profile) {
+      contents->OnWebPreferencesChanged();
+    }
+  }
+  return REARC_OK;
+}
+
+ReArcStatus ReArcTabGetWebsiteDarkMode(uint64_t tab_id, bool* dark) {
+  CHECK(pthread_main_np());
+  if (!dark) {
+    return REARC_INVALID_ARGUMENT;
+  }
+  rearc::TabSession* session = nullptr;
+  if (auto status = rearc::ABICheckTab(tab_id, &session)) {
+    return status;
+  }
+  const blink::web_pref::WebPreferences& prefs =
+      session->web_contents()->GetOrCreateWebPreferences();
+  *dark = prefs.force_dark_mode_enabled &&
+          prefs.preferred_color_scheme ==
+              blink::mojom::PreferredColorScheme::kDark;
+  return REARC_OK;
+}
