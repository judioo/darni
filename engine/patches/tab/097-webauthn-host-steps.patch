+}
+
+// The ABI's names of the steps. They are the host's vocabulary and stay when
+// a pin bump renumbers or renames Chromium's enum. A step without UI of its
+// own is "hidden"; one that needs Google Password Manager or Windows is
+// "unsupported", and the host offers another way or Cancel.
+const char* StepName(Step step) {
+  switch (step) {
+    case Step::kMechanismSelection:
+      return "choose";
+    case Step::kSelectPriorityMechanism:
+      return "confirm";
+    case Step::kUsbInsertAndActivate:
+      return "security_key";
+    case Step::kCableV2QRCode:
+      return "qr";
+    case Step::kCableV2Connecting:
+      return "phone_connecting";
+    case Step::kCableV2Connected:
+      return "phone_connected";
+    case Step::kCableV2Error:
+      return "phone_error";
+    case Step::kBlePowerOnAutomatic:
+    case Step::kBlePowerOnManual:
+      return "bluetooth_off";
+    case Step::kBlePermissionMac:
+      return "bluetooth_denied";
+    case Step::kOffTheRecordInterstitial:
+      return "private_notice";
+    case Step::kClientPinEntry:
+      return "pin";
+    case Step::kClientPinSetup:
+      return "pin_setup";
+    case Step::kClientPinChange:
+      return "pin_change";
+    case Step::kClientPinTapAgain:
+      return "touch_again";
+    case Step::kClientPinErrorSoftBlock:
+      return "error_pin_soft_block";
+    case Step::kClientPinErrorHardBlock:
+      return "error_pin_hard_block";
+    case Step::kClientPinErrorAuthenticatorRemoved:
+      return "error_key_removed";
+    case Step::kInlineBioEnrollment:
+      return "fingerprint_enroll";
+    case Step::kRetryInternalUserVerification:
+      return "verify_again";
+    case Step::kSelectAccount:
+    case Step::kPreSelectAccount:
+      return "account";
+    case Step::kChromeProfileCreatePasskey:
+      return "create_this_mac";
+    case Step::kErrorNoAvailableTransports:
+      return "error_no_transports";
+    case Step::kErrorNoPasskeys:
+      return "error_no_passkeys";
+    case Step::kErrorInternalUnrecognized:
+      return "error_not_recognized";
+    case Step::kTimedOut:
+      return "error_timeout";
+    case Step::kKeyNotRegistered:
+      return "error_key_not_registered";
+    case Step::kKeyAlreadyRegistered:
+      return "error_key_already_registered";
+    case Step::kMissingCapability:
+      return "error_missing_capability";
+    case Step::kStorageFull:
+      return "error_storage_full";
+    case Step::kPlatformAuthenticator:
+      // macOS shows its own prompt (Touch ID, or iCloud Keychain's sheet).
+      return "system";
+    case Step::kNotStarted:
+    case Step::kPasskeyAutofill:
+    case Step::kPasskeyUpgrade:
+    case Step::kPasswordOsAuth:
+    case Step::kClosed:
+      return "hidden";
+    default:
+      return "unsupported";
+  }
+}
+
+const char* SourceName(device::AuthenticatorType type) {
+  switch (type) {
+    case device::AuthenticatorType::kTouchID:
+      return "this_mac";
+    case device::AuthenticatorType::kICloudKeychain:
+      return "icloud_keychain";
+    case device::AuthenticatorType::kPhone:
+      return "phone";
+    case device::AuthenticatorType::kEnclave:
+      return "google";
+    case device::AuthenticatorType::kOther:
+      return "security_key";
+    default:
+      return "other";
+  }
+}
+
+const char* TransportName(device::FidoTransportProtocol transport) {
+  switch (transport) {
+    case device::FidoTransportProtocol::kUsbHumanInterfaceDevice:
+      return "security_key";
+    case device::FidoTransportProtocol::kInternal:
+      return "this_mac";
+    case device::FidoTransportProtocol::kHybrid:
+      return "phone";
+    default:
+      return "other";
+  }
+}
+
+// "kind" says what a way to sign in is, so the host can draw and name it;
+// "name" and "description" are Chromium's own strings for it.
+base::DictValue DescribeMechanism(const Mechanism& mechanism, size_t index) {
+  base::DictValue row;
+  row.Set("index", static_cast<int>(index));
+  row.Set("name", base::UTF16ToUTF8(mechanism.name));
+  row.Set("description", base::UTF16ToUTF8(mechanism.description));
+  std::visit(
+      absl::Overload{
+          [&row](const Mechanism::Credential& credential) {
+            row.Set("kind", "passkey");
+            row.Set("source", SourceName(credential.value().source));
+          },
+          [&row](const Mechanism::Password&) { row.Set("kind", "password"); },
+          [&row](const Mechanism::Transport& transport) {
+            row.Set("kind", TransportName(transport.value()));
+          },
+          [&row](const Mechanism::WindowsAPI&) { row.Set("kind", "other"); },
+          [&row](const Mechanism::Hybrid&) { row.Set("kind", "phone"); },
+          [&row](const Mechanism::ICloudKeychain&) {
+            row.Set("kind", "icloud_keychain");
+          },
+          [&row](const Mechanism::Enclave&) { row.Set("kind", "google"); },
+          [&row](const Mechanism::SignInAgain&) { row.Set("kind", "other"); },
+      },
+      mechanism.type);
+  return row;
+}
+
+const char* PinErrorName(device::pin::PINEntryError error) {
+  switch (error) {
+    case device::pin::PINEntryError::kNoError:
+      return "none";
+    case device::pin::PINEntryError::kInternalUvLocked:
+      return "fingerprint_locked";
+    case device::pin::PINEntryError::kWrongPIN:
+      return "wrong";
+    case device::pin::PINEntryError::kTooShort:
+      return "too_short";
+    case device::pin::PINEntryError::kInvalidCharacters:
+      return "invalid_characters";
+    case device::pin::PINEntryError::kSameAsCurrentPIN:
+      return "same_as_current";
+  }
+  return "none";
+}
+
+// The steps that say a request failed. Chromium's sheets offer "try again"
+// there only while the model's offer_try_again_in_ui holds, and never after a
+// timeout.
+bool IsErrorStep(Step step) {
+  switch (step) {
+    case Step::kCableV2Error:
+    case Step::kClientPinErrorSoftBlock:
+    case Step::kClientPinErrorHardBlock:
+    case Step::kClientPinErrorAuthenticatorRemoved:
+    case Step::kErrorNoAvailableTransports:
+    case Step::kErrorNoPasskeys:
+    case Step::kErrorInternalUnrecognized:
+    case Step::kTimedOut:
+    case Step::kKeyNotRegistered:
+    case Step::kKeyAlreadyRegistered:
+    case Step::kMissingCapability:
+    case Step::kStorageFull:
+      return true;
+    default:
+      return false;
+  }
+}
+
+// What touching a security key tells the site, as Chromium's sheets warn on
+// the touch steps (sheet_models.cc, PossibleAttestationWarning): its make and
+// model, or with enterprise attestation its serial number.
+const char* AttestationName(const Model& model) {
+  if (!model.attestation_conveyance_preference) {
+    return "none";
+  }
+  switch (*model.attestation_conveyance_preference) {
+    case device::AttestationConveyancePreference::kNone:
+      return "none";
+    case device::AttestationConveyancePreference::kIndirect:
+    case device::AttestationConveyancePreference::kDirect:
+      return "model";
+    case device::AttestationConveyancePreference::
+        kEnterpriseIfRPListedOnAuthenticator:
+    case device::AttestationConveyancePreference::kEnterpriseApprovedByBrowser:
+      return "serial";
+  }
+  return "none";
+}
+
+// Whether a record of the visit is kept on the security key (sheet_models.cc,
+// PossibleResidentKeyWarning).
+const char* StoredOnKeyName(const Model& model) {
+  switch (model.resident_key_requirement) {
+    case device::ResidentKeyRequirement::kDiscouraged:
+      return "no";
+    case device::ResidentKeyRequirement::kPreferred:
+      return "maybe";
+    case device::ResidentKeyRequirement::kRequired:
+      return "yes";
+  }
+  return "no";
+}
+
+void Deliver(uint64_t expected,
+             uint64_t request_id,
+             uint64_t tab_id,
+             uint32_t phase,
+             std::string json) {
+  if (!host || expected != epoch) {
+    return;
+  }
+  host(host_context, request_id, tab_id, phase, json.c_str());
+}
+
+const char* VisibilityName(content::Visibility visibility) {
+  switch (visibility) {
+    case content::Visibility::VISIBLE:
+      return "visible";
+    case content::Visibility::OCCLUDED:
+      return "occluded";
+    case content::Visibility::HIDDEN:
+      return "hidden";
+  }
+  return "hidden";
+}
+
+TabSession* SessionOf(content::WebContents* contents) {
+  if (!contents) {
+    return nullptr;
+  }
+  for (uint64_t id : TabRegistry::Get().SessionIds()) {
+    TabSession* session = TabRegistry::Get().FindSession(id);
+    if (session && session->web_contents() == contents) {
+      return session;
+    }
+  }
+  return nullptr;
+}
+
+// A request refused because nobody sees its page: the host hears of it, to
+// write it to its log. No address in it: the host's log is open to whoever
+// started the app.
+void NoteRefused(uint64_t request_id,
+                 uint64_t tab_id,
+                 const char* at,
+                 const char* visibility,
+                 const char* request,
+                 const char* step) {
+  base::DictValue document;
+  document.Set("refused", "not_visible");
+  document.Set("at", at);
+  document.Set("visibility", visibility);
+  if (request) {
+    document.Set("request", request);
+  }
+  if (step) {
+    document.Set("step", step);
+  }
+  ABIPost(base::BindOnce(&Deliver, epoch, request_id, tab_id, 1u,
+                         base::WriteJson(document).value_or("{}")));
+}
+
+// One request's steps for the host. It lives as long as the request's dialog
+// model and holds no reference to it: the model says when it goes.
+class Prompt : public Model::Observer {
+ public:
+  Prompt(Model* model, content::RenderFrameHost* frame)
+      : model_(model), id_(next_id++) {
+    if (TabSession* session =
+            SessionOf(content::WebContents::FromRenderFrameHost(frame))) {
+      tab_id_ = session->tab_id();
+      profile_id_ = session->profile_id();
+      generation_ = session->content_generation();
+    }
+    const url::Origin& origin = frame->GetLastCommittedOrigin();
+    origin_ = origin.Serialize();
+    // Only a web page gets the host's sheet. An extension page may claim any
+    // site it has host access to as the relying party
+    // (ExtensionCanAssertRpId), and the sheet names the relying party, not
+    // who asks: such a request is cancelled when it reaches a step with UI,
+    // as one from a page that is no tab.
+    if (origin.scheme() != url::kHttpScheme &&
+        origin.scheme() != url::kHttpsScheme) {
+      tab_id_ = 0;
+    }
+    model_->AddObserver(this);
+    Prompts().emplace(id_, this);
+  }
+  ~Prompt() override = default;
+
+  uint64_t tab_id() const { return tab_id_; }
+  bool shown() const { return shown_ && !ended_; }
+
+  // Model::Observer:
+  void OnStepTransition() override {
+    // A new step has its own one-time callbacks.
+    spent_ = false;
+    Publish();
+  }
+  void OnSheetModelChanged() override { Publish(); }
+  void OnBluetoothPoweredStateChanged() override { Publish(); }
+  void OnModelDestroyed(Model* model) override {
+    End();
+    model->RemoveObserver(this);
+    model_ = nullptr;
+    Prompts().erase(id_);
+    // The model is going through its observers: this one goes afterwards.
+    base::SequencedTaskRunner::GetCurrentDefault()->DeleteSoon(FROM_HERE, this);
+  }
+
+  // The tab is going: its page hears nothing more of this request.
+  void Detach() {
+    End();
+    tab_id_ = 0;
+  }
+
+  // Cancel as the dialog's Cancel button does. This can end the request and
+  // with it this object, so nothing may follow the call.
+  void Cancel() {
+    if (model_) {
+      model_->CancelAuthenticatorRequest();
+    }
+  }
+
+  ReArcStatus Respond(uint32_t action, uint32_t index, const char* text) {
+    if (!model_ || !shown()) {
+      return REARC_INVALID_STATE;
+    }
+    Model* model = model_;
+    const Step step = model->step();
+    // Every call into the model below can end the request and delete this
+    // object: none is followed by a use of a member.
+    if (action == 0) {
+      // Cancel answers at every step, also while macOS shows its own prompt.
+      model->CancelAuthenticatorRequest();
+      return REARC_OK;
+    }
+    if (action > 5) {
+      return REARC_INVALID_ARGUMENT;
+    }
+    if (model->should_dialog_be_closed()) {
+      return REARC_INVALID_STATE;
+    }
+    // While the engine works, Chromium's own buttons are disabled but Cancel;
+    // and a published step takes one answer: the next one is for the step
+    // that follows it.
+    if (model->ui_disabled_ || answered_) {
+      return REARC_INVALID_STATE;
+    }
+    switch (action) {
+      case 1:
+        // The list is on these two steps only (the second shows the first
+        // choice with "another way").
+        if (step != Step::kMechanismSelection &&
+            step != Step::kSelectPriorityMechanism) {
+          return REARC_INVALID_STATE;
+        }
+        if (index >= model->mechanisms.size()) {
+          return REARC_INVALID_ARGUMENT;
+        }
+        answered_ = true;
+        // A copy: the callback rebuilds the list it is stored in.
+        base::RepeatingClosure(model->mechanisms[index].callback).Run();
+        return REARC_OK;
+      case 2:
+        return Continue(model, step);
+      case 3: {
+        if (step != Step::kClientPinEntry && step != Step::kClientPinSetup &&
+            step != Step::kClientPinChange) {
+          return REARC_INVALID_STATE;
+        }
+        // CTAP: a PIN is at most 63 bytes of UTF-8.
+        const std::string pin(text ? text : "");
+        if (pin.empty() || pin.size() > 63 || !base::IsStringUTF8(pin)) {
+          return REARC_INVALID_ARGUMENT;
+        }
+        answered_ = true;
+        model->OnHavePIN(base::UTF8ToUTF16(pin));
+        return REARC_OK;
+      }
+      case 4:
+        if (step != Step::kSelectAccount && step != Step::kPreSelectAccount) {
+          return REARC_INVALID_STATE;
+        }
+        if (index >= model->creds.size()) {
+          return REARC_INVALID_ARGUMENT;
+        }
+        answered_ = true;
+        if (step == Step::kSelectAccount) {
+          model->OnAccountSelected(index);
+        } else {
+          model->OnAccountPreselectedIndex(index);
+        }
+        return REARC_OK;
+      case 5:
+        // The request is over once it timed out: Chromium's sheet has only
+        // Close there. Its other error sheets offer "try again" only while
+        // the model says so.
+        if (step == Step::kTimedOut ||
+            (IsErrorStep(step) && !model->offer_try_again_in_ui)) {
+          return REARC_INVALID_STATE;
+        }
+        answered_ = true;
+        model->StartOver();
+        return REARC_OK;
+      default:
+        return REARC_INVALID_ARGUMENT;
+    }
+  }
+
+ private:
+  // The sheet's accept button, step by step (chrome/browser/ui/webauthn/
+  // sheet_models.cc, the OnAccept of each sheet).
+  // The flags are set before the call into the model, which can end the
+  // request and delete this object.
+  ReArcStatus Continue(Model* model, Step step) {
+    switch (step) {
+      case Step::kSelectPriorityMechanism:
+        if (!model->priority_mechanism_index ||
+            *model->priority_mechanism_index >= model->mechanisms.size()) {
+          return REARC_INVALID_STATE;
+        }
+        answered_ = true;
+        model->OnUserConfirmedPriorityMechanism();
+        return REARC_OK;
+      case Step::kBlePowerOnManual:
+        // The controller runs a one-time callback here without a null check.
+        if (!model->ble_adapter_is_powered || spent_) {
+          return REARC_INVALID_STATE;
+        }
+        answered_ = true;
+        spent_ = true;
+        model->ContinueWithFlowAfterBleAdapterPowered();
+        return REARC_OK;
+      case Step::kBlePowerOnAutomatic:
+        answered_ = true;
+        model->PowerOnBleAdapter();
+        return REARC_OK;
+      case Step::kBlePermissionMac:
+        // System Settings > Privacy & Security > Bluetooth. It changes
+        // nothing in the request and may be asked for again.
+        model->OpenBlePreferences();
+        return REARC_OK;
+      case Step::kOffTheRecordInterstitial:
+        answered_ = true;
+        model->OnOffTheRecordInterstitialAccepted();
+        return REARC_OK;
+      case Step::kChromeProfileCreatePasskey:
+        answered_ = true;
+        model->OnChromeProfileCreatePasskeyAccepted();
+        return REARC_OK;
+      case Step::kInlineBioEnrollment:
+        // The controller runs a one-time callback here without a null check
+        // (authenticator_request_dialog_controller.cc, OnBioEnrollmentDone),
+        // and the step stays while the key finishes: a second Continue would
+        // be a CHECK failure. Spent until the step changes, whatever is
+        // published meanwhile.
+        if (spent_) {
+          return REARC_INVALID_STATE;
+        }
+        answered_ = true;
+        spent_ = true;
+        model->OnBioEnrollmentDone();
+        return REARC_OK;
+      default:
+        return REARC_INVALID_STATE;
+    }
+  }
+
+  void Publish() {
+    // The cancel of a request nobody sees is on its way: nothing goes out.
+    if (!model_ || refused_) {
+      return;
+    }
+    const Step step = model_->step();
+    if (step == Step::kClosed) {
+      End();
+      return;
+    }
+    const bool has_ui = !model_->should_dialog_be_closed();
+    // A request that never needed a dialog says nothing: a sign-in page's
+    // passkey autofill request runs on every load.
+    if (!has_ui && !shown_) {
+      return;
+    }
+    const content::Visibility visibility = PageVisibility();
+    const bool unseen =
+        !shown_ && visibility != content::Visibility::VISIBLE;
+    if (has_ui && (!host || !tab_id_ || unseen)) {
+      // No host UI, a page that is no tab, or a request that opens in a tab
+      // nobody looks at: cancel rather than wait for a dialog nobody can
+      // answer. Deferred: the model is in a transition.
+      if (host && tab_id_) {
+        // Nobody sees the page: said once, whatever the model publishes
+        // before the cancel runs.
+        refused_ = true;
+        NoteRefused(id_, tab_id_, "first_step", VisibilityName(visibility),
+                    RequestName(), StepName(step));
+      }
+      base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+          FROM_HERE, base::BindOnce(&Prompt::Cancel, weak_.GetWeakPtr()));
+      return;
+    }
+    if (!tab_id_) {
+      return;
+    }
+    shown_ = true;
+    // What goes out now is what the next answer is for.
+    answered_ = false;
+    ABIPost(base::BindOnce(&Deliver, epoch, id_, tab_id_, 0u, Describe(step)));
+  }
+
+  // Chromium's rule for creating a passkey (ChromeWebAuthenticationDelegate::
+  // IsFocused), which it does not apply to signing in: a hidden tab's request
+  // would stay open against a plugged-in key, and a touch meant for the tab
+  // in front could answer it. tab/097 asks the same of a sign-in when it
+  // starts (AuthenticatorCommonImpl::GetCredential); this is for a page that
+  // went out of sight between the start and the first step. A tab that has
+  // gone counts as hidden.
+  content::Visibility PageVisibility() const {
+    TabSession* session = TabRegistry::Get().FindSession(tab_id_);
+    return session && session->web_contents()
+               ? session->web_contents()->GetVisibility()
+               : content::Visibility::HIDDEN;
+  }
+
+  const char* RequestName() const {
+    return model_->request_type == device::FidoRequestType::kMakeCredential
+               ? "create"
+               : "get";
+  }
+
+  void End() {
+    if (!shown_ || ended_) {
+      return;
+    }
+    ended_ = true;
+    if (tab_id_) {
+      ABIPost(base::BindOnce(&Deliver, epoch, id_, tab_id_, 1u, "{}"));
+    }
+  }
+
+  std::string Describe(Step step) {
+    const Model& model = *model_;
+    base::DictValue document;
+    document.Set("step", StepName(step));
+    document.Set("request", RequestName());
+    // What the page's tab is as this step goes out: the first step of a
+    // request goes to a visible one only.
+    document.Set("visibility", VisibilityName(PageVisibility()));
+    document.Set("rp_id", model.relying_party_id);
+    document.Set("origin", origin_);
+    document.Set("profile_id", base::NumberToString(profile_id_));
+    document.Set("content_generation", base::NumberToString(generation_));
+    document.Set("private", model.is_off_the_record);
+    // The sheet waits for the engine: only Cancel answers.
+    document.Set("busy", model.ui_disabled_);
+    document.Set("can_choose_another", model.mechanisms.size() > 1);
+    document.Set("can_try_again", model.offer_try_again_in_ui);
+    // What a touch of a security key gives the site, for the host to say
+    // before the touch.
+    document.Set("attestation", AttestationName(model));
+    document.Set("stored_on_key", StoredOnKeyName(model));
+
+    if (step == Step::kMechanismSelection ||
+        step == Step::kSelectPriorityMechanism) {
+      base::ListValue mechanisms;
+      for (size_t i = 0; i < model.mechanisms.size(); ++i) {
+        mechanisms.Append(DescribeMechanism(model.mechanisms[i], i));
+      }
+      document.Set("mechanisms", std::move(mechanisms));
+      if (model.priority_mechanism_index &&
+          *model.priority_mechanism_index < model.mechanisms.size()) {
+        document.Set("priority",
+                     static_cast<int>(*model.priority_mechanism_index));
+      }
+    }
+    if (step == Step::kSelectAccount || step == Step::kPreSelectAccount) {
+      base::ListValue accounts;
+      for (size_t i = 0; i < model.creds.size(); ++i) {
+        const device::DiscoverableCredentialMetadata& cred = model.creds[i];
+        base::DictValue row;
+        row.Set("index", static_cast<int>(i));
+        row.Set("name", cred.user.name.value_or(std::string()));
+        row.Set("display_name", cred.user.display_name.value_or(std::string()));
+        row.Set("source", SourceName(cred.source));
+        accounts.Append(std::move(row));
+      }
+      document.Set("accounts", std::move(accounts));
+    }
+    if (step == Step::kCableV2QRCode && model.cable_qr_string) {
+      // What the phone's camera reads ("FIDO:/..."). The host draws it and
+      // keeps it out of logs.
+      document.Set("qr", *model.cable_qr_string);
+      document.Set("security_key_too", model.show_security_key_on_qr_sheet);
+    }
+    if (step == Step::kBlePowerOnAutomatic || step == Step::kBlePowerOnManual) {
+      document.Set("bluetooth_on", model.ble_adapter_is_powered);
+      document.Set("can_power_on", step == Step::kBlePowerOnAutomatic);
+    }
+    if (step == Step::kClientPinEntry || step == Step::kClientPinSetup ||
+        step == Step::kClientPinChange) {
+      base::DictValue pin;
+      pin.Set("min_length", static_cast<int>(model.min_pin_length));
+      pin.Set("error", PinErrorName(model.pin_error));
+      if (model.pin_attempts) {
+        pin.Set("attempts", *model.pin_attempts);
+      }
+      document.Set("pin", std::move(pin));
+    }
+    if (step == Step::kRetryInternalUserVerification && model.uv_attempts) {
+      document.Set("attempts", *model.uv_attempts);
+    }
+    if (step == Step::kInlineBioEnrollment) {
+      if (model.max_bio_samples) {
+        document.Set("samples", *model.max_bio_samples);
+      }
+      if (model.bio_samples_remaining) {
+        document.Set("samples_remaining", *model.bio_samples_remaining);
+      }
+    }
+    if (model.request_type == device::FidoRequestType::kMakeCredential) {
+      base::DictValue user;
+      user.Set("name", model.user_entity.name.value_or(std::string()));
+      user.Set("display_name",
+               model.user_entity.display_name.value_or(std::string()));
+      document.Set("user", std::move(user));
+    }
+    return base::WriteJson(document).value_or("{}");
+  }
+
+  raw_ptr<Model> model_;
+  const uint64_t id_;
+  uint64_t tab_id_ = 0, profile_id_ = 0, generation_ = 0;
+  std::string origin_;
+  // A step with UI went to the host; the end of the request does too.
+  bool shown_ = false;
+  bool ended_ = false;
+  // The step last published has its answer; the next publish clears it.
+  bool answered_ = false;
+  // This step's one-time callback has run; only a new step clears it.
+  bool spent_ = false;
+  // Its page was not visible at the first step with UI: cancelled, and the
+  // host was told.
+  bool refused_ = false;
+  base::WeakPtrFactory<Prompt> weak_{this};
+};
+
+}  // namespace
+
+void AttachWebAuthnPrompt(AuthenticatorRequestDialogModel* model,
+                          content::RenderFrameHost* frame) {
+  CHECK(pthread_main_np());
+  if (!model || !frame) {
+    return;
+  }
+  // Owned by the model's lifetime: Prompt::OnModelDestroyed deletes it.
+  new Prompt(model, frame);
+}
+
+void NoteWebAuthnRefusedNotVisible(content::WebContents* contents) {
+  CHECK(pthread_main_np());
+  if (!contents) {
+    return;
+  }
+  TabSession* session = SessionOf(contents);
+  // No request id: Chromium's check knows the page, not the request.
+  NoteRefused(0, session ? session->tab_id() : 0, "focus_check",
+              VisibilityName(contents->GetVisibility()), nullptr, nullptr);
+}
+
+void ABICancelWebAuthn(uint64_t tab_id) {
+  CHECK(pthread_main_np());
+  for (auto& [id, prompt] : Prompts()) {
+    if (prompt->tab_id() == tab_id) {
+      prompt->Detach();
+    }
+  }
+}
+
+std::string WebAuthnKeychainAccessGroup() {
+  static const base::NoDestructor<std::string> group([] {
+    std::string team = MAC_TEAM_IDENTIFIER_STRING;
+    if (team.empty()) {
+      base::apple::ScopedCFTypeRef<SecTaskRef> task(
+          SecTaskCreateFromSelf(nullptr));
+      if (task) {
+        base::apple::ScopedCFTypeRef<CFTypeRef> value(
+            SecTaskCopyValueForEntitlement(
+                task.get(), CFSTR("com.apple.developer.team-identifier"),
+                nullptr));
+        if (CFStringRef string =
+                base::apple::CFCast<CFStringRef>(value.get())) {
+          team = base::SysCFStringRefToUTF8(string);
+        }
+      }
+    }
+    return team + "." MAC_BUNDLE_IDENTIFIER_STRING ".webauthn";
+  }());
+  return *group;
+}
+
+}  // namespace rearc
+
+void ReArcEngineSetWebAuthnCallback(ReArcWebAuthnCallback callback,
+                                    void* context) {
+  CHECK(pthread_main_np());
+  // A host that goes takes its sheets with it: what it was asked is cancelled
+  // (a request that showed nothing goes on). Cancelling ends a prompt, so walk
+  // a copy of the ids.
+  std::vector<uint64_t> ids;
+  for (const auto& [id, prompt] : rearc::Prompts()) {
+    if (prompt->shown()) {
+      ids.push_back(id);
+    }
+  }
+  ++rearc::epoch;
+  rearc::host = callback;
+  rearc::host_context = context;
+  for (uint64_t id : ids) {
+    auto it = rearc::Prompts().find(id);
+    if (it != rearc::Prompts().end()) {
+      it->second->Cancel();
+    }
+  }
+}
+
+ReArcStatus ReArcWebAuthnRespond(uint64_t request_id,
+                                 uint32_t action,
+                                 uint32_t index,
+                                 const char* text) {
+  CHECK(pthread_main_np());
+  auto it = rearc::Prompts().find(request_id);
+  if (it == rearc::Prompts().end()) {
+    return REARC_NOT_FOUND;
+  }
+  return it->second->Respond(action, index, text);
+}
