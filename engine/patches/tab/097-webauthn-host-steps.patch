+#ifndef CHROME_BROWSER_REARC_BRIDGE_REARC_WEBAUTHN_H_
+#define CHROME_BROWSER_REARC_BRIDGE_REARC_WEBAUTHN_H_
+
+#include <string>
+
+struct AuthenticatorRequestDialogModel;
+
+namespace content {
+class RenderFrameHost;
+class WebContents;
+}
+
+namespace rearc {
+
+// WebAuthn (webauthn_prompts, ABI 1.68). Chromium shows a request's steps
+// (which passkey, the QR code for a phone, a security key's PIN, errors) in a
+// Views dialog on the tab's WebContentsModalDialogManager. A bridge tab has
+// none, so no dialog ever opened and the request waited until it timed out.
+// This watches the request's dialog model instead and gives each step to the
+// host, whose answers call the model as the dialog's buttons do.
+// ChromeAuthenticatorRequestDelegate calls it for every request it makes.
+void AttachWebAuthnPrompt(AuthenticatorRequestDialogModel* model,
+                          content::RenderFrameHost* frame);
+
+// Chromium's focus rule (ChromeWebAuthenticationDelegate::IsFocused: the
+// page's WebContents is visible) refused a request of this page. Chromium has
+// the rule for creating a passkey, at the start and again when the result
+// arrives; tab/097 adds it to the start of a sign-in that would open a
+// dialog (AuthenticatorCommonImpl::GetCredential), so a page nobody sees
+// reaches no authenticator, wakes no Bluetooth and raises no prompt of
+// macOS. The host hears of each refusal, to log it (security review PK-10,
+// AH-02).
+void NoteWebAuthnRefusedNotVisible(content::WebContents* contents);
+
+// The keychain access group of the profile authenticator ("this Mac": keys
+// in the Secure Enclave, unlocked with Touch ID or the login password):
+// <team>.<bundle identifier>.webauthn. Chromium takes the team from the
+// build's branding. A release engine's branding names it
+// (shell/scripts/build-engine-release.sh); the overlay's own, which the dev
+// engine is built with, names none, and then the team is read from the
+// running app's signature (com.apple.developer.team-identifier). An unsigned
+// or ad hoc signed build has no team and no profile authenticator, as before.
+// The app must also be signed with the group, whatever the engine.
+std::string WebAuthnKeychainAccessGroup();
+
+}  // namespace rearc
+
+#endif  // CHROME_BROWSER_REARC_BRIDGE_REARC_WEBAUTHN_H_
