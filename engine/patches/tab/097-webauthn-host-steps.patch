+// WebAuthn (webauthn_prompts, ABI 1.68): the steps of a passkey or security
+// key request, for the host to show. Chromium's own dialog is a Views dialog
+// on a tab-modal dialog manager a bridge tab does not have; before this
+// channel no dialog opened and the request waited until it timed out. The
+// engine still runs everything else: the authenticators (a phone over
+// Bluetooth after a QR code, a USB security key, "this Mac"), the relying
+// party checks and the request's timeout.
+//
+// phase 0: a step of request_id; json says what to show. The first one opens
+// the host's sheet for the tab, later ones replace what it shows (also the
+// same step again, changed). phase 1: the request is over (done, cancelled,
+// failed or its page gone); close the sheet, no reply. A request that needs
+// no dialog (a sign-in page's passkey autofill, a silent failure) sends
+// nothing at all. Without a callback, for a page that is no registry tab and
+// for an asking frame that is no http or https page (an extension page, which
+// may claim a site it has access to as the relying party), a request that
+// reaches a step with UI is cancelled.
+//
+// A page nobody sees gets no dialog (security review PK-10, AH-02): Chromium
+// refuses to create a passkey for a page whose WebContents is not visible,
+// and the engine refuses a sign-in that would open a dialog the same way,
+// when it starts, before it reaches an authenticator or Bluetooth. A request
+// whose page went out of sight before its first step with UI is cancelled
+// then. Each refusal is one phase 1 event with json {"refused":
+// "not_visible", "at": "focus_check" (Chromium's rule; request_id is 0, and
+// tab_id is 0 for a page that is no registry tab) or "first_step" (with
+// "request" and "step"), "visibility": "hidden" or "occluded"}, for the
+// host's log: it has no sheet to close for it. A sheet that is open stays
+// when its page goes out of sight afterwards, as Chromium's dialog does.
+//
+// json is a UTF-8 object; a host ignores keys it does not know and treats a
+// step it does not know as "unsupported". 64-bit numbers are decimal strings.
+//   "step": "choose" (the ways to sign in: "mechanisms"), "confirm" (one way
+//     offered first: "priority" is its index; the others stay in
+//     "mechanisms"), "security_key" (insert and touch it), "qr" ("qr" is the
+//     text of the code a phone's camera reads; "security_key_too": a USB key
+//     can be touched instead), "phone_connecting", "phone_connected" (go on
+//     on the phone), "phone_error", "bluetooth_off" ("bluetooth_on" turns
+//     true when the person switched it on; "can_power_on": Continue switches
+//     it on), "bluetooth_denied" (macOS denies the app Bluetooth; Continue
+//     opens System Settings), "private_notice" (a passkey made in a private
+//     window stays on the device), "pin", "pin_setup", "pin_change" ("pin":
+//     "min_length", "attempts" left, "error": "none", "wrong", "too_short",
+//     "invalid_characters", "same_as_current", "fingerprint_locked"),
+//     "touch_again", "fingerprint_enroll" ("samples", "samples_remaining"),
+//     "verify_again" ("attempts"), "account" (which account: "accounts"),
+//     "create_this_mac" (confirm a passkey kept on this Mac), "system" (macOS
+//     shows its own prompt; the host shows nothing), "hidden" (nothing to
+//     show for now), "unsupported", and the errors "error_no_transports",
+//     "error_no_passkeys", "error_not_recognized", "error_timeout",
+//     "error_key_not_registered", "error_key_already_registered",
+//     "error_missing_capability", "error_storage_full",
+//     "error_pin_soft_block" (remove and insert the key), "error_pin_hard_block"
+//     (the key must be reset), "error_key_removed".
+//   "request": "get" or "create"; "rp_id"; "origin" of the asking frame;
+//     "profile_id", "content_generation"; "private"; "user" (create: "name",
+//     "display_name"). "visibility": the tab's WebContents as the step goes
+//     out, "visible", "occluded" or "hidden"; a request's first step has
+//     "visible".
+//   "busy": the engine works; only Cancel answers. "can_choose_another":
+//     start over (5) leads to "choose". "can_try_again": an error step may
+//     start over.
+//   "attestation": what a touch of a security key tells the site: "none",
+//     "model" (its make and model) or "serial" (enterprise attestation: which
+//     key it is). "stored_on_key": a record of the visit is kept on the key:
+//     "no", "maybe" or "yes". Chromium warns of both on the touch steps
+//     ("security_key", "touch_again"); a host says them before the touch.
+//   "mechanisms": "index", "kind" ("passkey" with "source", "phone",
+//     "security_key", "this_mac", "icloud_keychain", "password", "google",
+//     "other"), "name" and "description" (Chromium's strings; a passkey's
+//     name is its account). "accounts": "index", "name", "display_name",
+//     "source". "source": "this_mac", "icloud_keychain", "phone",
+//     "security_key", "google" or "other".
+// The "qr" text lets a phone join this one request; a PIN unlocks a security
+// key. A host shows them and writes neither to a log.
+typedef void (*ReArcWebAuthnCallback)(void* context,
+                                      uint64_t request_id,
+                                      uint64_t tab_id,
+                                      uint32_t phase,
+                                      const char* json);
+// Replacing or clearing the callback cancels the requests it was shown.
+REARC_ENGINE_EXPORT void ReArcEngineSetWebAuthnCallback(
+    ReArcWebAuthnCallback callback, void* context);
+// The person's answer, as the buttons of Chromium's dialog give it.
+// action: 0 cancel the request (any step); 1 choose mechanisms[index]
+// ("choose", "confirm"); 2 continue ("confirm": the offered way;
+// "bluetooth_off"; "bluetooth_denied"; "private_notice"; "create_this_mac";
+// "fingerprint_enroll": done); 3 the PIN in text, UTF-8, 1 to 63 bytes (the
+// "pin" steps; for a new PIN the host has asked twice and compared); 4 choose
+// accounts[index] ("account"); 5 start over (another way, or try again).
+// An action the step does not take, and any but cancel while no step with UI
+// is shown: invalid_state. Each step event takes one answer: any but cancel
+// while "busy", after the step's answer and before the next event, and a
+// start over on an error step without "can_try_again", is invalid_state too
+// (opening System Settings on "bluetooth_denied" may be repeated). An index
+// out of range, an empty or over-long PIN, an unknown action:
+// invalid_argument. A request that is over: not_found. The next step, or the
+// end, arrives as an event.
+REARC_ENGINE_EXPORT ReArcStatus ReArcWebAuthnRespond(uint64_t request_id,
+                                                     uint32_t action,
+                                                     uint32_t index,
+                                                     const char* text);
+
 #ifdef __cplusplus
 }  // extern "C"
 #endif
