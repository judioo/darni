index 0000000..b47788b
--- /dev/null
+++ b/chrome/browser/rearc_bridge/rearc_content_blocker.h
@@ -0,0 +1,49 @@
+// Copyright 2026 The ReArc Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_REARC_BRIDGE_REARC_CONTENT_BLOCKER_H_
+#define CHROME_BROWSER_REARC_BRIDGE_REARC_CONTENT_BLOCKER_H_
+
+#include <array>
+#include <string>
+#include <string_view>
+
+namespace content {
+class BrowserContext;
+}  // namespace content
+
+namespace rearc {
+
+// content_blocking (ABI 1.66): the IDs of "ReArc Blocker", the built-in
+// component extension whose declarativeNetRequest rulesets are the blocklists
+// the host names (rearc_content_blocker.cc). Two IDs, because a list update
+// loads the new bundle as the second blocker before the first goes; in
+// ordinary times a profile has one. They follow from the manifest keys there,
+// and chrome/browser/extensions/component_extensions_allowlist/allowlist.cc
+// carries the same strings.
+inline constexpr std::array<const char*, 2> kContentBlockerExtensionIds = {
+    "eoaoomnoofleafmoihlpjdhdceloddjm",
+    "kanaeoiolklalbbkdlpbfohpmgkgackf",
+};
+
+// True for either blocker's extension ID.
+inline constexpr bool IsContentBlockerExtensionId(std::string_view id) {
+  return id == kContentBlockerExtensionIds[0] ||
+         id == kContentBlockerExtensionIds[1];
+}
+
+// From ChromeExtensionsAPIClient::UpdateActionCount: the number of requests
+// `extension_id` has blocked in the page of the tab with extension tab ID
+// `tab_id`, as declarativeNetRequest's ActionTracker counts it (a new page
+// starts again). True for a blocker: the count is the host's then, and the
+// caller must not look for the toolbar action a blocker does not have.
+// Main thread only.
+bool OnContentBlockerActionCount(content::BrowserContext* context,
+                                 const std::string& extension_id,
+                                 int tab_id,
+                                 int action_count);
+
+}  // namespace rearc
+
+#endif  // CHROME_BROWSER_REARC_BRIDGE_REARC_CONTENT_BLOCKER_H_
