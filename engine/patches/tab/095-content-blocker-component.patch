+enum { REARC_ABI_VERSION = 1, REARC_ABI_MINOR_VERSION = 66, REARC_MAX_BLOB_BYTES = 16777216 };
 
 // kind: 0 created, 1 updated, 2 closed, 3 navigation committed, 4 failed.
 // ABI 1.25 adds kind 5 discarded, 6 discard cleared (also on state refresh).
@@ -1684,6 +1684,67 @@ typedef void (*ReArcProcessDetailsCallback)(void* context,
 REARC_ENGINE_EXPORT ReArcStatus ReArcEngineGetProcessDetails(
     ReArcProcessDetailsCallback completion, void* context);
 
+// Content blocking (content_blocking, ABI 1.66): built-in ad and tracker
+// blocking with Chromium's declarativeNetRequest. The engine loads the lists
+// of a blocklist bundle as the static rulesets of a hidden component
+// extension, "ReArc Blocker" (not in the extensions page, chrome.management
+// or the extension actions; it cannot be removed or disabled; it applies in
+// private windows). The host is the source of truth: it tells the engine the
+// state at profile load and on every change, and a profile it has said
+// nothing about has no blocker. profile_id is never an off-the-record
+// profile (invalid_argument): private windows follow their profile.
+//
+// The directory of a bundle the host has verified (manifest.json and
+// rules/<list id>.json, docs/FEATURE-SPECS/CONTENT-BLOCKING.md section 4):
+// an absolute path, read once. The engine copies the rules into
+// <user data dir>/ReArc Blocker/<version>, where Chromium also writes its
+// index, so the directory may be read-only and inside the app, and the host
+// may delete it once a later call has taken effect. Every profile with
+// blocking on gets the blocker of this bundle; a directory the engine cannot
+// read or copy leaves the bundle in use (logged). Deferred, no completion.
+REARC_ENGINE_EXPORT ReArcStatus ReArcEngineSetBlocklistDirectory(
+    const char* utf8_path);
+// level: 0 off (no blocker in the profile), 1 trackers, 2 ads and trackers,
+// 3 strict. enabled_list_ids_json: a JSON array of the bundle's list ids to
+// switch on, and all others off; null for the lists of the level (a list's
+// "level" in the bundle's manifest.json is the lowest level with it). An id
+// the bundle in use does not have is skipped, and applies when a later bundle
+// has it. Other levels and malformed JSON are invalid_argument.
+REARC_ENGINE_EXPORT ReArcStatus ReArcProfileSetContentBlocking(
+    uint64_t profile_id, int32_t level, const char* enabled_list_ids_json);
+// Replaces the profile's site exceptions. hosts_json: a JSON array of at
+// most 10,000 hosts, lower-case ASCII (punycode), without scheme, port or
+// path; a host covers its subdomains. Nothing is blocked in a page or frame
+// of an excepted host, nor a request one of its documents makes, whatever
+// the lists and the person's own rules say. A change applies to requests
+// from then on; the host reloads the tab. Kept while blocking is off and
+// applied when it is switched on.
+REARC_ENGINE_EXPORT ReArcStatus ReArcProfileSetBlockingExceptions(
+    uint64_t profile_id, const char* hosts_json);
+// Replaces the person's own rules. dnr_rules_json: a JSON array of at most
+// 5,000 declarativeNetRequest rules with action block, allow or
+// allowAllRequests (anything else is invalid_argument: own rules never
+// redirect or change headers). The engine numbers them and keeps the order of
+// their priorities (1 to 100) above every list rule and below the site
+// exceptions. A rule that does not parse is invalid_argument and nothing
+// changes. One Chromium refuses later, at indexing (a regular expression RE2
+// cannot compile), fails the whole replacement and leaves the earlier own
+// rules (logged).
+REARC_ENGINE_EXPORT ReArcStatus ReArcProfileSetOwnBlockingRules(
+    uint64_t profile_id, const char* dnr_rules_json);
+// Requests the blocker has blocked in the tab's current page: a main frame
+// navigation to another document starts again from what blocked that
+// navigation's own request. 0 for an unknown tab and with blocking off.
+// Requests an exception or allow rule let through are not counted.
+REARC_ENGINE_EXPORT uint32_t ReArcTabGetBlockedCount(uint64_t tab_id);
+// The count of a tab changed. Changes are delivered together, at most every
+// 250 ms, each tab with its latest count. Null disables delivery.
+typedef void (*ReArcBlockedCountCallback)(void* context,
+                                          uint64_t tab_id,
+                                          uint32_t blocked_count);
+REARC_ENGINE_EXPORT void ReArcEngineSetBlockedCountCallback(
+    ReArcBlockedCountCallback callback, void* context);
+
 #ifdef __cplusplus
 }  // extern "C"
 #endif
