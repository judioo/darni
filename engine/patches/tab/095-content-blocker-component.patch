+// Rule priorities. A bundle's list rules use 1 to 4 (block, allow, important,
+// important allow: "priorities" in its manifest.json). The person's own rules
+// keep their order and sit above every list rule, and a site exception is
+// above everything.
+constexpr int kMaxOwnRulePriority = 100;
+constexpr int kOwnRulePriorityOffset = 10;
+constexpr int kSiteExceptionPriority = 1000000;
+
+// Dynamic rule IDs. Fixed, so a replacement needs no knowledge of what an
+// earlier session left on disk.
+constexpr int kExceptionFrameRuleId = 1;
+constexpr int kExceptionInitiatorRuleId = 2;
+constexpr int kFirstOwnRuleId = 1000;
+constexpr size_t kMaxOwnRules = 5000;
+constexpr size_t kMaxExceptionHosts = 10000;
+constexpr size_t kMaxLists = 100;  // MAX_NUMBER_OF_STATIC_RULESETS
+constexpr size_t kMaxManifestBytes = 4 * 1024 * 1024;
+constexpr size_t kMaxRulesFileBytes = 64 * 1024 * 1024;
+constexpr size_t kMaxArgumentBytes = 8 * 1024 * 1024;
+constexpr base::TimeDelta kCountInterval = base::Milliseconds(250);
+// The longest a fresh load holds a profile's navigations, from the first one
+// it holds (FreshLoadThrottle). After that they go, lists or not.
+constexpr base::TimeDelta kFreshLoadHold = base::Milliseconds(1500);
+// In a blocker's extension preferences: the bundle version it was loaded for
+// when it last became ready (lists on). Written by FinishTakeover, removed
+// when the blocker is removed (Unload), read at launch (RememberedSlot).
+constexpr char kReadyBundlePref[] = "rearc_ready_bundle";
+
+class FreshLoadThrottle;
+
+struct BundleList {
+  std::string id;
+  int level = 0;  // The lowest blocking level that includes it; 0: none does.
+};
+
+// The bundle in use: the engine's copy of what the host named.
+struct Bundle {
+  std::string version;       // YYYYMMDDHHMM, manifest.json "version".
+  base::FilePath directory;  // <user data dir>/ReArc Blocker/<version>.
+  std::vector<BundleList> lists;
+};
+
+// The navigations a fresh load holds in one profile (FreshLoadThrottle).
+struct Hold {
+  // The blocker was ready, or the limit passed: nothing more is held until a
+  // fresh load starts again (ApplyState).
+  bool spent = false;
+  // One limit for every navigation of the load: set by the first navigation
+  // held, and never moved by a later one, a redirect or a reload.
+  base::TimeTicks deadline;
+  base::OneShotTimer timer;
+  std::vector<base::WeakPtr<FreshLoadThrottle>> waiting;
+};
+
+// What the host has said about one profile (never an off-the-record one).
+struct ProfileState {
+  int level = 0;
+  bool names_lists = false;  // Else the lists of `level`.
+  std::vector<std::string> list_ids;
+  bool has_exceptions = false;
+  std::vector<std::string> exception_hosts;
+  bool has_own_rules = false;
+  base::ListValue own_rules;  // IDs and priorities already the engine's.
+  // The blockers loaded in the profile, by slot: the bundle version of each,
+  // empty for none. In ordinary times one is loaded, `current`. During a list
+  // update two are: `current` is the new bundle's, which is taking over, and
+  // the other one goes on blocking until `current` is ready (FinishTakeover).
+  std::array<std::string, kSlots> loaded;
+  int current = -1;
+  // `current` has its site exceptions and its own rules: both dynamic rule
+  // updates have ended. Its lists are not switched on before (SwitchListsOn).
+  bool current_rules_set = false;
+  // The blocker in a slot has had its exceptions, own rules and lists on
+  // since it was loaded (FinishTakeover). A loaded blocker that is not
+  // `current` is always one that was ready: it is kept only to go on
+  // blocking during a list update.
+  std::array<bool, kSlots> ready = {};
+  Hold hold;
+};
+
+std::optional<Bundle>& CurrentBundle() {
+  static base::NoDestructor<std::optional<Bundle>> bundle;
+  return *bundle;
+}
+std::map<uint64_t, ProfileState>& States() {
+  static base::NoDestructor<std::map<uint64_t, ProfileState>> states;
+  return *states;
+}
+
+// Some blocker in the profile has its lists on and is blocking.
+bool HasReadyBlocker(const ProfileState& state) {
+  for (int slot = 0; slot < kSlots; ++slot) {
+    if (!state.loaded[slot].empty() && state.ready[slot]) {
+      return true;
+    }
+  }
+  return false;
+}
+
+// The profile wants blocking and nothing blocks yet: its web navigations
+// wait (FreshLoadThrottle), until the limit of this load.
+bool HoldsNavigations(const ProfileState& state) {
+  return state.level > 0 && !state.hold.spent && !HasReadyBlocker(state);
+}
+
+// Security CB-02: holds a web navigation (main frame or subframe, http or
+// https) of a profile that wants blocking and has no ready blocker, so that
+// a restored page's first requests do not go out before the lists are on.
+// It is created only while that is so (AddContentBlockerNavigationThrottle):
+// a profile with blocking off, or one the host has said nothing about, has
+// none. It only ever resumes the navigation: when the blocker is ready, at
+// the load's limit, when blocking is switched off and when the profile goes;
+// a closing tab takes its navigation, and this, with it.
+class FreshLoadThrottle : public content::NavigationThrottle {
+ public:
+  FreshLoadThrottle(content::NavigationThrottleRegistry& registry,
+                    uint64_t profile_id)
+      : NavigationThrottle(registry), profile_id_(profile_id) {}
+
+  const char* GetNameForLogging() override { return "ReArcBlockerFreshLoad"; }
+  ThrottleCheckResult WillStartRequest() override { return Check(); }
+  ThrottleCheckResult WillRedirectRequest() override { return Check(); }
+
+  // From ReleaseHeld only.
+  void Release() {
+    if (deferred_) {
+      deferred_ = false;
+      Resume();
+    }
+  }
+
+ private:
+  ThrottleCheckResult Check();
+
+  const uint64_t profile_id_;
+  bool deferred_ = false;
+  base::WeakPtrFactory<FreshLoadThrottle> weak_factory_{this};
+};
+
+// Lets every navigation the profile's load holds go on. `state` may be gone
+// once this returns: a resumed navigation can run anything.
+void ReleaseHeld(ProfileState& state) {
+  state.hold.timer.Stop();
+  std::vector<base::WeakPtr<FreshLoadThrottle>> waiting;
+  waiting.swap(state.hold.waiting);
+  for (const base::WeakPtr<FreshLoadThrottle>& throttle : waiting) {
+    if (throttle) {
+      throttle->Release();
+    }
+  }
+}
+
+// The blocker is ready, or its lists are on: nothing more is held in this
+// load.
+void EndHold(ProfileState& state) {
+  state.hold.spent = true;
+  ReleaseHeld(state);
+}
+
+void OnHoldExpired(uint64_t profile_id) {
+  auto found = States().find(profile_id);
+  if (found == States().end()) {
+    return;
+  }
+  LOG(WARNING) << "ReArc Blocker: the lists were not on within "
+               << kFreshLoadHold.InMilliseconds()
+               << " ms; the navigations held for them go on";
+  EndHold(found->second);
+}
+
+content::NavigationThrottle::ThrottleCheckResult FreshLoadThrottle::Check() {
+  if (!navigation_handle()->GetURL().SchemeIsHTTPOrHTTPS()) {
+    return PROCEED;
+  }
+  auto found = States().find(profile_id_);
+  if (found == States().end() || !HoldsNavigations(found->second)) {
+    return PROCEED;
+  }
+  Hold& hold = found->second.hold;
+  const base::TimeTicks now = base::TimeTicks::Now();
+  if (hold.deadline.is_null()) {
+    hold.deadline = now + kFreshLoadHold;
+  }
+  const base::TimeDelta left = hold.deadline - now;
+  if (!left.is_positive()) {
+    // The limit has passed; the timer, running while anything waits, lets
+    // the others go.
+    hold.spent = true;
+    return PROCEED;
+  }
+  if (!hold.timer.IsRunning()) {
+    hold.timer.Start(FROM_HERE, left,
+                     base::BindOnce(&OnHoldExpired, profile_id_));
+  }
+  deferred_ = true;
+  hold.waiting.push_back(weak_factory_.GetWeakPtr());
+  return DEFER;
+}
+// Counts the newest ReArcEngineSetBlocklistDirectory call: the result of an
+// older one is dropped.
+uint64_t g_bundle_request = 0;
+// Bundles are prepared one after another: each run deletes the copies of
+// other versions, which must not be one a second run is writing.
+scoped_refptr<base::SequencedTaskRunner> BundleRunner() {
+  static base::NoDestructor<scoped_refptr<base::SequencedTaskRunner>> runner(
+      base::ThreadPool::CreateSequencedTaskRunner(
+          {base::MayBlock(), base::TaskPriority::USER_VISIBLE,
+           base::TaskShutdownBehavior::SKIP_ON_SHUTDOWN}));
+  return *runner;
+}
+
+ReArcBlockedCountCallback g_count_callback = nullptr;
+void* g_count_context = nullptr;
+// A tab's count from each blocker. A request is blocked by one of them, so
+// the tab's count is the sum.
+using SlotCounts = std::array<uint32_t, kSlots>;
+std::map<uint64_t, SlotCounts>& Counts() {
+  static base::NoDestructor<std::map<uint64_t, SlotCounts>> counts;
+  return *counts;
+}
+uint32_t Total(const SlotCounts& counts) {
+  uint32_t total = 0;
+  for (uint32_t count : counts) {
+    total += count;
+  }
+  return total;
+}
+std::set<uint64_t>& ChangedCounts() {
+  static base::NoDestructor<std::set<uint64_t>> changed;
+  return *changed;
+}
+
+extensions::ExtensionId BlockerId(int slot) {
+  return extensions::ExtensionId(kContentBlockerExtensionIds[slot]);
+}
+
+// The slot of a blocker's extension ID, or -1 for any other extension.
+int BlockerSlot(std::string_view extension_id) {
+  for (int slot = 0; slot < kSlots; ++slot) {
+    if (extension_id == kContentBlockerExtensionIds[slot]) {
+      return slot;
+    }
+  }
+  return -1;
+}
+
+// What a rule of a list, and a rule of the person's own, may do: block a
+// request, allow one, or allow everything in a page or frame. Never redirect
+// a request, upgrade its scheme or change headers.
+bool IsBlockOrAllow(std::string_view action) {
+  return action == "block" || action == "allow" ||
+         action == "allowAllRequests";
+}
+
+// Security CB-03: true when `json` is a list of rules that only block and
+// allow. The host has checked the bundle's signature and hashes, which say
+// who wrote the lists, and makes this check too; it is made again here, with
+// the reader that indexes the rules (JSON_PARSE_RFC, as
+// FileBackedRulesetSource), because this is the last place before Chromium
+// acts on them. Today Chromium ignores a redirect or header rule from the
+// blocker, which has no access to any site (CompositeMatcher::GetAction,
+// RulesetManager::GetModifyHeadersActions). That stops holding the day the
+// manifest gains host access (per-site CSS, phase 2): from then on a rule
+// that redirects a script or strips a security header would put page content
+// in the hands of whoever holds the lists key. With this check a signed list
+// still only blocks and allows.
+bool OnlyBlocksAndAllows(std::string_view json) {
+  std::optional<base::ListValue> rules =
+      base::JSONReader::ReadList(json, base::JSON_PARSE_RFC);
+  if (!rules) {
+    return false;
+  }
+  for (const base::Value& value : *rules) {
+    const base::DictValue* rule = value.GetIfDict();
+    const std::string* action =
+        rule ? rule->FindStringByDottedPath("action.type") : nullptr;
+    if (!action || !IsBlockOrAllow(*action)) {
+      return false;
+    }
+  }
+  return true;
+}
+
+bool IsListId(std::string_view id) {
+  return !id.empty() && id.size() <= 63 && id.front() != '-' &&
+         std::ranges::all_of(id, [](char c) {
+           return base::IsAsciiLower(c) || base::IsAsciiDigit(c) || c == '-';
+         });
+}
+
+bool IsBundleVersion(std::string_view version) {
+  return version.size() == 12 &&
+         std::ranges::all_of(version,
+                             [](char c) { return base::IsAsciiDigit(c); });
+}
+
+// "202611180857" as an extension version, "2026.1118.857": three numbers
+// below 65536 that order as the bundle versions do.
+std::string ExtensionVersion(const std::string& version) {
+  unsigned year = 0, day = 0, minute = 0;
+  base::StringToUint(version.substr(0, 4), &year);
+  base::StringToUint(version.substr(4, 4), &day);
+  base::StringToUint(version.substr(8, 4), &minute);
+  return base::NumberToString(year) + "." + base::NumberToString(day) + "." +
+         base::NumberToString(minute);
+}
+
+// A host as declarativeNetRequest takes it: lower-case ASCII (punycode for an
+// international name), no scheme, port, path or brackets.
+bool IsHost(std::string_view host) {
+  return !host.empty() && host.size() <= 253 && host.front() != '.' &&
+         host.back() != '.' && host.front() != '-' &&
+         host.find("..") == std::string_view::npos &&
+         std::ranges::all_of(host, [](char c) {
+           return base::IsAsciiLower(c) || base::IsAsciiDigit(c) || c == '-' ||
+                  c == '.' || c == '_';
+         });
+}
+
+// On BundleRunner(). Reads the host's bundle and makes the engine's copy of
+// its rules, once per bundle version. `keep` is the copy in use until the
+// reply.
+std::optional<Bundle> PrepareBundle(const base::FilePath& source,
+                                    const base::FilePath& root,
+                                    const base::FilePath& keep) {
+  std::string json;
+  if (!base::ReadFileToStringWithMaxSize(source.AppendASCII("manifest.json"),
+                                         &json, kMaxManifestBytes)) {
+    return std::nullopt;
+  }
+  std::optional<base::DictValue> manifest =
+      base::JSONReader::ReadDict(json, base::JSON_PARSE_RFC);
+  if (!manifest) {
+    return std::nullopt;
+  }
+  const std::string* version = manifest->FindString("version");
+  const base::ListValue* lists = manifest->FindList("lists");
+  if (!version || !IsBundleVersion(*version) || !lists || lists->empty() ||
+      lists->size() > kMaxLists) {
+    return std::nullopt;
+  }
+  Bundle bundle;
+  bundle.version = *version;
+  bundle.directory = root.AppendASCII(*version);
+  std::set<std::string> seen;
+  for (const base::Value& value : *lists) {
+    const base::DictValue* entry = value.GetIfDict();
+    const std::string* id = entry ? entry->FindString("id") : nullptr;
+    if (!id || !IsListId(*id) || !seen.insert(*id).second) {
+      return std::nullopt;
+    }
+    bundle.lists.push_back({*id, entry->FindInt("level").value_or(0)});
+  }
+  // The marker is written last: a copy without it was interrupted.
+  const base::FilePath complete = bundle.directory.AppendASCII("complete");
+  if (!base::PathExists(complete)) {
+    base::DeletePathRecursively(bundle.directory);
+    const base::FilePath rules = bundle.directory.AppendASCII("rules");
+    if (!base::CreateDirectory(rules)) {
+      return std::nullopt;
+    }
+    for (const BundleList& list : bundle.lists) {
+      const std::string name = list.id + ".json";
+      // Read, checked and written from memory: the bytes that were checked
+      // are the bytes Chromium indexes.
+      std::string text;
+      if (!base::ReadFileToStringWithMaxSize(
+              source.AppendASCII("rules").AppendASCII(name), &text,
+              kMaxRulesFileBytes) ||
+          !OnlyBlocksAndAllows(text) ||
+          !base::WriteFile(rules.AppendASCII(name), text)) {
+        LOG(ERROR) << "ReArc Blocker: list " << list.id << " of bundle "
+                   << bundle.version
+                   << " is unreadable or has a rule that neither blocks nor "
+                      "allows; the bundle is refused";
+        base::DeletePathRecursively(bundle.directory);
+        return std::nullopt;
+      }
+    }
+    if (!base::WriteFile(complete, bundle.version)) {
+      base::DeletePathRecursively(bundle.directory);
+      return std::nullopt;
+    }
+  }
+  // Copies of other versions, with the indexes Chromium wrote into them.
+  std::vector<base::FilePath> old;
+  base::FileEnumerator copies(root, /*recursive=*/false,
+                              base::FileEnumerator::DIRECTORIES);
+  for (base::FilePath copy = copies.Next(); !copy.empty();
+       copy = copies.Next()) {
+    if (copy != bundle.directory && copy != keep) {
+      old.push_back(copy);
+    }
+  }
+  for (const base::FilePath& copy : old) {
+    base::DeletePathRecursively(copy);
+  }
+  return bundle;
+}
+
+// The component extension's manifest: one static ruleset per list, none on
+// until the host's lists are applied (ApplyRulesets). A component extension's
+// rulesets are not indexed at install as a packed extension's are, and
+// RulesMonitorService indexes a ruleset the first time it is switched on.
+//
+// Security CB-03: the manifest asks for one permission, declarativeNetRequest,
+// and nothing else. No host permissions, no content scripts, no background
+// script, no pages. That is what makes the blocker unable to read or change a
+// page, and what makes Chromium ignore any rule of it that is not block or
+// allow. engine/tests/check_content_blocker_manifest.py fails when a key or a
+// permission is added here. Phase 2 (per-site CSS) needs access to pages:
+// before the manifest gains it, OnlyBlocksAndAllows above must still stand
+// between a signed list and Chromium, and the security review must see the
+// change.
+base::DictValue BlockerManifest(const Bundle& bundle, int slot) {
+  base::DictValue manifest;
+  manifest.Set("manifest_version", 3);
+  manifest.Set("name", "ReArc Blocker");
+  manifest.Set("description", "ReArc's built-in ad and tracker blocking.");
+  manifest.Set("version", ExtensionVersion(bundle.version));
+  manifest.Set("key", kManifestKeys[slot]);
+  manifest.Set("incognito", "split");
+  base::ListValue permissions;
+  permissions.Append("declarativeNetRequest");
+  manifest.Set("permissions", std::move(permissions));
+  base::ListValue resources;
+  for (const BundleList& list : bundle.lists) {
+    base::DictValue resource;
+    resource.Set("id", list.id);
+    resource.Set("enabled", false);
+    resource.Set("path", "rules/" + list.id + ".json");
+    resources.Append(std::move(resource));
+  }
+  base::DictValue rulesets;
+  rulesets.Set("rule_resources", std::move(resources));
+  manifest.Set("declarative_net_request", std::move(rulesets));
+  return manifest;
+}
+
+// The profile, its state and its blocker loaded in `slot`, when all three
+// exist.
+struct Loaded {
+  raw_ptr<Profile> profile = nullptr;
+  raw_ptr<ProfileState> state = nullptr;
+  raw_ptr<const extensions::Extension> extension = nullptr;
+  raw_ptr<dnr::RulesMonitorService> service = nullptr;
+};
+std::optional<Loaded> FindLoaded(uint64_t profile_id, int slot) {
+  Profile* profile = FindBridgeProfile(profile_id);
+  auto state = States().find(profile_id);
+  if (!profile || state == States().end() || slot < 0 || slot >= kSlots ||
+      state->second.loaded[slot].empty()) {
+    return std::nullopt;
+  }
+  const extensions::Extension* extension =
+      extensions::ExtensionRegistry::Get(profile)->enabled_extensions().GetByID(
+          BlockerId(slot));
+  dnr::RulesMonitorService* service = dnr::RulesMonitorService::Get(profile);
+  if (!extension || !service) {
+    return std::nullopt;
+  }
+  return Loaded{profile, &state->second, extension, service};
+}
+
+void LogRuleError(const char* what, std::optional<std::string> error) {
+  if (error) {
+    LOG(ERROR) << "ReArc Blocker: " << what << ": " << *error;
+  }
+}
+
+// A dynamic rule update ended, well or not: `done` follows either way. A
+// blocker whose exceptions or own rules Chromium refused still gets its lists
+// and takes over from the one before it; the refusal is the same in both.
+// `done` is posted, not run here: Chromium calls back just before it hands
+// the updated rules to the matcher
+// (RulesMonitorService::OnDynamicRulesUpdated), and what follows must find
+// them in force.
+void OnDynamicRulesSet(const char* what,
+                       base::OnceClosure done,
+                       std::optional<std::string> error) {
+  LogRuleError(what, std::move(error));
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(FROM_HERE,
+                                                           std::move(done));
+}
+
+base::DictValue RuleValue(int id,
+                          int priority,
+                          const char* action,
+                          base::DictValue condition) {
+  base::DictValue rule;
+  rule.Set("id", id);
+  rule.Set("priority", priority);
+  base::DictValue action_value;
+  action_value.Set("type", action);
+  rule.Set("action", std::move(action_value));
+  rule.Set("condition", std::move(condition));
+  return rule;
+}
+
+// Site exceptions: nothing is blocked in a page or frame of an excepted host
+// (allowAllRequests on its document requests) and nothing an excepted host's
+// documents ask for (allow by initiator), above every list and own rule.
+// A host covers its subdomains, as declarativeNetRequest's domain lists do.
+// `done` runs when the blocker in `slot` has them, or has nothing to get.
+void ApplyExceptions(uint64_t profile_id, int slot, base::OnceClosure done) {
+  std::optional<Loaded> loaded = FindLoaded(profile_id, slot);
+  if (!loaded || !loaded->state->has_exceptions) {
+    std::move(done).Run();
+    return;
+  }
+  std::vector<dnr_api::Rule> rules;
+  if (!loaded->state->exception_hosts.empty()) {
+    base::ListValue hosts;
+    for (const std::string& host : loaded->state->exception_hosts) {
+      hosts.Append(host);
+    }
+    base::ListValue frames;
+    frames.Append("main_frame");
+    frames.Append("sub_frame");
+    base::DictValue frame_condition;
+    frame_condition.Set("requestDomains", hosts.Clone());
+    frame_condition.Set("resourceTypes", std::move(frames));
+    base::DictValue initiator_condition;
+    initiator_condition.Set("initiatorDomains", std::move(hosts));
+    auto add = [&rules](const base::DictValue& value) {
+      auto rule = dnr_api::Rule::FromValue(value);
+      CHECK(rule.has_value());
+      rules.push_back(std::move(*rule));
+    };
+    add(RuleValue(kExceptionFrameRuleId, kSiteExceptionPriority,
+                  "allowAllRequests", std::move(frame_condition)));
+    add(RuleValue(kExceptionInitiatorRuleId, kSiteExceptionPriority, "allow",
+                  std::move(initiator_condition)));
+  }
+  loaded->service->UpdateDynamicRules(
+      *loaded->extension, {kExceptionFrameRuleId, kExceptionInitiatorRuleId},
+      std::move(rules),
+      base::BindOnce(&OnDynamicRulesSet, "site exceptions", std::move(done)));
+}
+
+// The person's own rules replace the whole own-rule ID range. Chromium applies
+// a dynamic rule update whole or not at all: a rule it refuses (a regular
+// expression RE2 cannot compile) leaves the earlier own rules in place.
+// `done` runs when the blocker in `slot` has them, or has nothing to get.
+void ApplyOwnRules(uint64_t profile_id, int slot, base::OnceClosure done) {
+  std::optional<Loaded> loaded = FindLoaded(profile_id, slot);
+  if (!loaded || !loaded->state->has_own_rules) {
+    std::move(done).Run();
+    return;
+  }
+  std::vector<int> remove;
+  remove.reserve(kMaxOwnRules);
+  for (size_t i = 0; i < kMaxOwnRules; ++i) {
+    remove.push_back(kFirstOwnRuleId + static_cast<int>(i));
+  }
+  std::vector<dnr_api::Rule> rules;
+  for (const base::Value& value : loaded->state->own_rules) {
+    auto rule = dnr_api::Rule::FromValue(value);
+    if (rule.has_value()) {  // Checked when the host set them.
+      rules.push_back(std::move(*rule));
+    }
+  }
+  loaded->service->UpdateDynamicRules(
+      *loaded->extension, std::move(remove), std::move(rules),
+      base::BindOnce(&OnDynamicRulesSet, "own rules", std::move(done)));
+}
+
+// The manifest IDs of the lists the host wants on in this profile.
+std::vector<std::string> WantedLists(const ProfileState& state,
+                                     const Bundle& bundle) {
+  if (state.names_lists) {
+    return state.list_ids;
+  }
+  std::vector<std::string> ids;
+  for (const BundleList& list : bundle.lists) {
+    if (list.level > 0 && list.level <= state.level) {
+      ids.push_back(list.id);
+    }
+  }
+  return ids;
+}
+
+// The lists of the blocker in `slot` are as the host wants them: `done` runs.
+// Not after an error: a blocker whose lists did not come on blocks nothing,
+// and must not take over from one that does.
+void OnRulesetsApplied(base::OnceClosure done,
+                       std::optional<std::string> error) {
+  if (error) {
+    LogRuleError("lists", std::move(error));
+    return;
+  }
+  std::move(done).Run();
+}
+
+// Second step of ApplyRulesets, when the blocker's rulesets have loaded:
+// switches on what is wanted and not loaded, and off what is loaded and not
+// wanted. A ruleset that is on stays loaded as it is.
+void ApplyRulesetDifference(uint64_t profile_id,
+                            int slot,
+                            std::string version,
+                            base::OnceClosure done,
+                            std::optional<std::string> error) {
+  LogRuleError("lists", std::move(error));
+  std::optional<Loaded> loaded = FindLoaded(profile_id, slot);
+  const std::optional<Bundle>& bundle = CurrentBundle();
+  if (!loaded || !bundle || loaded->state->loaded[slot] != version ||
+      bundle->version != version) {
+    return;  // Unloaded or replaced since; the newer load applies its own.
+  }
+  const dnr::DNRManifestData::ManifestIDToRulesetMap& rulesets =
+      dnr::DNRManifestData::GetManifestIDToRulesetMap(*loaded->extension);
+  std::set<dnr::RulesetID> wanted;
+  for (const std::string& id : WantedLists(*loaded->state, *bundle)) {
+    auto found = rulesets.find(id);
+    // A list this bundle does not have is skipped.
+    if (found != rulesets.end()) {
+      wanted.insert(found->second->id);
+    }
+  }
+  std::set<dnr::RulesetID> on;
+  if (dnr::CompositeMatcher* matcher =
+          loaded->service->ruleset_manager()->GetMatcherForExtension(
+              loaded->extension->id())) {
+    on = matcher->ComputeStaticRulesetIDs();
+  }
+  std::set<dnr::RulesetID> enable, disable;
+  std::set_difference(wanted.begin(), wanted.end(), on.begin(), on.end(),
+                      std::inserter(enable, enable.begin()));
+  std::set_difference(on.begin(), on.end(), wanted.begin(), wanted.end(),
+                      std::inserter(disable, disable.begin()));
+  if (enable.empty() && disable.empty()) {
+    std::move(done).Run();
+    return;
+  }
+  loaded->service->UpdateEnabledStaticRulesets(
+      *loaded->extension, std::move(disable), std::move(enable),
+      base::BindOnce(&OnRulesetsApplied, std::move(done)));
+}
+
+// Switches the rulesets of the blocker in `slot` to the host's lists; `done`
+// runs once they are. The service runs one ruleset update at a time and none
+// before the extension's first load is done, so an empty update is the point
+// at which the loaded set is known.
+void ApplyRulesets(uint64_t profile_id, int slot, base::OnceClosure done) {
+  std::optional<Loaded> loaded = FindLoaded(profile_id, slot);
+  if (!loaded) {
+    return;
+  }
+  loaded->service->UpdateEnabledStaticRulesets(
+      *loaded->extension, {}, {},
+      base::BindOnce(&ApplyRulesetDifference, profile_id, slot,
+                     loaded->state->loaded[slot], std::move(done)));
+}
+
+void DeliverCounts() {
+  // Tabs that are gone take their counts with them.
+  std::erase_if(Counts(), [](const auto& entry) {
+    return !TabRegistry::Get().FindSession(entry.first);
+  });
+  std::vector<std::pair<uint64_t, uint32_t>> changed;
+  for (uint64_t tab_id : ChangedCounts()) {
+    auto count = Counts().find(tab_id);
+    if (count != Counts().end()) {
+      changed.emplace_back(tab_id, Total(count->second));
+    }
+  }
+  ChangedCounts().clear();
+  if (changed.empty() || !g_count_callback) {
+    return;
+  }
+  ABIPost(base::BindOnce(
+      [](std::vector<std::pair<uint64_t, uint32_t>> counts) {
+        for (const auto& [tab_id, count] : counts) {
+          if (g_count_callback) {
+            g_count_callback(g_count_context, tab_id, count);
+          }
+        }
+      },
+      std::move(changed)));
+}
+
+// Records a tab's count from the blocker in `slot`. The host hears of changes
+// together, at most once per kCountInterval.
+void SetCount(uint64_t tab_id, int slot, uint32_t count) {
+  auto [entry, inserted] = Counts().try_emplace(tab_id, SlotCounts{});
+  if (entry->second[slot] == count) {
+    return;
+  }
+  entry->second[slot] = count;
+  ChangedCounts().insert(tab_id);
+  static base::NoDestructor<base::OneShotTimer> timer;
+  if (!timer->IsRunning()) {
+    timer->Start(FROM_HERE, kCountInterval, base::BindOnce(&DeliverCounts));
+  }
+}
+
+// The blocker in `slot` went from `profile`: ActionTracker drops its counts
+// with the rulesets, so they are gone from the tabs of the profile and of its
+// private windows. After a list update a page's count starts again from what
+// the new blocker blocks; the next navigation resets it anyway.
+void ClearCounts(Profile* profile, int slot) {
+  for (uint64_t tab_id : TabRegistry::Get().SessionIds()) {
+    TabSession* session = TabRegistry::Get().FindSession(tab_id);
+    if (!session) {
+      continue;
+    }
+    Profile* owner = Profile::FromBrowserContext(
+        session->web_contents()->GetBrowserContext());
+    if (owner->GetOriginalProfile() == profile) {
+      SetCount(tab_id, slot, 0);
+    }
+  }
+}
+
+// Removes the marker of the blocker in `slot` (kReadyBundlePref), if it has
+// one. A slot that never had one gets no preferences entry from this.
+void ClearReadyMarker(Profile* profile, int slot) {
+  extensions::ExtensionPrefs* prefs = extensions::ExtensionPrefs::Get(profile);
+  std::string marked;
+  if (prefs &&
+      prefs->ReadPrefAsString(BlockerId(slot), kReadyBundlePref, &marked)) {
+    prefs->UpdateExtensionPref(BlockerId(slot), kReadyBundlePref,
+                               std::nullopt);
+  }
+}
+
+// Removes the blocker in `slot` from the profile. Chromium treats a removed
+// component extension as uninstalled and deletes its dynamic rules, which is
+// why they are set again after every load (ApplyState).
+void Unload(Profile* profile, ProfileState& state, int slot) {
+  extensions::ComponentLoader* loader =
+      extensions::ComponentLoader::Get(profile);
+  if (loader && loader->Exists(BlockerId(slot))) {
+    loader->Remove(BlockerId(slot));
+    ClearCounts(profile, slot);
+  }
+  // Its dynamic rules went with it: it is no longer one to load at launch.
+  ClearReadyMarker(profile, slot);
+  state.loaded[slot].clear();
+  state.ready[slot] = false;
+  if (state.current == slot) {
+    state.current = -1;
+    state.current_rules_set = false;
+  }
+}
+
+// The slot whose blocker was ready in the last session for bundle
+// `version`, by the marker FinishTakeover leaves in its extension
+// preferences, or -1. Only a marker of exactly this version counts, and only
+// when one slot has it: anything else is a fresh load.
+int RememberedSlot(Profile* profile, const std::string& version) {
+  extensions::ExtensionPrefs* prefs = extensions::ExtensionPrefs::Get(profile);
+  if (!prefs) {
+    return -1;
+  }
+  int remembered = -1;
+  for (int slot = 0; slot < kSlots; ++slot) {
+    std::string marked;
+    if (prefs->ReadPrefAsString(BlockerId(slot), kReadyBundlePref, &marked) &&
+        marked == version) {
+      if (remembered >= 0) {
+        return -1;
+      }
+      remembered = slot;
+    }
+  }
+  return remembered;
+}
+
+// The blocker in `slot`, loaded for bundle `version`, has its site
+// exceptions, its own rules and, after them, its lists on. Only now does the
+// blocker of the bundle before it go: no open page was without its lists in
+// between.
+void FinishTakeover(uint64_t profile_id, int slot, std::string version) {
+  Profile* profile = FindBridgeProfile(profile_id);
+  auto found = States().find(profile_id);
+  if (!profile || found == States().end()) {
+    return;
+  }
+  ProfileState& state = found->second;
+  if (state.current != slot || state.loaded[slot] != version) {
+    return;  // Unloaded or replaced since; the newer load finishes its own.
+  }
+  state.ready[slot] = true;
+  const int other = kSlots - 1 - slot;
+  if (!state.loaded[other].empty()) {
+    Unload(profile, state, other);
+  }
+  // The next launch loads this one first (RememberedSlot), with its lists and
+  // dynamic rules as they are now. The other slot's marker, left by a launch
+  // that ended during a list update, goes.
+  ClearReadyMarker(profile, other);
+  if (extensions::ExtensionPrefs* prefs =
+          extensions::ExtensionPrefs::Get(profile)) {
+    prefs->UpdateExtensionPref(BlockerId(slot), kReadyBundlePref,
+                               base::Value(version));
+  }
+  EndHold(state);
+}
+
+// A blocker loaded again at launch for the bundle of the last session
+// (RememberedSlot): Chromium has brought up the lists that were on then
+// together with the extension (RulesMonitorService::OnExtensionLoaded), and
+// an empty ruleset update ends only after that load. When the lists the host
+// wants are among them, the held navigations go on now rather than after this
+// launch's exceptions, own rules and lists are set: until then the exceptions
+// in force are the last session's, as the patch header says.
+void OnRememberedListsLoaded(uint64_t profile_id,
+                             int slot,
+                             std::string version,
+                             std::optional<std::string> error) {
+  LogRuleError("lists", std::move(error));
+  std::optional<Loaded> loaded = FindLoaded(profile_id, slot);
+  const std::optional<Bundle>& bundle = CurrentBundle();
+  if (!loaded || !bundle || loaded->state->current != slot ||
+      loaded->state->loaded[slot] != version || bundle->version != version) {
+    return;
+  }
+  const dnr::DNRManifestData::ManifestIDToRulesetMap& rulesets =
+      dnr::DNRManifestData::GetManifestIDToRulesetMap(*loaded->extension);
+  std::set<dnr::RulesetID> on;
+  if (dnr::CompositeMatcher* matcher =
+          loaded->service->ruleset_manager()->GetMatcherForExtension(
+              loaded->extension->id())) {
+    on = matcher->ComputeStaticRulesetIDs();
+  }
+  bool any = false;
+  for (const std::string& id : WantedLists(*loaded->state, *bundle)) {
+    auto found = rulesets.find(id);
+    if (found == rulesets.end()) {
+      continue;  // Not in this bundle: ApplyRulesetDifference skips it too.
+    }
+    if (!on.contains(found->second->id)) {
+      return;  // Not all on: the hold lasts until the blocker is ready.
+    }
+    any = true;
+  }
+  if (any) {
+    EndHold(*loaded->state);
+  }
+}
+
+// The blocker in `slot`, loaded for bundle `version`, has its site exceptions
+// and its own rules: both dynamic rule updates have ended. Only now are its
+// lists switched on. A ruleset update and a dynamic rule update wait in
+// different queues of RulesMonitorService, so started together the lists
+// could come on first, and a site the person excepted because blocking
+// breaks it would have requests blocked until its exception arrived.
+// FinishTakeover follows when the lists are on.
+void SwitchListsOn(uint64_t profile_id, int slot, std::string version) {
+  auto found = States().find(profile_id);
+  if (found == States().end()) {
+    return;
+  }
+  ProfileState& state = found->second;
+  if (state.current != slot || state.loaded[slot] != version) {
+    return;  // Unloaded or replaced since; the newer load switches on its own.
+  }
+  state.current_rules_set = true;
+  ApplyRulesets(profile_id, slot,
+                base::BindOnce(&FinishTakeover, profile_id, slot,
+                               std::move(version)));
+}
+
+// Brings the profile's blocker in line with its state and the bundle in use:
+// loads it, replaces it when the bundle changed, or removes it.
+void ApplyState(uint64_t profile_id) {
+  Profile* profile = FindBridgeProfile(profile_id);
+  auto found = States().find(profile_id);
+  if (!profile || found == States().end()) {
+    return;
+  }
+  ProfileState& state = found->second;
+  extensions::ComponentLoader* loader =
+      extensions::ComponentLoader::Get(profile);
+  if (!loader) {
+    return;
+  }
+  const std::optional<Bundle>& bundle = CurrentBundle();
+  const bool wanted = state.level > 0 && bundle.has_value();
+  if (!wanted) {
+    if (state.level == 0) {
+      // Off: no blocker in the profile, and none to load at the next launch.
+      for (int slot = 0; slot < kSlots; ++slot) {
+        Unload(profile, state, slot);
+      }
+      ReleaseHeld(state);
+    }
+    // Else there is no bundle yet (the host has spoken for the profile and
+    // the bundle is still being copied): the level wants a blocker, nothing
+    // is loaded, as a blocker is loaded only for a bundle, and what the hold
+    // holds waits for the bundle. The markers of the last session stay for
+    // RememberedSlot. Unloading here removed them, and a launch whose
+    // profile came before its bundle then loaded fresh: after a list update
+    // that was every next launch, the copy of the bundle before being
+    // deleted first.
+    return;
+  }
+  if (state.current >= 0 && state.loaded[state.current] == bundle->version) {
+    // The level or the lists changed. A blocker of the bundle before, still
+    // loaded because a list update is under way, knows only that bundle's
+    // lists: it goes now, so that the change applies whole.
+    const int slot = state.current;
+    const int other = kSlots - 1 - slot;
+    if (!state.loaded[other].empty()) {
+      Unload(profile, state, other);
+    }
+    if (!state.current_rules_set) {
+      // Its site exceptions and own rules are still being set. SwitchListsOn
+      // follows them and reads the level and the lists as they are then.
+      return;
+    }
+    ApplyRulesets(profile_id, slot,
+                  state.ready[slot]
+                      ? base::DoNothing()
+                      : base::BindOnce(&FinishTakeover, profile_id, slot,
+                                       bundle->version));
+    return;
+  }
+  // Another bundle (security CB-02). When the blocker of the bundle before
+  // is ready, it stays and goes on blocking, and the new bundle is loaded as
+  // the other blocker; FinishTakeover removes the old one once the new one's
+  // lists are on. A blocker that is not ready yet blocks nothing (the first
+  // load of a launch, or a takeover that a still newer bundle overtakes): the
+  // new bundle takes its place, and what was blocking before it stays. With
+  // no current blocker (none yet, or the last load failed) a free slot is
+  // taken, so that one that is still blocking is left alone.
+  //
+  // At launch nothing is loaded. The blocker that was ready in the last
+  // session for this bundle is loaded again, alone, so that Chromium brings
+  // its lists and dynamic rules up with it; with none (a new bundle, a
+  // profile that had no blocker, a marker of another version) slot 0 loads
+  // fresh, and the hold below covers the time its lists take.
+  int slot = state.loaded[0].empty() ? 0 : kSlots - 1;
+  int remembered = -1;
+  if (state.current >= 0) {
+    slot = state.ready[state.current] ? kSlots - 1 - state.current
+                                      : state.current;
+  } else if (state.loaded[0].empty() && state.loaded[1].empty()) {
+    remembered = RememberedSlot(profile, bundle->version);
+    if (remembered >= 0) {
+      slot = remembered;
+    }
+  }
+  if (!state.loaded[slot].empty()) {
+    Unload(profile, state, slot);
+  }
+  if (!HasReadyBlocker(state) &&
+      (state.hold.spent || !state.hold.timer.IsRunning())) {
+    // A fresh load: navigations are held again, with a limit of their own.
+    // One that is under way keeps its limit (a newer bundle overtaking the
+    // first load of a launch, say). A list update, with the old blocker
+    // ready, holds nothing.
+    state.hold.spent = false;
+    state.hold.deadline = base::TimeTicks();
+  }
+  if (loader->Add(BlockerManifest(*bundle, slot), bundle->directory) !=
+          BlockerId(slot) ||
+      !extensions::ExtensionRegistry::Get(profile)
+           ->enabled_extensions()
+           .Contains(BlockerId(slot))) {
+    // What was blocking stays; the next change tries again.
+    LOG(ERROR) << "ReArc Blocker: bundle " << bundle->version
+               << " did not load";
+    return;
+  }
+  state.loaded[slot] = bundle->version;
+  state.current = slot;
+  state.current_rules_set = false;
+  state.ready[slot] = false;
+  // ActionTracker hands the per-tab count of blocked requests to
+  // ExtensionsAPIClient::UpdateActionCount for an extension with this
+  // preference; OnContentBlockerActionCount takes it from there.
+  dnr::PrefsHelper(*extensions::ExtensionPrefs::Get(profile))
+      .SetUseActionCountAsBadgeText(BlockerId(slot), true);
+  // The site exceptions and the own rules first. The lists are switched on
+  // when both updates have ended (SwitchListsOn), and the blocker is ready,
+  // and takes over from the one before it, when the lists are on
+  // (FinishTakeover).
+  if (remembered >= 0) {
+    // Ends when the extension's load has, ahead of SwitchListsOn's update.
+    if (std::optional<Loaded> loaded = FindLoaded(profile_id, slot)) {
+      loaded->service->UpdateEnabledStaticRulesets(
+          *loaded->extension, {}, {},
+          base::BindOnce(&OnRememberedListsLoaded, profile_id, slot,
+                         bundle->version));
+    }
+  }
+  base::RepeatingClosure rules_set = base::BarrierClosure(
+      2, base::BindOnce(&SwitchListsOn, profile_id, slot, bundle->version));
+  ApplyExceptions(profile_id, slot, rules_set);
+  ApplyOwnRules(profile_id, slot, rules_set);
+}
+
+// Applies once the profile's extension system is ready: the host may speak
+// for a profile while its extensions are still loading.
+void ScheduleApply(uint64_t profile_id) {
+  Profile* profile = FindBridgeProfile(profile_id);
+  if (!profile) {
+    return;
+  }
+  extensions::ExtensionSystem::Get(profile)->ready().Post(
+      FROM_HERE, base::BindOnce(&ApplyState, profile_id));
+}
+
+void OnBundlePrepared(uint64_t request, std::optional<Bundle> bundle) {
+  if (request != g_bundle_request) {
+    return;  // The host has named another directory since.
+  }
+  if (!bundle) {
+    LOG(ERROR) << "ReArc Blocker: the blocklist directory could not be read "
+                  "or copied; the bundle in use stays";
+    return;
+  }
+  CurrentBundle() = std::move(*bundle);
+  for (const auto& [profile_id, state] : States()) {
+    ScheduleApply(profile_id);
+  }
+}
+
+// The profile a content blocking call is for: a registered profile that is
+// not off the record (private windows follow their profile).
+ReArcStatus CheckProfile(uint64_t profile_id) {
+  Profile* profile = FindBridgeProfile(profile_id);
+  if (!profile) {
+    return REARC_PROFILE_NOT_FOUND;
+  }
+  return profile->IsOffTheRecord() ? REARC_INVALID_ARGUMENT : REARC_OK;
+}
+
+// A JSON array argument, or nullopt when it is not one or is too long.
+std::optional<base::ListValue> ReadList(const char* json) {
+  if (!json) {
+    return std::nullopt;
+  }
+  const std::string_view text(json);
+  if (text.size() > kMaxArgumentBytes) {
+    return std::nullopt;
+  }
+  return base::JSONReader::ReadList(text, base::JSON_PARSE_RFC);
+}
+
+}  // namespace
+
+bool OnContentBlockerActionCount(content::BrowserContext* context,
+                                 const std::string& extension_id,
+                                 int tab_id,
+                                 int action_count) {
+  const int slot = BlockerSlot(extension_id);
+  if (slot < 0) {
+    return false;
+  }
+  CHECK(pthread_main_np());
+  content::WebContents* contents = FindBrowserlessExtensionTab(
+      tab_id, Profile::FromBrowserContext(context)->GetOriginalProfile(),
+      /*include_incognito=*/true);
+  if (!contents) {
+    return true;  // Not a host tab (or closing): nobody shows its count.
+  }
+  for (uint64_t id : TabRegistry::Get().SessionIds()) {
+    TabSession* session = TabRegistry::Get().FindSession(id);
+    if (session && session->web_contents() == contents) {
+      SetCount(id, slot, static_cast<uint32_t>(std::max(action_count, 0)));
+      break;
+    }
+  }
+  return true;
+}
+
+void ABIDetachContentBlocker(uint64_t profile_id) {
+  CHECK(pthread_main_np());
+  auto found = States().find(profile_id);
+  if (found == States().end()) {
+    return;
+  }
+  // What the profile's load holds goes on first; the profile is going.
+  std::vector<base::WeakPtr<FreshLoadThrottle>> waiting;
+  waiting.swap(found->second.hold.waiting);
+  States().erase(found);
+  for (const base::WeakPtr<FreshLoadThrottle>& throttle : waiting) {
+    if (throttle) {
+      throttle->Release();
+    }
+  }
+}
+
+void AddContentBlockerNavigationThrottle(
+    content::NavigationThrottleRegistry& registry) {
+  content::NavigationHandle& handle = registry.GetNavigationHandle();
+  content::WebContents* contents = handle.GetWebContents();
+  if (!contents || !handle.GetURL().SchemeIsHTTPOrHTTPS()) {
+    return;
+  }
+  // A private window's navigations follow its profile.
+  const uint64_t profile_id = BridgeProfileId(
+      Profile::FromBrowserContext(contents->GetBrowserContext())
+          ->GetOriginalProfile());
+  auto found = States().find(profile_id);
+  if (!profile_id || found == States().end() ||
+      !HoldsNavigations(found->second)) {
+    return;
+  }
+  registry.AddThrottle(
+      std::make_unique<FreshLoadThrottle>(registry, profile_id));
+}
+
+}  // namespace rearc
+
+ReArcStatus ReArcEngineSetBlocklistDirectory(const char* utf8_path) {
+  CHECK(pthread_main_np());
+  if (!utf8_path) {
+    return REARC_INVALID_ARGUMENT;
+  }
+  const base::FilePath source = base::FilePath::FromUTF8Unsafe(utf8_path);
+  if (!source.IsAbsolute() || source.ReferencesParent()) {
+    return REARC_INVALID_ARGUMENT;
+  }
+  if (!g_browser_process || !g_browser_process->profile_manager()) {
+    return REARC_ENGINE_NOT_READY;
+  }
+  const base::FilePath root =
+      g_browser_process->profile_manager()->user_data_dir().AppendASCII(
+          "ReArc Blocker");
+  const std::optional<rearc::Bundle>& current = rearc::CurrentBundle();
+  rearc::BundleRunner()->PostTaskAndReplyWithResult(
+      FROM_HERE,
+      base::BindOnce(&rearc::PrepareBundle, source, root,
+                     current ? current->directory : base::FilePath()),
+      base::BindOnce(&rearc::OnBundlePrepared, ++rearc::g_bundle_request));
+  return REARC_OK;
+}
+
+ReArcStatus ReArcProfileSetContentBlocking(uint64_t profile_id,
+                                           int32_t level,
+                                           const char* enabled_list_ids_json) {
+  CHECK(pthread_main_np());
+  if (auto status = rearc::CheckProfile(profile_id)) {
+    return status;
+  }
+  if (level < 0 || level > 3) {
+    return REARC_INVALID_ARGUMENT;
+  }
+  std::vector<std::string> ids;
+  if (enabled_list_ids_json) {
+    std::optional<base::ListValue> list =
+        rearc::ReadList(enabled_list_ids_json);
+    if (!list || list->size() > rearc::kMaxLists) {
+      return REARC_INVALID_ARGUMENT;
+    }
+    for (const base::Value& value : *list) {
+      if (!value.is_string() || !rearc::IsListId(value.GetString())) {
+        return REARC_INVALID_ARGUMENT;
+      }
+      ids.push_back(value.GetString());
+    }
+  }
+  rearc::ProfileState& state = rearc::States()[profile_id];
+  state.level = level;
+  state.names_lists = enabled_list_ids_json != nullptr;
+  state.list_ids = std::move(ids);
+  rearc::ScheduleApply(profile_id);
+  if (level == 0) {
+    // Off: nothing waits for a blocker any more. Last: `state` may be gone.
+    rearc::ReleaseHeld(state);
+  }
+  return REARC_OK;
+}
+
+ReArcStatus ReArcProfileSetBlockingExceptions(uint64_t profile_id,
+                                              const char* hosts_json) {
+  CHECK(pthread_main_np());
+  if (auto status = rearc::CheckProfile(profile_id)) {
+    return status;
+  }
+  std::optional<base::ListValue> list = rearc::ReadList(hosts_json);
+  if (!list || list->size() > rearc::kMaxExceptionHosts) {
+    return REARC_INVALID_ARGUMENT;
+  }
+  std::set<std::string> hosts;
+  for (const base::Value& value : *list) {
+    if (!value.is_string() || !rearc::IsHost(value.GetString())) {
+      return REARC_INVALID_ARGUMENT;
+    }
+    hosts.insert(value.GetString());
+  }
+  rearc::ProfileState& state = rearc::States()[profile_id];
+  state.has_exceptions = true;
+  state.exception_hosts.assign(hosts.begin(), hosts.end());
+  // With no blocker loaded this waits in the state for the next load. During
+  // a list update both blockers get it: the old one is still the one blocking.
+  for (int slot = 0; slot < rearc::kSlots; ++slot) {
+    rearc::ApplyExceptions(profile_id, slot, base::DoNothing());
+  }
+  return REARC_OK;
+}
+
+ReArcStatus ReArcProfileSetOwnBlockingRules(uint64_t profile_id,
+                                            const char* dnr_rules_json) {
+  CHECK(pthread_main_np());
+  if (auto status = rearc::CheckProfile(profile_id)) {
+    return status;
+  }
+  std::optional<base::ListValue> list = rearc::ReadList(dnr_rules_json);
+  if (!list || list->size() > rearc::kMaxOwnRules) {
+    return REARC_INVALID_ARGUMENT;
+  }
+  int next_id = rearc::kFirstOwnRuleId;
+  for (base::Value& value : *list) {
+    base::DictValue* rule = value.GetIfDict();
+    const std::string* action =
+        rule ? rule->FindStringByDottedPath("action.type") : nullptr;
+    // Own rules reach the engine through the host's settings and their sync:
+    // they may block and allow, never redirect or rewrite headers.
+    if (!action || !rearc::IsBlockOrAllow(*action)) {
+      return REARC_INVALID_ARGUMENT;
+    }
+    const int priority = std::clamp(rule->FindInt("priority").value_or(1), 1,
+                                    rearc::kMaxOwnRulePriority);
+    rule->Set("id", next_id++);
+    rule->Set("priority", priority + rearc::kOwnRulePriorityOffset);
+    if (!rearc::dnr_api::Rule::FromValue(*rule).has_value()) {
+      return REARC_INVALID_ARGUMENT;
+    }
+  }
+  rearc::ProfileState& state = rearc::States()[profile_id];
+  state.has_own_rules = true;
+  state.own_rules = std::move(*list);
+  for (int slot = 0; slot < rearc::kSlots; ++slot) {
+    rearc::ApplyOwnRules(profile_id, slot, base::DoNothing());
+  }
+  return REARC_OK;
+}
+
+uint32_t ReArcTabGetBlockedCount(uint64_t tab_id) {
+  CHECK(pthread_main_np());
+  auto count = rearc::Counts().find(tab_id);
+  return count != rearc::Counts().end() &&
+                 rearc::TabRegistry::Get().FindSession(tab_id)
+             ? rearc::Total(count->second)
+             : 0;
+}
+
+void ReArcEngineSetBlockedCountCallback(ReArcBlockedCountCallback callback,
+                                        void* context) {
+  CHECK(pthread_main_np());
+  rearc::g_count_callback = callback;
+  rearc::g_count_context = callback ? context : nullptr;
+}
